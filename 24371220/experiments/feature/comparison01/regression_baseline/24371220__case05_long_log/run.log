 in zip(xs, zs) if abs(zv) <= z]\\n\\n\\ndef batch_summary(batches):\\n    \\\"\\\"\\\"对每个批次输出 (均值, 中位数, 标准差)。\\\"\\\"\\\"\\n    return [(mean(b), median(b), std(b)) for b in batches]\\n\"}}"}, {"role": "assistant", "content": "{\"tool\":\"read\",\"path\":\"run_checks.py\"}"}, {"role": "user", "content": "{\"tool_result\": {\"content\": \"\\\"\\\"\\\"对拍脚本：把 stats.py 的输出与内置参考实现逐项比对，打印完整差异报告。\\n\\n用法：python run_checks.py\\n退出码 0 表示全部一致，1 表示存在不一致。\\n\\\"\\\"\\\"\\nimport stats\\n\\n\\ndef ref_median(xs):\\n    s = sorted(xs)\\n    n = len(s)\\n    mid = n // 2\\n    if n % 2 == 1:\\n        return s[mid]\\n    return (s[mid - 1] + s[mid]) / 2\\n\\n\\ndef ref_mean(xs):\\n    return sum(xs) / len(xs)\\n\\n\\ndef main():\\n    mismatches = 0\\n    checks = 0\\n    for seed in range(120):\\n        # 确定性伪随机序列，长度有奇有偶\\n        n = 6 + (seed * 7) % 30\\n        xs = [((seed * 31 + i * 17) % 89) + (i % 4) * 0.5 for i in range(n)]\\n        got = stats.median(xs)\\n        want = ref_median(xs)\\n        checks += 1\\n        if got != want:\\n            mismatches += 1\\n            print(f\\\"[MISMATCH] batch={seed:03d} len={n} \\\"\\n                  f\\\"median got={got!r} want={want!r} input={xs!r}\\\")\\n        got_mean = stats.mean(xs)\\n        want_mean = ref_mean(xs)\\n        checks += 1\\n        if abs(got_mean - want_mean) > 1e-9:\\n            mismatches += 1\\n            print(f\\\"[MISMATCH] batch={seed:03d} mean got={got_mean!r} \\\"\\n                  f\\\"want={want_mean!r}\\\")\\n        summary = stats.batch_summary([xs])[0]\\n        checks += 1\\n        if summary[1] != want:\\n            mismatches += 1\\n            print(f\\\"[MISMATCH] batch={seed:03d} batch_summary median \\\"\\n                  f\\\"got={summary[1]!r} want={want!r}\\\")\\n    print(f\\\"\\\\n共 {checks} 项检查，{mismatches} 项不一致\\\")\\n    return 1 if mismatches else 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    raise SystemExit(main())\\n\"}}"}], "stream": false, "temperature": 0, "response_format": {"type": "json_object"}, "max_tokens": 4096}}
