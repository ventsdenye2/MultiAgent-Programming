an(xs):\\n    return sum(xs) / len(xs)\\n\\n\\ndef main():\\n    mismatches = 0\\n    checks = 0\\n    for seed in range(120):\\n        # 确定性伪随机序列，长度有奇有偶\\n        n = 6 + (seed * 7) % 30\\n        xs = [((seed * 31 + i * 17) % 89) + (i % 4) * 0.5 for i in range(n)]\\n        got = stats.median(xs)\\n        want = ref_median(xs)\\n        checks += 1\\n        if got != want:\\n            mismatches += 1\\n            print(f\\\"[MISMATCH] batch={seed:03d} len={n} \\\"\\n                  f\\\"median got={got!r} want={want!r} input={xs!r}\\\")\\n        got_mean = stats.mean(xs)\\n        want_mean = ref_mean(xs)\\n        checks += 1\\n        if abs(got_mean - want_mean) > 1e-9:\\n            mismatches += 1\\n            print(f\\\"[MISMATCH] batch={seed:03d} mean got={got_mean!r} \\\"\\n                  f\\\"want={want_mean!r}\\\")\\n        summary = stats.batch_summary([xs])[0]\\n        checks += 1\\n        if summary[1] != want:\\n            mismatches += 1\\n            print(f\\\"[MISMATCH] batch={seed:03d} batch_summary median \\\"\\n                  f\\\"got={summary[1]!r} want={want!r}\\\")\\n    print(f\\\"\\\\n共 {checks} 项检查，{mismatches} 项不一致\\\")\\n    return 1 if mismatches else 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    raise SystemExit(main())\\n\"}}"}, {"role": "assistant", "content": "                      [{\"title\": \"运行基线 pytest 与 run_checks.py 并保留失败输出\", \"status\": \"done\"}, {\"title\": \"阅读 stats.py 与测试文件，定位唯一根因\", \"status\": \"done\"}, {\"title\": \"在 stats.py 做最小必要修复\", \"status\": \"doing\"}, {\"title\": \"重跑完整 pytest 与 run_checks.py 确认全绿\", \"status\": \"todo\"}]</｜｜DSML｜｜ parameter>\n</｜｜DSML｜｜ invoke>\n</｜｜DSML｜｜ calls>"}, {"role": "user", "content": "{\"tool_result\": {\"error\": \"Extra data: line 1 column 243 (char 242)\"}}"}, {"role": "assistant", "content": "                [mid]`（较大的中间值），未对中间两数取平均。这也导致 `robust_center`、`batch_summary` 的中位数全部偏移。\n\n{\"tool\":\"plan\",\"items\":[{\"title\":\"运行基线 pytest 与 run_check