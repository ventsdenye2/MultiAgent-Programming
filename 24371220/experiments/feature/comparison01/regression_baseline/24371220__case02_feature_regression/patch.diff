@@ -22,3 +22,18 @@
 def count_words(s):
     """按空白统计单词数。"""
     return len(s.split())
+
+
+def truncate_middle(s, max_len):
+    """截断字符串中间，保留首尾并用 ``...`` 连接。
+
+    当 ``max_len < 5`` 时抛出 ``ValueError``。字符串长度不超过
+    ``max_len`` 时原样返回，否则返回长度恰好为 ``max_len`` 的字符串。
+    """
+    if max_len < 5:
+        raise ValueError("max_len must be at least 5")
+    if len(s) <= max_len:
+        return s
+    head_len = (max_len - 3 + 1) // 2
+    tail_len = max_len - 3 - head_len
+    return s[:head_len] + "..." + s[len(s) - tail_len:]
