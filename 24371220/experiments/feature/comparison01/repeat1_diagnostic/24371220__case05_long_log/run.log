]\nine.py:23: AssertionError\n______________________________ test_median_long_3 ______________________________\n    def test_median_long_3():\n>       assert median(LONG_3) == expected_median(LONG_3)\nE       assert 90 == 89.5\nE        +  where 90 = median([50, 57, 64, 89, 96, 103, ...])\nE        +  and   89.5 = expected_median([50, 57, 64, 89, 96, 103, ...])\ntest_stats_pipeline.py:27: AssertionError\n__________________________ test_batch_summary_medians __________________________\n        medians = [r[1] for r in result]\n>       assert medians == [expected_median(b) for b in batches]\nE       assert [95, 108, 90] == [93.0, 107.5, 89.5]\ntest_stats_pipeline.py:34: AssertionError\n________________________ test_batch_summary_full_output ________________________\n        result = batch_summary(batches)\n        assert len(result) == 2\n        for (m, med, sd), b in zip(result, batches):\n            assert abs(m - sum(b) / len(b)) < 1e-9\n>           assert med == expected_median(b)\nE           assert 43 == 41.0\nE            +  where 41.0 = expected_median([3, 7, 11, 15, 19, 23, ...])\ntest_stats_pipeline.py:43: AssertionError\n=========================== short test summary info ============================\nFAILED test_stats_core.py::test_median_even_length - assert 14 == 13.5\nFAILED test_stats_core.py::test_median_even_length_b - assert 94 == 93.0\nFAILED test_stats_core.py::test_median_two_elements - assert 20 == 15.0\nFAILED test_stats_core.py::test_robust_center_uses_median - assert 14 == 13.5\nFAILED test_stats_edges.py::test_median_general[xs1-5] - assert 8 == 5 ± 5.0e-06\nFAILED test_stats_edges.py::test_median_general[xs2--5] - assert -2 == -5 ± 5...\nFAILED test_stats_edges.py::test_median_general[xs3-2.5] - assert 4 == 2.5 ± ...\nFAILED test_stats_edges.py::test_median_general[xs4-0.4] - assert 0.7 == 0.4 ...\nFAILED test_stats_pipeline.py::test_median_long_1 - assert 95 == 93.0\nFAILED test_stats_pipeline.py::test_median_long_2 - assert 108 == 107.5\nFAILED test_stats_pipeline.py::test_median_long_3 - assert 90 == 89.5\nFAILED test_stats_pipeline.py::test_batch_summary_medians - assert [95, 108, ...\nFAILED test_stats_pipeline.py::test_batch_summary_full_output - assert 43 == ...\n13 failed, 15 passed in 4.69s\n\n{\"id\": 12, \"tool\": \"read\", \"path\": \"run_checks.py\", \"action\": {\"tool\": \"read\", \"path\": \"run_checks.py\"}, \"result\": {\"content\": \"\\\"\\\"\\\"对拍脚本：把 stats.py 的输出与内置参考实现逐项比对，打印完整差异报告。\\n\\n用法：python run_checks.py\\n退出码 0 表示全部一致，1 表示存在不一致。\\n\\\"\\\"\\\"\\nimport stats\\n\\n\\ndef ref_median(xs):\\n    s = sorted(xs)\\n    n = len(s)\\n    mid = n // 2\\n    if n % 2 == 1:\\n        return s[mid]\\n    return (s[mid - 1] + s[mid]) / 2\\n\\n\\ndef ref_mean(xs):\\n    return sum(xs) / len(xs)\\n\\n\\ndef main():\\n    mismatches = 0\\n    checks = 0\\n    for seed in range(120):\\n        # 确定性伪随机序列，长度有奇有偶\\n        n = 6 + (seed * 7) % 30\\n        xs = [((seed * 31 + i * 17) % 89) + (i % 4) * 0.5 for i in range(n)]\\n        got = stats.median(xs)\\n        want = ref_median(xs)\\n        checks += 1\\n        if got != want:\\n            mismatches += 1\\n            print(f\\\"[MISMATCH] batch={seed:03d} len={n} \\\"\\n                  f\\\"median got={got!r} want={want!r} input={xs!r}\\\")\\n        got_mean = stats.mean(xs)\\n        want_mean = ref_mean(xs)\\n        checks += 1\\n        if abs(got_mean - want_mean) > 1e-9:\\n            mismatches += 1\\n            print(f\\\"[MISMATCH] batch={seed:03d} mean got={got_mean!r} \\\"\\n                  f\\\"want={want_mean!r}\\\")\\n        summary = stats.batch_summary([xs])[0]\\n        checks += 1\\n        if summary[1] != want:\\n            mismatches += 1\\n            print(f\\\"[MISMATCH] batch={seed:03d} batch_summary median \\\"\\n                  f\\\"got={summary[1]!r} want={want!r}\\\")\\n    print(f\\\"\\\\n共 {checks} 项检查，{mismatches} 项不一致\\\")\\n    return 1 if mismatches else 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    raise SystemExit(main())\\n\"}}\n\n{\"id\": 11, \"tool\": \"read\", \"path\": \"stats.py\", \"action\": {\"tool\": \"read\", \"path\": \"stats.py\"}, \"result\": {\"content\": \"\\\"\\\"\\\"数据统计管线：基础统计量与批处理标准化。\\\"\\\"\\\"\\n\\n\\ndef mean(xs):\\n    if not xs:\\n        raise ValueError(\\\"empty sequence\\\")\\n    return sum(xs) / len(xs)\\n\\n\\ndef median(xs):\\n    if not xs:\\n        raise ValueError(\\\"empty sequence\\\")\\n    s = sorted(xs)\\n    n = len(s)\\n    mid = n // 2\\n    if n % 2 == 1:\\n        return s[mid]\\n    return s[mid]\\n\\n\\ndef variance(xs):\\n    m = mean(xs)\\n    return sum((x - m) ** 2 for x in xs) / len(xs)\\n\\n\\ndef std(xs):\\n    return variance(xs) ** 0.5\\n\\n\\ndef zscores(xs):\\n    m = mean(xs)\\n    sd = std(xs)\\n    if sd == 0:\\n        return [0.0 for _ in xs]\\n    return [(x - m) / sd for x in xs]\\n\\n\\ndef moving_average(xs, k):\\n    if k <= 0:\\n        raise ValueError(\\\"window must be positive\\\")\\n    return [mean(xs[i:i + k]) for i in range(len(xs) - k + 1)]\\n\\n\\ndef robust_center(xs):\\n    \\\"\\\"\\\"抗离群点的中心估计：中位数。\\\"\\\"\\\"\\n    return median(xs)\\n\\n\\ndef trim_outliers(xs, z=2.0):\\n    \\\"\\\"\\\"去掉 |z 分数| 超过阈值的点，返回保留的元素。\\\"\\\"\\\"\\n    zs = zscores(xs)\\n    return [x for x, zv in zip(xs, zs) if abs(zv) <= z]\\n\\n\\ndef batch_summary(batches):\\n    \\\"\\\"\\\"对每个批次输出 (均值, 中位数, 标准差)。\\\"\\\"\\\"\\n    return [(mean(b), median(b), std(b)) for b in batches]\\n\"}}\n\n{\"id\": 18, \"tool\": \"invalid\", \"path\": \"\", \"action\": null, \"result\": {\"error\": \"Extra data: line 3 column 1 (char 57)\"}}\n\n{\"id\": 13, \"tool\": \"plan\", \"path\": \"\", \"action\": {\"tool\": \"plan\", \"items\": [{\"title\": \"探索仓库并读取关键业务文件\", \"status\": \"done\"}, {\"title\": \"运行基线 pytest 与 run_checks.py 保存失败输出\", \"status\": \"doing\"}, {\"title\": \"定位唯一根因并最小修复 stats.py\", \"status\": \"todo\"}, {\"title\": \"回归验证 pytest 与 run_checks.py 全绿\", \"status\": \"todo\"}]}, \"r