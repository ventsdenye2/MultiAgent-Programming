ison failed\nE         Obtained: 8\nE         Expected: 5 ± 5.0e-06\ntest_stats_edges.py:8: AssertionError\n_________________________ test_median_general[xs2--5] __________________________\nxs = [-8, -2], expected = -5\nE       assert -2 == -5 ± 5.0e-06\nE         Obtained: -2\nE         Expected: -5 ± 5.0e-06\n_________________________ test_median_general[xs3-2.5] _________________________\nxs = [1, 1, 4, 4], expected = 2.5\nE       assert 4 == 2.5 ± 2.5e-06\nE         Obtained: 4\nE         Expected: 2.5 ± 2.5e-06\n_________________________ test_median_general[xs4-0.4] _________________________\nxs = [0.1, 0.7], expected = 0.4\nE       ass\n[诊断摘录/中段省略，完整原文见日志]\nine.py:23: AssertionError\n______________________________ test_median_long_3 ______________________________\n    def test_median_long_3():\n>       assert median(LONG_3) == expected_median(LONG_3)\nE       assert 90 == 89.5\nE        +  where 90 = median([50, 57, 64, 89, 96, 103, ...])\nE        +  and   89.5 = expected_median([50, 57, 64, 89, 96, 103, ...])\ntest_stats_pipeline.py:27: AssertionError\n__________________________ test_batch_summary_medians __________________________\n        medians = [r[1] for r in result]\n>       assert medians == [expected_median(b) for b in batches]\nE       assert [95, 108, 90] == [93.0, 107.5, 89.5]\ntest_stats_pipeline.py:34: AssertionError\n________________________ test_batch_summary_full_output ________________________\n        result = batch_summary(batches)\n        assert len(result) == 2\n        for (m, med, sd), b in zip(result, batches):\n            assert abs(m - sum(b) / len(b)) < 1e-9\n>           assert med == expected_median(b)\nE           assert 43 == 41.0\nE            +  where 41.0 = expected_median([3, 7, 11, 15, 19, 23, ...])\ntest_stats_pipeline.py:43: AssertionError\n=========================== short test summary info ============================\nFAILED test_stats_core.py::test_median_even_length - assert 14 == 13.5\nFAILED test_stats_core.py::