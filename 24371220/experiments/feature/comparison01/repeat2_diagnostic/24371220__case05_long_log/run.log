alues:\\n        raise ValueError(\\\"variance() arg is an empty sequence\\\")\\n    n = len(values)\\n    if n - ddof <= 0:\\n        raise ValueError(\\\"variance() requires at least one degree of freedom\\\")\\n    m = mean(values)\\n    total = 0.0\\n    for value in values:\\n        diff = value - m\\n        total += diff * diff\\n    return total / (n - ddof)\\n\\n\\ndef zscore(value: float, values: Sequence[float], ddof: int = 0) -> float:\\n    \\\"\\\"\\\"返回 value 在 values 中的标准分数。若标准差为 0，抛出 ValueError。\\\"\\\"\\\"\\n    m = mean(values)\\n    var = variance(values, ddof)\\n    if var <= 0:\\n        raise ValueError(\\\"zscore() undefined for zero variance\\\")\\n    sd = var ** 0.5\\n    return (value - m) / sd\\n\\n\\ndef moving_average(values: Sequence[float], window: int) -> List[float]:\\n    \\\"\\\"\\\"返回滑动平均序列。不修改传入序列。\\\"\\\"\\\"\\n    if window <= 0:\\n        raise ValueError(\\\"window must be positive\\\")\\n    if window > len(values):\\n        raise ValueError(\\\"window larger than sequence\\\")\\n    result: List[float] = []\\n    for i in range(window - 1, len(values)):\\n        s = 0.0\\n        for j in range(i - window + 1, i + 1):\\n            s += values[j]\\n        result.append(s / window)\\n    return result\\n\\n\\ndef remove_outliers(values: Sequence[float], threshold: float = 2.0) -> List[float]:\\n    \\\"\\\"\\\"返回剔除离群点后的新列表（基于 zscore）。不修改传入序列。\\\"\\\"\\\"\\n    m = mean(values)\\n    var = variance(values)\\n    if var <= 0:\\n        return list(values)\\n    sd = var ** 0.5\\n    kept: List[float] = []\\n    for value in values:\\n        if abs((value - m) / sd) <= threshold:\\n            kept.append(value)\\n    return kept\\n\\n\\ndef batch_summary(batches: Iterable[Sequence[float]]) -> Dict[str, object]:\\n    \\\"\\\"\\\"对多批数据计算汇总统计。返回 count、mean、median、variance 字典。\\\"\\\"\\\"\\n    values: List[float] = []\\n    for batch in batches:\\n        values.extend(batch)\\n    return {\\n        \\\"count\\\": len(va