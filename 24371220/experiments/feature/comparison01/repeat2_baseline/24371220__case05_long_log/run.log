r(\\\"empty sequence\\\")\\n    return sum(xs) / len(xs)\\n\\n\\ndef median(xs):\\n    if not xs:\\n        raise ValueError(\\\"empty sequence\\\")\\n    s = sorted(xs)\\n    n = len(s)\\n    mid = n // 2\\n    if n % 2 == 1:\\n        return s[mid]\\n    return (s[mid - 1] + s[mid]) / 2\\n\\n\\ndef variance(xs):\\n    m = mean(xs)\\n    return sum((x - m) ** 2 for x in xs) / len(xs)\\n\\n\\ndef std(xs):\\n    return variance(xs) ** 0.5\\n\\n\\ndef zscores(xs):\\n    m = mean(xs)\\n    sd = std(xs)\\n    if sd == 0:\\n        return [0.0 for _ in xs]\\n    return [(x - m) / sd for x in xs]\\n\\n\\ndef moving_average(xs, k):\\n    if k <= 0:\\n        raise ValueError(\\\"window must be positive\\\")\\n    return [mean(xs[i:i + k]) for i in range(len(xs) - k + 1)]\\n\\n\\ndef robust_center(xs):\\n    \\\"\\\"\\\"抗离群点的中心估计：中位数。\\\"\\\"\\\"\\n    return median(xs)\\n\\n\\ndef trim_outliers(xs, z=2.0):\\n    \\\"\\\"\\\"去掉 |z 分数| 超过阈值的点，返回保留的元素。\\\"\\\"\\\"\\n    zs = zscores(xs)\\n    return [x for x, zv in zip(xs, zs) if abs(zv) <= z]\\n\\n\\ndef batch_summary(batches):\\n    \\\"\\\"\\\"对每个批次输出 (均值, 中位数, 标准差)。\\\"\\\"\\\"\\n    return [(mean(b), median(b), std(b)) for b in batches]\\n\"}"}, {"role": "user", "content": "{\"tool_result\": {\"written\": \"stats.py\"}}"}, {"role": "assistant", "content": "              [mid]` instead of the average of the two middle values.\n\n{\"tool\":\"command\",\"argv\":[\"python\",\"-m\",\"pytest\",\"-q\"]}"}, {"role": "user", "content": "{\"tool_result\": {\"error\": \"Expecting value: line 1 column 2 (char 1)\"}}"}, {"role": "assistant", "content": "{\"tool\":\"command\",\"argv\":[\"python\",\"-m\",\"pytest\",\"-q\"]}"}, {"role": "user", "content": "{\"tool_result\": {\"rc\": 0, \"stdout\": \"............................                                             [100%]\\n28 passed in 0.03s\\n\", \"stderr\": \"\"}}"}], "stream": false, "temperature": 0, "response_format": {"type": "json_object"}, "max_tokens": 4096}}
