xs]\\n    return [(x - m) / sd for x in xs]\\n\\n\\ndef moving_average(xs, k):\\n    if k <= 0:\\n        raise ValueError(\\\"window must be positive\\\")\\n    return [mean(xs[i:i + k]) for i in range(len(xs) - k + 1)]\\n\\n\\ndef robust_center(xs):\\n    \\\"\\\"\\\"抗离群点的中心估计：中位数。\\\"\\\"\\\"\\n    return median(xs)\\n\\n\\ndef trim_outliers(xs, z=2.0):\\n    \\\"\\\"\\\"去掉 |z 分数| 超过阈值的点，返回保留的元素。\\\"\\\"\\\"\\n    zs = zscores(xs)\\n    return [x for x, zv in zip(xs, zs) if abs(zv) <= z]\\n\\n\\ndef batch_summary(batches):\\n    \\\"\\\"\\\"对每个批次输出 (均值, 中位数, 标准差)。\\\"\\\"\\\"\\n    return [(mean(b), median(b), std(b)) for b in batches]\\n\"}}"}, {"role": "assistant", "content": "{\"tool\":\"command\",\"argv\":[\"python\",\"-m\",\"pytest\",\"-q\"]}"}, {"role": "user", "content": "{\"tool_result\": {\"rc\": 1, \"stdout\": \".FF.F..F...FFFF......FFFFF..                                             [100%]\\n=================================== FAILURES ===================================\\n___________________________ test_median_even_length ____________________________\\n\\n    def test_median_even_length():\\n        # 排序后中间两数为 13 和 14，中位数应为 13.5\\n>       assert median(SERIES_A) == 13.5\\nE       assert 14 == 13.5\\nE        +  where 14 = median([12, 7, 3, 19, 25, 8, ...])\\n\\ntest_stats_core.py:14: AssertionError\\n__________________________ test_median_even_length_b ___________________________\\n\\n    def test_median_even_length_b():\\n        s = sorted(SERIES_B)\\n        expected = (s[7] + s[8]) / 2\\n>       assert median(SERIES_B) == expected\\nE       assert 94 == 93.0\\nE        +  where 94 = median([101, 87, 94, 76, 110, 99, ...])\\n\\ntest_stats_core.py:20: AssertionError\\n___________________________ test_median_two_elements ___________________________\\n\\n    def test_median_two_elements():\\n>       assert median([10, 20]) == 15.0\\nE       assert 20 == 15.0\\nE        +  where 20 = median([10, 20])\\n\\ntest_stats_core.py:28: AssertionError\\n______