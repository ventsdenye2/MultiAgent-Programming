{"event": "file_write", "time": 1792045586.094482, "path": "pricing.py", "content": "from models import Item, User\n\n\nVIP_DISCOUNT = 0.9\nFREE_SHIPPING_THRESHOLD = 200\nSHIPPING_FEE = 10\n\n\ndef items_subtotal(items):\n    \"\"\"商品小计。\"\"\"\n    return sum(item.price for item in items)\n\n\ndef apply_vip(subtotal, user):\n    \"\"\"VIP 用户全场九折，普通用户原价。\"\"\"\n    if getattr(user, \"is_vip\", False):\n        return subtotal * VIP_DISCOUNT\n    return subtotal\n\n\ndef shipping_fee(amount):\n    \"\"\"折后满 200 免运费，否则收 10 元。\"\"\"\n    if amount >= FREE_SHIPPING_THRESHOLD:\n        return 0\n    return SHIPPING_FEE\n"}
