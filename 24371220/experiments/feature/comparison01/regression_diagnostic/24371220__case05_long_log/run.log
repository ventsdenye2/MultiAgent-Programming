eneral(xs, expected):\n>       assert stats.median(xs) == pytest.approx(expected)\nE       assert 8 == 5 ± 5.0e-06\nE         \nE         comparison failed\nE         Obtained: 8\nE         Expected: 5 ± 5.0e-06\n\ntest_stats_edges.py:8: AssertionError\n_________________________ test_median_general[xs2--5] __________________________\n\nxs = [-8, -2], expected = -5\n\n    @pytest.mark.parametrize(\"xs,expected\", [([2], 2), ([2, 8], 5), ([-8, -2], -5),\n                                          ([1, 1, 4, 4], 2.5), ([.1, .7], .4), ([9, 1, 5], 5)])\n    def test_median_general(xs, expected):\n>       assert stats.median(xs) == pytest.approx(expected)\nE       assert -2 == -5 ± 5.0e-06\nE         \nE         comparison failed\nE         Obtained: -2\nE         Expected: -5 ± 5.0e-06\n\ntest_stats_edges.py:8: AssertionError\n_________________________ test_median_general[xs3-2.5] _________________________\n\nxs = [1, 1, 4, 4], expected = 2.5\n\n    @pytest.mark.parametrize(\"xs,expected\", [([2], 2), ([2, 8], 5), ([-8, -2], -5),\n                                          ([1, 1, 4, 4], 2.5), ([.1, .7], .4), ([9, 1, 5], 5)])\n    def test_median_general(xs, expected):\n>       assert stats.median(xs) == pytest.approx(expected)\nE       assert 4 == 2.5 ± 2.5e-06\nE         \nE         comparison failed\nE         Obtained: 4\nE         Expected: 2.5 ± 2.5e-06\n\ntest_stats_edges.py:8: AssertionError\n_________________________ test_median_general[xs4-0.4] _________________________\n\nxs = [0.1, 0.7], expected = 0.4\n\n    @pytest.mark.parametrize(\"xs,expected\", [([2], 2), ([2, 8], 5), ([-8, -2], -5),\n                                          ([1, 1, 4, 4], 2.5), ([.1, .7], .4), ([9, 1, 5], 5)])\n    def test_median_general(xs, expected):\n>       assert stats.median(xs) == pytest.approx(expected)\nE       assert 0.7 == 0.4 ± 4.0e-07\nE         \nE         comparison failed\nE         Obtained: 0.7\nE         Expected: 0.4 ± 4.0e-07\n\ntest_stats_edges.py:8: AssertionErro