\"\\\"去掉 |z 分数| 超过阈值的点，返回保留的元素。\\\"\\\"\\\"\\n    zs = zscores(xs)\\n    return [x for x, zv in zip(xs, zs) if abs(zv) <= z]\\n\\n\\ndef batch_summary(batches):\\n    \\\"\\\"\\\"对每个批次输出 (均值, 中位数, 标准差)。\\\"\\\"\\\"\\n    return [(mean(b), median(b), std(b)) for b in batches]\\n\"}}\n\n{\"id\": 8, \"tool\": \"invalid\", \"path\": \"\", \"action\": null, \"result\": {\"error\": \"Extra data: line 3 column 1 (char 35)\"}}\n\n{\"id\": 5, \"tool\": \"plan\", \"path\": \"\", \"action\": {\"tool\": \"plan\", \"items\": [{\"title\": \"运行修改前完整 pytest 基线\", \"status\": \"done\"}, {\"title\": \"运行 run_checks.py 保留失败输出\", \"status\": \"doing\"}, {\"title\": \"阅读 stats.py 与测试定位共同根因\", \"status\": \"todo\"}, {\"title\": \"修复 stats.py\", \"status\": \"todo\"}, {\"title\": \"运行修改后完整 pytest 与 run_checks.py 验证\", \"status\": \"todo\"}]}, \"result\": {\"items\": [{\"title\": \"运行修改前完整 pytest 基线\", \"status\": \"done\"}, {\"title\": \"运行 run_checks.py 保留失败输出\", \"status\": \"doing\"}, {\"title\": \"阅读 stats.py 与测试定位共同根因\", \"status\": \"todo\"}, {\"title\": \"修复 stats.py\", \"status\": \"todo\"}, {\"title\": \"运行修改后完整 pytest 与 run_checks.py 验证\", \"status\": \"todo\"}]}}\n\n{\"id\": 2, \"tool\": \"list\", \"path\": \"\", \"action\": {\"tool\": \"list\"}, \"result\": {\"files\": [\"run_checks.py\", \"stats.py\", \"test_stats_core.py\", \"test_stats_edges.py\", \"test_stats_pipeline.py\"]}}"}], "discarded_ids": []}
