{"event": "file_read", "time": 1792045454.9063957, "path": "string_utils.py", "content": "\"\"\"字符串工具集。\"\"\"\n\n\ndef snake_to_camel(s):\n    \"\"\"下划线命名转小驼峰：foo_bar -> fooBar。\"\"\"\n    parts = s.split(\"_\")\n    return parts[0] + \"\".join(p.title() for p in parts[1:])\n\n\ndef camel_to_snake(s):\n    \"\"\"驼峰转下划线：fooBar -> foo_bar。\"\"\"\n    out = []\n    for ch in s:\n        if ch.isupper():\n            out.append(\"_\")\n            out.append(ch.lower())\n        else:\n            out.append(ch)\n    return \"\".join(out).lstrip(\"_\")\n\n\ndef count_words(s):\n    \"\"\"按空白统计单词数。\"\"\"\n    return len(s.split())\n"}
