@@ -22,3 +22,15 @@
 def count_words(s):
     """按空白统计单词数。"""
     return len(s.split())
+
+
+def truncate_middle(s, max_len):
+    """中间截断，保留首尾并以 ... 连接。"""
+    if max_len < 5:
+        raise ValueError("max_len must be at least 5")
+    if len(s) <= max_len:
+        return s
+    head_len = (max_len - 3 + 1) // 2
+    tail_len = max_len - 3 - head_len
+    tail = s[len(s) - tail_len:] if tail_len else ""
+    return s[:head_len] + "..." + tail
