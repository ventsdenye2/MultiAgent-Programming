 ValueError(\\\"empty sequence\\\")\\n    return sum(xs) / len(xs)\\n\\n\\ndef median(xs):\\n    if not xs:\\n        raise ValueError(\\\"empty sequence\\\")\\n    s = sorted(xs)\\n    n = len(s)\\n    mid = n // 2\\n    if n % 2 == 1:\\n        return s[mid]\\n    return s[mid]\\n\\n\\ndef variance(xs):\\n    m = mean(xs)\\n    return sum((x - m) ** 2 for x in xs) / len(xs)\\n\\n\\ndef std(xs):\\n    return variance(xs) ** 0.5\\n\\n\\ndef zscores(xs):\\n    m = mean(xs)\\n    sd = std(xs)\\n    if sd == 0:\\n        return [0.0 for _ in xs]\\n    return [(x - m) / sd for x in xs]\\n\\n\\ndef moving_average(xs, k):\\n    if k <= 0:\\n        raise ValueError(\\\"window must be positive\\\")\\n    return [mean(xs[i:i + k]) for i in range(len(xs) - k + 1)]\\n\\n\\ndef robust_center(xs):\\n    \\\"\\\"\\\"抗离群点的中心估计：中位数。\\\"\\\"\\\"\\n    return median(xs)\\n\\n\\ndef trim_outliers(xs, z=2.0):\\n    \\\"\\\"\\\"去掉 |z 分数| 超过阈值的点，返回保留的元素。\\\"\\\"\\\"\\n    zs = zscores(xs)\\n    return [x for x, zv in zip(xs, zs) if abs(zv) <= z]\\n\\n\\ndef batch_summary(batches):\\n    \\\"\\\"\\\"对每个批次输出 (均值, 中位数, 标准差)。\\\"\\\"\\\"\\n    return [(mean(b), median(b), std(b)) for b in batches]\\n\"}}"}, {"role": "assistant", "content": "{\"tool\":\"command\",\"argv\":[\"python\",\"run_checks.py\"]}"}, {"role": "user", "content": "{\"tool_result\": {\"rc\": 1, \"stdout\": \"[MISMATCH] batch=000 len=6 median got=52.5 want=43.75 input=[0.0, 17.5, 35.0, 52.5, 68.0, 85.5]\\n[MISMATCH] batch=000 batch_summary median got=52.5 want=43.75\\n[MISMATCH] batch=002 len=20 median got=51.5 want=46.25 input=[62.0, 79.5, 8.0, 25.5, 41.0, 58.5, 76.0, 4.5, 20.0, 37.5, 55.0, 72.5, 88.0, 16.5, 34.0, 51.5, 67.0, 84.5, 13.0, 30.5]\\n[MISMATCH] batch=002 batch_summary median got=51.5 want=46.25\\n[MISMATCH] batch=004 len=34 median got=49.0 want=47.25 input=[35.0, 52.5, 70.0, 87.5, 14.0, 31.5, 49.0, 66.5, 82.0, 10.5, 28.0, 45.5, 61.0, 78.5, 7.0, 24.5, 40.0, 57.5, 75.0, 3.5, 19.0, 36.5, 54.0, 71.5, 87.0, 15.5, 3