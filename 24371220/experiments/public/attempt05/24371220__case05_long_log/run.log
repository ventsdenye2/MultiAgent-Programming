        +  where 94 = median([101, 87, 94, 76, 110, 99, ...])\\n\\ntest_stats_core.py:20: AssertionError\\n___________________________ test_median_two_elements ___________________________\\n\\n    def test_median_two_elements():\\n>       assert median([10, 20]) == 15.0\\nE       assert 20 == 15.0\\nE        +  where 20 = median([10, 20])\\n\\ntest_stats_core.py:28: AssertionError\\n________________________ test_robust_center_uses_median ________________________\\n\\n    def test_robust_center_uses_median():\\n        data = [10, 11, 12, 13, 14, 15, 16, 200]\\n>       assert robust_center(data) == 13.5\\nE       assert 14 == 13.5\\nE        +  where 14 = robust_center([10, 11, 12, 13, 14, 15, ...])\\n\\ntest_stats_core.py:43: AssertionError\\n__________________________ test_median_general[xs1-5] __________________________\\n\\nxs = [2, 8], expected = 5\\n\\n    @pytest.mark.parametrize(\\\"xs,expected\\\", [([2], 2), ([2, 8], 5), ([-8, -2], -5),\\n                                          ([1, 1, 4, 4], 2.5), ([.1, .7], .4), ([9, 1, 5], 5)])\\n    def test_median_general(xs, expected):\\n>       assert stats.median(xs) == pytest.approx(expected)\\nE       assert 8 == 5 ± 5.0e-06\\nE         \\nE         comparison failed\\nE         Obtained: 8\\nE         Expected: 5 ± 5.0e-06\\n\\ntest_stats_edges.py:8: AssertionError\\n_________________________ test_median_general[xs2--5] __________________________\\n\\nxs = [-8, -2], expected = -5\\n\\\n[中段已裁剪；完整内容见 run.log]\nne.py:27: AssertionError\\n__________________________ test_batch_summary_medians __________________________\\n\\n    def test_batch_summary_medians():\\n        batches = [LONG_1, LONG_2, LONG_3]\\n        result = batch_summary(batches)\\n        medians = [r[1] for r in result]\\n>       assert medians == [expected_median(b) for b in batches]\\nE       assert [95, 108, 90] == [93.0, 107.5, 89.5]\\nE         \\nE         At index 0 diff: 95 != 93.0\\nE         Use -v to get more diff\\n\\ntest_stats_pipeline.py:34: AssertionError\\n________________________ test_batch_summary_full_output ________________________\\n\\n    def test_batch_summary_full_output():\\n        batches = [LONG_1[:20], LONG_2[:24]]\\n        result = batch_summary(batches)\\n        assert len(result) == 2\\n        for (m, med, sd), b in zip(result, batches):\\n            assert abs(m - sum(b) / len(b)) < 1e-9\\n>           assert med == expected_median(b)\\nE           assert 43 == 41.0\\nE            +  where 41.0 = expected_median([3, 7, 11, 15, 19, 23, ...])\\n\\ntest_stats_pipeline.py:43: AssertionError\\n=========================== short test summary info ============================\\nFAILED test_stats_core.py::test_median_even_length - assert 14 == 13.5\\nFAILED test_stats_core.py::test_median_even_length_b - assert 94 == 93.0\\nFAILED test_stats_core.py::test_median_two_elements - assert 20 == 15.0\\nFAILED test_stats_core.py::test_robust_center_uses_median - assert 14 == 13.5\\nFAILED test_stats_edges.py::test_median_general[xs1-5] - assert 8 == 5 ± 5.0e-06\\nFAILED test_stats_edges.py::test_median_general[xs2--5] - assert -2 == -5 ± 5...\\nFAILED test_stats_edges.py::test_median_general[xs3-2.5] - assert 4 == 2.5 ± ...\\nFAILED test_stats_edges.py::test_median_general[xs4-0.4] - assert 0.7 == 0.4 ...\\nFAILED test_stats_pipeline.py::test_median_long_1 - assert 95 == 93.0\\nFAILED test_stats_pipeline.py::test_median_long_2 - assert 108 == 107.5\\nFAILED test_stats_pipeline.py::test_median_long_3 - assert 90 == 89.5\\nFAILED test_stats_pipeline.py::test_batch_summary_medians - assert [95, 108, ...\\nFAILED test_stats_pipeline.py::test_batch_summary_full_output - assert 43 == ...\\n13 failed, 15 passed in 6.87s\\n\", \"stderr\": \"\"}}"}], "stream": false, "temperature": 0, "response_format": {"type": "json_object"}, "max_tokens": 4096}}
