dding.py", "deepinfer/model_executor/layers/sampler.py", "deepinfer/model_executor/layers/sampler_utils.py", "deepinfer/model_executor/layers/tilelang_ops/__init__.py", "deepinfer/model_executor/layers/tilelang_ops/asc/__init__.py", "deepinfer/model_executor/layers/tilelang_ops/asc/candidate_blocks.py"], "offset": 0, "limit": 50}}
{"event": "code_execution", "time": 1793187415.8917947, "run_id": "1323fe13085549ab9c3bb66657bbd088", "seq": 81, "step_id": 8, "stdout": "{'path': 'deepinfer/engine/stats_logger.py', 'content': 'class StatsLogger:\\n    \"\"\"Owns all sliding-window data, timing accumulators and logging state.\\n\\n    The ``engine`` back-reference is used as follows:\\n\\n    Read-only:\\n      - ``scheduler`` (block counts, preempted/aborted, running/pending/chunked)\\n      - ``state_manager`` (state cache usage)\\n      - ``num_finished_completion``\\n      - ``generate_step`` / ``step_start`` / ``last_step_interval``\\n      - ``get_num_pendings()`` / ``build_extra_metrics_log()``\\n\\n    Mutated (kept on the engine for use by subclasses / other code):\\n      - ``finished_payload`` — trimmed to the logging window each log step\\n      - ``last_step_time`` — set to ``now`` at the end of every step\\n    \"\"\"\\n\\n    def __init__(\\n        self,\\n        engine: LLMEngine,\\n        *,\\n        model_config: ModelConfig,\\n        parallel_config: ParallelConfig,\\n        cache_config: CacheConfig,\\n        engine_type: EngineType,\\n        tflops_limit: float,\\n    ) -> None:\\n        self._engine = engine\\n\\n        # read-only config refs\\n        self._model_config = model_config\\n        self._parallel_config = parallel_config\\n        self._cache_config = cache_config\\n        self._engine_type = engine_type\\n        self._tflops_limit = tflops_limit\\n\\n        # sliding-window data (payload shape noted per window)\\n        self._prompt_tokens = Window()  # payload: num_batched_tokens\\n        self._generation_tokens = Window()  # payload: (gen_tokens, num_seqs, num_batched_tokens)\\n        self._verified_tokens = Window()  # payload: num_verified_tokens | None\\n        self._confidence_errors = Window()  # payload: batch_confidence_error\\n        self._moe_lb = Window()  # payload: (avg_tokens, max_tokens)\\n        self._tflops = Window()  # payload: tflops\\n        self._windows = (\\n            self._prompt_tokens,\\n            self._generation_tokens,\\n            self._verified_tokens,\\n            self._confidence_errors,\\n            self._moe_lb,\\n            self._tflops,\\n        )\\n\\n        # timing / counters\\n        self._last_logging_time = 0.0\\n        self._last_logging_step = -1\\n        self._nccl_memory_logger = NCCLMemoryStatsLogger(engine)\\n        self._log_queue: queue.SimpleQueue[list[str] | None] = queue.SimpleQueue()\\n        self._log_worker_thread = threading.Thread(target=_log_worker, args=(self._log_queue,), daemon=True, name=\"stats_log_worker\")\\n        self._log_worker_thread.start()\\n        self._prefill_cached_tokens: deque[tuple[int, int]] = deque(maxlen=50)\\n\\n    # ------------------------------------------------------------------\\n    # window aggregation helpers\\n    # ------------------------------------------------------------------\\n\\n    @staticmethod\\n    def _throughput(window: Window, now: float, key: Callable[[object], float]) -> tuple[float, int]:\\n        \"\"\"(tokens/s, total_tokens) over a window, ignoring the first sample.\"\"\"\\n        if len(window) <= 1:\\n            return 0.0, 0\\n        total = sum(key(p) for _, p, _ in window.entries[1:])\\n        # 口径：首条仅作窗口起点（值不计入），分母延伸到 now——含末样本之后的空窗，窗口停更时数值随时间衰减（对比 _mfu）\\n        return total / (now - window.entries[0][0]), total\\n\\n    def _mfu(self, now: float) -> float:\\n        entries = self._tflops.entries\\n        if len(entries) <= 1:\\n            return 0.0\\n        # 口径：首条仅作区间起点（值不计入），分母为首尾样本间隔、不延伸到 now（对比 _throughput；_tflops 每步都追加，实际末样本时间戳即 now）\\n        tflops_per_s = (sum(v for _, v, _ in entries) - entries[0][1]) / (entries[-1][0] - entries[0][0])\\n        return tflops_per_s / self._parallel_config.model_parallel_size / self._tflops_limit\\n\\n    def _nextn_stats(self, agg: Aggregates) -> None:\\n        \"\"\"Fill nextn accept rates / verified-len / confidence error in *agg*.\"\"\"\\n        n = envs.DEEPINFER_USE_NEXTN_DECODE + 1\\n        accepted = [0] * n\\n        for _, (gen, _, _), _ in self._generation_tokens.entries:\\n            for i, v in enumerate(gen):\\n                accepted[i] += v\\n        verified = [0] * n\\n        for _, vt, _ in self._verified_tokens.entries:\\n            if vt is not None:\\n                for i, v in enumerate(vt):\\n                    verified[i] += v\\n\\n        agg.sum_accepted = accepted\\n        agg.sum_batched = self._generation_tokens.sum(lambda p: p[1])\\n        agg.sum_total = self._generation_tokens.sum(lambda p: p[2])\\n        if agg.sum_batched == 0 or n < 2:\\n            return\\n\\n        agg.nextn_rates = [accepted[i] / verified[i] if verified[i] > 0 else 0.0 for i in range(1, n)]\\n        agg.nextn_rate = sum(accepted[1:]) / (agg.sum_total - agg.sum_batched + 1e-15)\\n        agg.avg_vlen = sum(verified[1:]) / agg.sum_batched\\n\\n        verified_count = agg.sum_total - agg.sum_batched\\n        if verified_count > 0:\\n            agg.avg_err = self._confidence_errors.sum(lambda e: e) / verified_count\\n\\n    def _moe_lb_ratio(self) -> float:\\n        if not self._moe_lb:\\n            return 1.0  # 无数据时默认完美均衡\\n        return self._moe_lb.sum(lambda p: p[1]) / max(1, self._moe_lb.sum(lambda p: p[0]))\\n\\n    def _finished_payload_stats(self) -> tuple[float, float, float]:\\n        \"\"\"(avg_prompt_len, avg_completion_len, payload_len)；payload 元组为 (num_finished, output_len, prompt_len, payload_len)。\"\"\"\\n        fp = self._engine.finished_payload\\n        num_finished = sum(p[0] for _, p, _ in fp)\\n        if num_finished == 0:\\n            return 0.0, 0.0, 0.0\\n        completion = sum(p[1] for _, p, _ in fp)\\n        prompt = sum(p[2] for _, p, _ in fp)\\n        payload = sum(p[3] for _, p, _ in fp)\\n        return prompt / num_finished, completion / num_finished, (payload / completion if completion > 0 else 0.0)\\n\\n    @staticmethod\\n    def _merge_cuda_timers() -> tuple[dict, dict, dict, dict]:\\n        \"\"\"把所有 cuda timer 合并为 (times, called, max_time, latest_times)。\"\"\"\\n        times, called, max_time, latest = {}, {}, {}, {}\\n        for lbl, tmr in get_timers():\\n            if lbl.startswith(\"cuda\"):\\n                for n, t in tmr.times.items():\\n                    times[n] = times.get(n, 0.0) + t\\n                    called[n] = called.get(n, 0) + tmr.called[n]\\n                    max_time[n] = max(max_time.get(n, 0.0), tmr.max_time[n])\\n                for n, t in tmr.latest_times.items():\\n                    latest[n] = latest.get(n, 0.0) + t\\n        return times, called, max_time, latest\\n\\n    # ------------------------------------------------------------------\\n    # logging\\n    # ------------------------------------------------------------------\\n\\n    def _build_log_messages(self, s: StepStats, a: Aggregates) -> list[str]:\\n        \"\"\"Build log lines.\"\"\"\\n        rank = dist.get_rank()\\n        gpu_id = self._engine.driver_gpu_id\\n        engine_t = cpu_timer.times.get(\"engine_step\", 1e9)\\n        lines: list[str] = []\\n\\n        def _fmt(label: str, times: dict, called: dict, max_t: dict, lat: dict) -> None:\\n            items = [\\n                f\"{n} cur{1000 * lat.get(n, 0):.1f}ms/mean{1000 * t / called[n]:.1f}ms\"\\n                f\"/max{1000 * max_t[n]:.1f}ms/{called[n]}calls/{100 * t / engine_t:.1f}%\"\\n                for n, t in sorted(times.items(), key=lambda x: -x[1])\\n                if n != \"engine_step\"\\n            ]\\n            if items:\\n                lines.append(f\"RANK {rank}, GPU {gpu_id}, step {self._engine.generate_step}, [{label}] ({\\' | \\'.join(items)})\")\\n\\n        _fmt(\"cpu\", cpu_timer.times, cpu_timer.called, cpu_timer.max_time, cpu_timer.latest_times)\\n        cuda_times, cuda_called, cuda_max, cuda_latest = self._merge_cuda_timers()\\n        _fmt(\"cuda\", cuda_times, cuda_called, cuda_max, cuda_latest)\\n\\n        # prefill caching pct\\n        total_calc = sum(calc for calc, _ in self._prefill_cached_tokens)\\n        gpu_pct = sum(gpu for _, gpu in self._prefill_cached_tokens) / max(1, total_calc)\\n\\n        items = [\\n            f\"is_prompt {s.prompt_run}\",\\n            f\"cur_SPS {a.cur_sps:.3f}\",\\n            f\"avg_SPS {a.avg_sps:.3f}\",\\n            f\"cur_TPS {a.cur_tps:.1f}\",\\n            f\"prompt_TPS {a.prompt_tps:.1f}\",\\n            f\"completion_TPS {a.gen_tps:.1f}\",\\n            f\"avg_nextn_accept_rate {a.nextn_rate * 100:.2f}%\",\\n            f\"nextn_accept_rate [{\\', \\'.join(f\\'{r * 100:.2f}%\\' for r in a.nextn_rates)}]\",\\n            f\"verified_tokens {a.sum_total - a.sum_batched}\",\\n            f\"accepted_tokens {sum(a.sum_accepted[1:])}\",\\n            f\"avg_verified_len {a.avg_vlen:.2f}\",\\n            f\"avg_confidence_error {a.avg_err:.4f}\",\\n            f\"moe_lb {a.moe_lb:.4f}\",\\n        ]\\n        items += [\\n            f\"running {a.num_runnings}\",\\n            f\"pending {a.num_pendings}\",\\n            f\"chunked {a.num_chunked}\",\\n            f\"num_batched_tokens {s.num_batched_tokens}[{a.batch_pct * 100:.2f}%]\",\\n            f\"KV_cache_usage {a.gpu_cache_usage * 100:.2f}%\",\\n        ]\\n        if self._engine.state_manager is not None:\\n            items.append(f\"state_cache_usage {a.gpu_state_usage * 100:.2f}%\")\\n        if self._engine_type == EngineType.NORMAL:\\n            prefill_t = cpu_timer.times.get(\"engine_step:prefill\", 0.0)\\n            decode_t = cpu_timer.times.get(\"engine_step:decode\", 0.0)\\n            total_t = prefill_t + decode_t\\n            items.append(f\"prefill/decode {100 * safe_divide(prefill_t, total_t):.2f}%/{100 * safe_divide(decode_t, total_t):.2f}%\")\\n        items += [\\n            f\"prefill_caching_rate (GPU {gpu_pct * 100:.2f}%)\",\\n            f\"TTFT (max {a.max_TTFT:.1f} ms, mean {a.mean_TTFT:.1f} ms)\",\\n            f\"avg_length (input {a.avg_prompt_len:.1f}, output {a.avg_completion_len:.1f})\",\\n            f\"finished {self._engine.num_finished_completion}\",\\n            f\"preempted {a.num_preempted}\",\\n            f\"aborted {a.num_aborted}\",\\n            f\"sum_seqlen_qxk {s.sum_seqlen_qxk}\",\\n            f\"max_seqlen_k {s.max_seqlen_k}\",\\n            f\"min_seqlen_k {s.min_seqlen_k}\",\\n            f\"attn_TFLOPs {s.attn_tflops:.1f}\",\\n            f\"MFU {a.mfu:.3f}\",\\n        ]\\n        msg = f\"RANK {rank}, GPU {gpu_id}, step {self._engine.generate_step}, [stats] ({\\' | \\'.join(items)})\"\\n        return [msg, *lines]\\n\\n    def _emit_logs(self, msgs: list[str]) -> None:\\n        \"\"\"投递日志到固定 worker 线程，主线程不触碰 logger 的 handler 锁。\"\"\"\\n        self._log_queue.put(msgs)\\n\\n    def close(self) -> None:\\n        \"\"\"写完队列中已投递的日志后停掉 worker 线程；重复调用安全。\"\"\"\\n        self._log_queue.put(None)\\n        self._log_worker_thread.join()\\n\\n    # ------------------------------------------------------------------\\n    # record / aggregate steps\\n    # ------------------------------------------------------------------\\n\\n    def _record(self, s: StepStats, now: float, gen_tokens: list[int]) -> float:\\n        \"\"\"Append per-step records and return batch utilization.\"\"\"\\n        step = self._engine.generate_step\\n\\n        if s.prompt_run:\\n            self._prompt_tokens.append(now, s.num_batched_tokens, step)\\n            batch_pct = s.num_batched_tokens / self._model_config.max_num_batched_tokens\\n            calc_tokens = s.num_batched_tokens + s.num_cached_tokens_gpu\\n            if calc_tokens > 0:\\n                cpu_timer.add_time(\"engine_step:prefill\", now - self._engine.last_step_time)\\n                self._prefill_cached_tokens.append((calc_tokens, s.num_cached_tokens_gpu))\\n        else:\\n            self._generation_tokens.append(now, (gen_tokens, s.num_seqs, s.num_batched_tokens), step)\\n            self._verified_tokens.append(now, s.num_verified_tokens, step)\\n            self._confidence_errors.append(now, s.batch_confidence_error, step)\\n            batch_pct = s.num_batched_tokens / (self._model_config.max_num_seqs * (1 + envs.DEEPINFER_USE_NEXTN_DECODE))\\n            if s.num_seqs > 0:\\n                cpu_timer.add_time(\"engine_step:decode\", now - self._engine.last_step_time)\\n\\n        self._tflops.append(now, s.total_tflops, step)\\n\\n        if s.moe_load_balance_ratio is not None and s.moe_load_balance_ratio[0] > 0:\\n            self._moe_lb.append(now, s.moe_load_balance_ratio, step)\\n\\n        return batch_pct\\n\\n    def _should_log(self, s: StepStats) -> tuple[bool, int]:\\n        \"\"\"Return (should_log, logging_interval).\"\"\"\\n        step = self._engine.generate_step\\n        interval = envs.DEEPINFER_LOGGING_INTERVAL_STEP\\n        if interval <= 0:\\n            return False, interval\\n        if self._engine_type == EngineType.PROMPT:\\n            interval = max(1, interval // 5)\\n        should_log = step == 0 or step - self._last_logging_step >= interval\\n        return should_log, interval\\n\\n    def _collect(self, s: StepStats, now: float, gen_tokens: list[int], should_log: bool, a: Aggregates) -> None:\\n        \"\"\"Fill window + per-step aggregates into *a*; scheduler/TTFT/payload stats only on logging steps.\"\"\"\\n        step = self._engine.generate_step\\n        eng = self._engine\\n\\n        if should_log:\\n            a.prompt_tps, a.total_prompt = self._throughput(self._prompt_tokens, now, lambda p: p)\\n            a.gen_tps, a.total_gen = self._throughput(self._generation_tokens, now, lambda p: sum(p[0]))\\n            a.mfu = self._mfu(now)\\n            self._nextn_stats(a)\\n            a.moe_lb = self._moe_lb_ratio()\\n\\n        # per-step (always)\\n        step_dur = eng.last_step_interval if (envs.DEEPINFER_ZERO_OVERHEAD_SCHEDULING and step > 0) else now - eng.step_start\\n        a.cur_sps = 1 / step_dur\\n        a.avg_sps = 0.0 if self._last_logging_time == 0 else (step - self._last_logging_step) / (now - self._last_logging_time)\\n        a.cur_tps = sum(gen_tokens) / step_dur\\n\\n        total_gpu = self._cache_config.num_gpu_blocks - 1\\n        a.gpu_cache_usage = (total_gpu - eng.scheduler.get_num_free_gpu_blocks()) / total_gpu\\n        if eng.state_manager is not None:\\n            total_states = self._cache_config.num_state_seqs - 1\\n            a.gpu_state_usage = (total_states - eng.state_manager.get_num_free_blocks()) / total_states\\n\\n        a.num_pendings = eng.get_num_pendings()\\n        a.num_runnings, _ = eng.scheduler.get_sum_prompt_len_running()\\n        a.num_chunked, _ = eng.scheduler.get_sum_prompt_len_chunked()\\n\\n        # expensive stats (only on logging steps)\\n        if should_log:\\n            a.num_preempted = eng.scheduler.get_num_preempted_seqs()\\n            a.num_aborted = eng.scheduler.get_num_aborted_seqs()\\n            a.max_TTFT = max(s.first_token_latencies, default=0)\\n            a.mean_TTFT = statistics.mean(s.first_token_latencies) if len(s.first_token_latencies) > 0 else 0\\n            a.avg_prompt_len, a.avg_completion_len, a.payload_len = self._finished_payload_stats()\\n\\n    # ------------------------------------------------------------------\\n    # main entry point\\n    # ------------------------------------------------------------------\\n\\n    def log_nccl_memory(self) -> None:\\n        msg = self._nccl_memory_logger.step()\\n        if msg:\\n            self._emit_logs([msg])\\n\\n    @cpu_timer.record(\"log_stats\")\\n    def log_step(self, s: StepStats) -> None:\\n        \"\"\"Collect per-step stats; periodically log.\\n\\n        NOTE 假设这里面的操作是无副作用的，即在 should_log=False 时不调用也不影响正确性。\\n        \"\"\"\\n        now = time.perf_counter()\\n        eng = self._engine\\n        gen_tokens = s.num_generated_tokens if s.num_generated_tokens is not None else [s.num_batched_tokens]\\n\\n        # 1. record raw per-step data\\n        a = Aggregates()\\n        a.batch_pct = self._record(s, now, gen_tokens)\\n\\n        # 2. decide whether to log, then trim + aggregate\\n        should_log, interval = self._should_log(s)\\n        if should_log or interval <= 0:\\n            base_age = max(0, interval)\\n            for w in self._windows:\\n                max_age = max(base_age, envs.DEEPINFER_MOE_LB_STAT_INTERVAL) if w is self._moe_lb else base_age\\n                w.trim(eng.generate_step, max_age)\\n            eng.finished_payload = [e for e in eng.finished_payload if eng.generate_step - e[2] <= base_age]\\n        self._collect(s, now, gen_tokens, should_log, a)\\n\\n        # 3. log\\n        if should_log:\\n            msgs = self._build_log_messages(s, a)\\n            extra = eng.build_extra_metrics_log()\\n            if extra is not None:\\n                msgs.append(extra)\\n            self._emit_logs(msgs)\\n\\n        # 4. reset timers + bookkeeping\\n        if should_log or interval <= 0:\\n            for _, timer in get_timers():\\n                timer.clear()\\n            self._last_logging_time = now\\n            self._last_logging_step = eng.generate_step\\n        eng.last_step_time = now\\n        for _, timer in get_timers():\\n            timer.clear_latest()\\n', 'file_hash': '9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9', 'start_line': 129, 'end_line': 477, 'evidence_ids': ['ev-000004']}{'files': ['deepinfer/_C/__init__.pyi', 'deepinfer/_C/cuda_utils.pyi', 'deepinfer/_C/engine.pyi', 'deepinfer/_C/graph_timer.pyi', 'deepinfer/__init__.py', 'deepinfer/attrdict.py', 'deepinfer/config.py', 'deepinfer/distributed/__init__.py', 'deepinfer/distributed/shm_broadcast.py', 'deepinfer/engine/__init__.py', 'deepinfer/engine/arg_utils.py', 'deepinfer/engine/engine_type.py', 'deepinfer/engine/llm_engine.py', 'deepinfer/engine/profile_server.py', 'deepinfer/engine/stats_logger.py', 'deepinfer/entrypoints/__init__.py', 'deepinfer/entrypoints/llm.py', 'deepinfer/environ.py', 'deepinfer/hugging_face/__init__.py', 'deepinfer/hugging_face/config.py', 'deepinfer/hugging_face/loading.py', 'deepinfer/hugging_face/names.py', 'deepinfer/hugging_face/parameters.py', 'deepinfer/hugging_face/processor.py', 'deepinfer/hugging_face/tokenizer.py', 'deepinfer/hugging_face/weights.py', 'deepinfer/load_class.py', 'deepinfer/logger.py', 'deepinfer/model_config_loader.py', 'deepinfer/model_executor/__init__.py', 'deepinfer/model_executor/eplb/__init__.py', 'deepinfer/model_executor/eplb/policy.py', 'deepinfer/model_executor/eplb/shuffle.py', 'deepinfer/model_executor/input_metadata/__init__.py', 'deepinfer/model_executor/input_metadata/dflash.py', 'deepinfer/model_executor/input_metadata/input_metadata.py', 'deepinfer/model_executor/input_metadata/prepare_tensor_input_zos.py', 'deepinfer/model_executor/input_metadata/yoco.py', 'deepinfer/model_executor/layer_utils.py', 'deepinfer/model_executor/layers/__init__.py', 'deepinfer/model_executor/layers/attention_backend.py', 'deepinfer/model_executor/layers/layernorm.py', 'deepinfer/model_executor/layers/linear.py', 'deepinfer/model_executor/layers/mtp_info_pool.py', 'deepinfer/model_executor/layers/rotary_embedding.py', 'deepinfer/model_executor/layers/sampler.py', 'deepinfer/model_executor/layers/sampler_utils.py', 'deepinfer/model_executor/layers/tilelang_ops/__init__.py', 'deepinfer/model_executor/layers/tilelang_ops/asc/__init__.py', 'deepinfer/model_executor/layers/tilelang_ops/asc/candidate_blocks.py'], 'offset': 0, 'limit': 50}", "output_truncated": false, "error": null, "tool_calls": [{"name": "update_plan", "args": {"items": [{"title": "读取三个目标文件全文并定位相关配置、格式化与统计消费代码", "status": "doing"}, {"title": "执行初始完整 pytest 并记录基线", "status": "todo"}, {"title": "修改 environ.py 增加受限整型配置及刷新兼容", "status": "todo"}, {"title": "修改 logger.py 实现消息预算及默认初始化接入", "status": "todo"}, {"title": "修改 stats_logger.py 为队列消费日志附加 keep_full_message", "status": "todo"}, {"title": "运行完整 pytest、生成 run.log 与 patch.diff 并复核", "status": "todo"}]}, "result": {"items": [{"title": "读取三个目标文件全文并定位相关配置、格式化与统计消费代码", "status": "doing"}, {"title": "执行初始完整 pytest 并记录基线", "status": "todo"}, {"title": "修改 environ.py 增加受限整型配置及刷新兼容", "status": "todo"}, {"title": "修改 logger.py 实现消息预算及默认初始化接入", "status": "todo"}, {"title": "修改 stats_logger.py 为队列消费日志附加 keep_full_message", "status": "todo"}, {"title": "运行完整 pytest、生成 run.log 与 patch.diff 并复核", "status": "todo"}]}}, {"name": "read_symbol", "args": {"path": "deepinfer/engine/stats_logger.py", "symbol": "StatsLogger"}, "result": {"path": "deepinfer/engine/stats_logger.py", "content": "class StatsLogger:\n    \"\"\"Owns all sliding-window data, timing accumulators and logging state.\n\n    The ``engine`` back-reference is used as follows:\n\n    Read-only:\n      - ``scheduler`` (block counts, preempted/aborted, running/pending/chunked)\n      - ``state_manager`` (state cache usage)\n      - ``num_finished_completion``\n      - ``generate_step`` / ``step_start`` / ``last_step_interval``\n      - ``get_num_pendings()`` / ``build_extra_metrics_log()``\n\n    Mutated (kept on the engine for use by subclasses / other code):\n      - ``finished_payload`` — trimmed to the logging window each log step\n      - ``last_step_time`` — set to ``now`` at the end of every step\n    \"\"\"\n\n    def __init__(\n        self,\n        engine: LLMEngine,\n        *,\n        model_config: ModelConfig,\n        parallel_config: ParallelConfig,\n        cache_config: CacheConfig,\n        engine_type: EngineType,\n        tflops_limit: float,\n    ) -> None:\n        self._engine = engine\n\n        # read-only config refs\n        self._model_config = model_config\n        self._parallel_config = parallel_config\n        self._cache_config = cache_config\n        self._engine_type = engine_type\n        self._tflops_limit = tflops_limit\n\n        # sliding-window data (payload shape noted per window)\n        self._prompt_tokens = Window()  # payload: num_batched_tokens\n        self._generation_tokens = Window()  # payload: (gen_tokens, num_seqs, num_batched_tokens)\n        self._verified_tokens = Window()  # payload: num_verified_tokens | None\n        self._confidence_errors = Window()  # payload: batch_confidence_error\n        self._moe_lb = Window()  # payload: (avg_tokens, max_tokens)\n        self._tflops = Window()  # payload: tflops\n        self._windows = (\n            self._prompt_tokens,\n            self._generation_tokens,\n            self._verified_tokens,\n            self._confidence_errors,\n            self._moe_lb,\n            self._tflops,\n        )\n\n        # timing / counters\n        self._last_logging_time = 0.0\n        self._last_logging_step = -1\n        self._nccl_memory_logger = NCCLMemoryStatsLogger(engine)\n        self._log_queue: queue.SimpleQueue[list[str] | None] = queue.SimpleQueue()\n        self._log_worker_thread = threading.Thread(target=_log_worker, args=(self._log_queue,), daemon=True, name=\"stats_log_worker\")\n        self._log_worker_thread.start()\n        self._prefill_cached_tokens: deque[tuple[int, int]] = deque(maxlen=50)\n\n    # ------------------------------------------------------------------\n    # window aggregation helpers\n    # ------------------------------------------------------------------\n\n    @staticmethod\n    def _throughput(window: Window, now: float, key: Callable[[object], float]) -> tuple[float, int]:\n        \"\"\"(tokens/s, total_tokens) over a window, ignoring the first sample.\"\"\"\n        if len(window) <= 1:\n            return 0.0, 0\n        total = sum(key(p) for _, p, _ in window.entries[1:])\n        # 口径：首条仅作窗口起点（值不计入），分母延伸到 now——含末样本之后的空窗，窗口停更时数值随时间衰减（对比 _mfu）\n        return total / (now - window.entries[0][0]), total\n\n    def _mfu(self, now: float) -> float:\n        entries = self._tflops.entries\n        if len(entries) <= 1:\n            return 0.0\n        # 口径：首条仅作区间起点（值不计入），分母为首尾样本间隔、不延伸到 now（对比 _throughput；_tflops 每步都追加，实际末样本时间戳即 now）\n        tflops_per_s = (sum(v for _, v, _ in entries) - entries[0][1]) / (entries[-1][0] - entries[0][0])\n        return tflops_per_s / self._parallel_config.model_parallel_size / self._tflops_limit\n\n    def _nextn_stats(self, agg: Aggregates) -> None:\n        \"\"\"Fill nextn accept rates / verified-len / confidence error in *agg*.\"\"\"\n        n = envs.DEEPINFER_USE_NEXTN_DECODE + 1\n        accepted = [0] * n\n        for _, (gen, _, _), _ in self._generation_tokens.entries:\n            for i, v in enumerate(gen):\n                accepted[i] += v\n        verified = [0] * n\n        for _, vt, _ in self._verified_tokens.entries:\n            if vt is not None:\n                for i, v in enumerate(vt):\n                    verified[i] += v\n\n        agg.sum_accepted = accepted\n        agg.sum_batched = self._generation_tokens.sum(lambda p: p[1])\n        agg.sum_total = self._generation_tokens.sum(lambda p: p[2])\n        if agg.sum_batched == 0 or n < 2:\n            return\n\n        agg.nextn_rates = [accepted[i] / verified[i] if verified[i] > 0 else 0.0 for i in range(1, n)]\n        agg.nextn_rate = sum(accepted[1:]) / (agg.sum_total - agg.sum_batched + 1e-15)\n        agg.avg_vlen = sum(verified[1:]) / agg.sum_batched\n\n        verified_count = agg.sum_total - agg.sum_batched\n        if verified_count > 0:\n            agg.avg_err = self._confidence_errors.sum(lambda e: e) / verified_count\n\n    def _moe_lb_ratio(self) -> float:\n        if not self._moe_lb:\n            return 1.0  # 无数据时默认完美均衡\n        return self._moe_lb.sum(lambda p: p[1]) / max(1, self._moe_lb.sum(lambda p: p[0]))\n\n    def _finished_payload_stats(self) -> tuple[float, float, float]:\n        \"\"\"(avg_prompt_len, avg_completion_len, payload_len)；payload 元组为 (num_finished, output_len, prompt_len, payload_len)。\"\"\"\n        fp = self._engine.finished_payload\n        num_finished = sum(p[0] for _, p, _ in fp)\n        if num_finished == 0:\n            return 0.0, 0.0, 0.0\n        completion = sum(p[1] for _, p, _ in fp)\n        prompt = sum(p[2] for _, p, _ in fp)\n        payload = sum(p[3] for _, p, _ in fp)\n        return prompt / num_finished, completion / num_finished, (payload / completion if completion > 0 else 0.0)\n\n    @staticmethod\n    def _merge_cuda_timers() -> tuple[dict, dict, dict, dict]:\n        \"\"\"把所有 cuda timer 合并为 (times, called, max_time, latest_times)。\"\"\"\n        times, called, max_time, latest = {}, {}, {}, {}\n        for lbl, tmr in get_timers():\n            if lbl.startswith(\"cuda\"):\n                for n, t in tmr.times.items():\n                    times[n] = times.get(n, 0.0) + t\n                    called[n] = called.get(n, 0) + tmr.called[n]\n                    max_time[n] = max(max_time.get(n, 0.0), tmr.max_time[n])\n                for n, t in tmr.latest_times.items():\n                    latest[n] = latest.get(n, 0.0) + t\n        return times, called, max_time, latest\n\n    # ------------------------------------------------------------------\n    # logging\n    # ------------------------------------------------------------------\n\n    def _build_log_messages(self, s: StepStats, a: Aggregates) -> list[str]:\n        \"\"\"Build log lines.\"\"\"\n        rank = dist.get_rank()\n        gpu_id = self._engine.driver_gpu_id\n        engine_t = cpu_timer.times.get(\"engine_step\", 1e9)\n        lines: list[str] = []\n\n        def _fmt(label: str, times: dict, called: dict, max_t: dict, lat: dict) -> None:\n            items = [\n                f\"{n} cur{1000 * lat.get(n, 0):.1f}ms/mean{1000 * t / called[n]:.1f}ms\"\n                f\"/max{1000 * max_t[n]:.1f}ms/{called[n]}calls/{100 * t / engine_t:.1f}%\"\n                for n, t in sorted(times.items(), key=lambda x: -x[1])\n                if n != \"engine_step\"\n            ]\n            if items:\n                lines.append(f\"RANK {rank}, GPU {gpu_id}, step {self._engine.generate_step}, [{label}] ({' | '.join(items)})\")\n\n        _fmt(\"cpu\", cpu_timer.times, cpu_timer.called, cpu_timer.max_time, cpu_timer.latest_times)\n        cuda_times, cuda_called, cuda_max, cuda_latest = self._merge_cuda_timers()\n        _fmt(\"cuda\", cuda_times, cuda_called, cuda_max, cuda_latest)\n\n        # prefill caching pct\n        total_calc = sum(calc for calc, _ in self._prefill_cached_tokens)\n        gpu_pct = sum(gpu for _, gpu in self._prefill_cached_tokens) / max(1, total_calc)\n\n        items = [\n            f\"is_prompt {s.prompt_run}\",\n            f\"cur_SPS {a.cur_sps:.3f}\",\n            f\"avg_SPS {a.avg_sps:.3f}\",\n            f\"cur_TPS {a.cur_tps:.1f}\",\n            f\"prompt_TPS {a.prompt_tps:.1f}\",\n            f\"completion_TPS {a.gen_tps:.1f}\",\n            f\"avg_nextn_accept_rate {a.nextn_rate * 100:.2f}%\",\n            f\"nextn_accept_rate [{', '.join(f'{r * 100:.2f}%' for r in a.nextn_rates)}]\",\n            f\"verified_tokens {a.sum_total - a.sum_batched}\",\n            f\"accepted_tokens {sum(a.sum_accepted[1:])}\",\n            f\"avg_verified_len {a.avg_vlen:.2f}\",\n            f\"avg_confidence_error {a.avg_err:.4f}\",\n            f\"moe_lb {a.moe_lb:.4f}\",\n        ]\n        items += [\n            f\"running {a.num_runnings}\",\n            f\"pending {a.num_pendings}\",\n            f\"chunked {a.num_chunked}\",\n            f\"num_batched_tokens {s.num_batched_tokens}[{a.batch_pct * 100:.2f}%]\",\n            f\"KV_cache_usage {a.gpu_cache_usage * 100:.2f}%\",\n        ]\n        if self._engine.state_manager is not None:\n            items.append(f\"state_cache_usage {a.gpu_state_usage * 100:.2f}%\")\n        if self._engine_type == EngineType.NORMAL:\n            prefill_t = cpu_timer.times.get(\"engine_step:prefill\", 0.0)\n            decode_t = cpu_timer.times.get(\"engine_step:decode\", 0.0)\n            total_t = prefill_t + decode_t\n            items.append(f\"prefill/decode {100 * safe_divide(prefill_t, total_t):.2f}%/{100 * safe_divide(decode_t, total_t):.2f}%\")\n        items += [\n            f\"prefill_caching_rate (GPU {gpu_pct * 100:.2f}%)\",\n            f\"TTFT (max {a.max_TTFT:.1f} ms, mean {a.mean_TTFT:.1f} ms)\",\n            f\"avg_length (input {a.avg_prompt_len:.1f}, output {a.avg_completion_len:.1f})\",\n            f\"finished {self._engine.num_finished_completion}\",\n            f\"preempted {a.num_preempted}\",\n            f\"aborted {a.num_aborted}\",\n            f\"sum_seqlen_qxk {s.sum_seqlen_qxk}\",\n            f\"max_seqlen_k {s.max_seqlen_k}\",\n            f\"min_seqlen_k {s.min_seqlen_k}\",\n            f\"attn_TFLOPs {s.attn_tflops:.1f}\",\n            f\"MFU {a.mfu:.3f}\",\n        ]\n        msg = f\"RANK {rank}, GPU {gpu_id}, step {self._engine.generate_step}, [stats] ({' | '.join(items)})\"\n        return [msg, *lines]\n\n    def _emit_logs(self, msgs: list[str]) -> None:\n        \"\"\"投递日志到固定 worker 线程，主线程不触碰 logger 的 handler 锁。\"\"\"\n        self._log_queue.put(msgs)\n\n    def close(self) -> None:\n        \"\"\"写完队列中已投递的日志后停掉 worker 线程；重复调用安全。\"\"\"\n        self._log_queue.put(None)\n        self._log_worker_thread.join()\n\n    # ------------------------------------------------------------------\n    # record / aggregate steps\n    # ------------------------------------------------------------------\n\n    def _record(self, s: StepStats, now: float, gen_tokens: list[int]) -> float:\n        \"\"\"Append per-step records and return batch utilization.\"\"\"\n        step = self._engine.generate_step\n\n        if s.prompt_run:\n            self._prompt_tokens.append(now, s.num_batched_tokens, step)\n            batch_pct = s.num_batched_tokens / self._model_config.max_num_batched_tokens\n            calc_tokens = s.num_batched_tokens + s.num_cached_tokens_gpu\n            if calc_tokens > 0:\n                cpu_timer.add_time(\"engine_step:prefill\", now - self._engine.last_step_time)\n                self._prefill_cached_tokens.append((calc_tokens, s.num_cached_tokens_gpu))\n        else:\n            self._generation_tokens.append(now, (gen_tokens, s.num_seqs, s.num_batched_tokens), step)\n            self._verified_tokens.append(now, s.num_verified_tokens, step)\n            self._confidence_errors.append(now, s.batch_confidence_error, step)\n            batch_pct = s.num_batched_tokens / (self._model_config.max_num_seqs * (1 + envs.DEEPINFER_USE_NEXTN_DECODE))\n            if s.num_seqs > 0:\n                cpu_timer.add_time(\"engine_step:decode\", now - self._engine.last_step_time)\n\n        self._tflops.append(now, s.total_tflops, step)\n\n        if s.moe_load_balance_ratio is not None and s.moe_load_balance_ratio[0] > 0:\n            self._moe_lb.append(now, s.moe_load_balance_ratio, step)\n\n        return batch_pct\n\n    def _should_log(self, s: StepStats) -> tuple[bool, int]:\n        \"\"\"Return (should_log, logging_interval).\"\"\"\n        step = self._engine.generate_step\n        interval = envs.DEEPINFER_LOGGING_INTERVAL_STEP\n        if interval <= 0:\n            return False, interval\n        if self._engine_type == EngineType.PROMPT:\n            interval = max(1, interval // 5)\n        should_log = step == 0 or step - self._last_logging_step >= interval\n        return should_log, interval\n\n    def _collect(self, s: StepStats, now: float, gen_tokens: list[int], should_log: bool, a: Aggregates) -> None:\n        \"\"\"Fill window + per-step aggregates into *a*; scheduler/TTFT/payload stats only on logging steps.\"\"\"\n        step = self._engine.generate_step\n        eng = self._engine\n\n        if should_log:\n            a.prompt_tps, a.total_prompt = self._throughput(self._prompt_tokens, now, lambda p: p)\n            a.gen_tps, a.total_gen = self._throughput(self._generation_tokens, now, lambda p: sum(p[0]))\n            a.mfu = self._mfu(now)\n            self._nextn_stats(a)\n            a.moe_lb = self._moe_lb_ratio()\n\n        # per-step (always)\n        step_dur = eng.last_step_interval if (envs.DEEPINFER_ZERO_OVERHEAD_SCHEDULING and step > 0) else now - eng.step_start\n        a.cur_sps = 1 / step_dur\n        a.avg_sps = 0.0 if self._last_logging_time == 0 else (step - self._last_logging_step) / (now - self._last_logging_time)\n        a.cur_tps = sum(gen_tokens) / step_dur\n\n        total_gpu = self._cache_config.num_gpu_blocks - 1\n        a.gpu_cache_usage = (total_gpu - eng.scheduler.get_num_free_gpu_blocks()) / total_gpu\n        if eng.state_manager is not None:\n            total_states = self._cache_config.num_state_seqs - 1\n            a.gpu_state_usage = (total_states - eng.state_manager.get_num_free_blocks()) / total_states\n\n        a.num_pendings = eng.get_num_pendings()\n        a.num_runnings, _ = eng.scheduler.get_sum_prompt_len_running()\n        a.num_chunked, _ = eng.scheduler.get_sum_prompt_len_chunked()\n\n        # expensive stats (only on logging steps)\n        if should_log:\n            a.num_preempted = eng.scheduler.get_num_preempted_seqs()\n            a.num_aborted = eng.scheduler.get_num_aborted_seqs()\n            a.max_TTFT = max(s.first_token_latencies, default=0)\n            a.mean_TTFT = statistics.mean(s.first_token_latencies) if len(s.first_token_latencies) > 0 else 0\n            a.avg_prompt_len, a.avg_completion_len, a.payload_len = self._finished_payload_stats()\n\n    # ------------------------------------------------------------------\n    # main entry point\n    # ------------------------------------------------------------------\n\n    def log_nccl_memory(self) -> None:\n        msg = self._nccl_memory_logger.step()\n        if msg:\n            self._emit_logs([msg])\n\n    @cpu_timer.record(\"log_stats\")\n    def log_step(self, s: StepStats) -> None:\n        \"\"\"Collect per-step stats; periodically log.\n\n        NOTE 假设这里面的操作是无副作用的，即在 should_log=False 时不调用也不影响正确性。\n        \"\"\"\n        now = time.perf_counter()\n        eng = self._engine\n        gen_tokens = s.num_generated_tokens if s.num_generated_tokens is not None else [s.num_batched_tokens]\n\n        # 1. record raw per-step data\n        a = Aggregates()\n        a.batch_pct = self._record(s, now, gen_tokens)\n\n        # 2. decide whether to log, then trim + aggregate\n        should_log, interval = self._should_log(s)\n        if should_log or interval <= 0:\n            base_age = max(0, interval)\n            for w in self._windows:\n                max_age = max(base_age, envs.DEEPINFER_MOE_LB_STAT_INTERVAL) if w is self._moe_lb else base_age\n                w.trim(eng.generate_step, max_age)\n            eng.finished_payload = [e for e in eng.finished_payload if eng.generate_step - e[2] <= base_age]\n        self._collect(s, now, gen_tokens, should_log, a)\n\n        # 3. log\n        if should_log:\n            msgs = self._build_log_messages(s, a)\n            extra = eng.build_extra_metrics_log()\n            if extra is not None:\n                msgs.append(extra)\n            self._emit_logs(msgs)\n\n        # 4. reset timers + bookkeeping\n        if should_log or interval <= 0:\n            for _, timer in get_timers():\n                timer.clear()\n            self._last_logging_time = now\n            self._last_logging_step = eng.generate_step\n        eng.last_step_time = now\n        for _, timer in get_timers():\n            timer.clear_latest()\n", "file_hash": "9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9", "start_line": 129, "end_line": 477, "evidence_ids": ["ev-000004"]}}, {"name": "list_files", "args": {"path": "deepinfer", "limit": 50}, "result": {"files": ["deepinfer/_C/__init__.pyi", "deepinfer/_C/cuda_utils.pyi", "deepinfer/_C/engine.pyi", "deepinfer/_C/graph_timer.pyi", "deepinfer/__init__.py", "deepinfer/attrdict.py", "deepinfer/config.py", "deepinfer/distributed/__init__.py", "deepinfer/distributed/shm_broadcast.py", "deepinfer/engine/__init__.py", "deepinfer/engine/arg_utils.py", "deepinfer/engine/engine_type.py", "deepinfer/engine/llm_engine.py", "deepinfer/engine/profile_server.py", "deepinfer/engine/stats_logger.py", "deepinfer/entrypoints/__init__.py", "deepinfer/entrypoints/llm.py", "deepinfer/environ.py", "deepinfer/hugging_face/__init__.py", "deepinfer/hugging_face/config.py", "deepinfer/hugging_face/loading.py", "deepinfer/hugging_face/names.py", "deepinfer/hugging_face/parameters.py", "deepinfer/hugging_face/processor.py", "deepinfer/hugging_face/tokenizer.py", "deepinfer/hugging_face/weights.py", "deepinfer/load_class.py", "deepinfer/logger.py", "deepinfer/model_config_loader.py", "deepinfer/model_executor/__init__.py", "deepinfer/model_executor/eplb/__init__.py", "deepinfer/model_executor/eplb/policy.py", "deepinfer/model_executor/eplb/shuffle.py", "deepinfer/model_executor/input_metadata/__init__.py", "deepinfer/model_executor/input_metadata/dflash.py", "deepinfer/model_executor/input_metadata/input_metadata.py", "deepinfer/model_executor/input_metadata/prepare_tensor_input_zos.py", "deepinfer/model_executor/input_metadata/yoco.py", "deepinfer/model_executor/layer_utils.py", "deepinfer/model_executor/layers/__init__.py", "deepinfer/model_executor/layers/attention_backend.py", "deepinfer/model_executor/layers/layernorm.py", "deepinfer/model_executor/layers/linear.py", "deepinfer/model_executor/layers/mtp_info_pool.py", "deepinfer/model_executor/layers/rotary_embedding.py", "deepinfer/model_executor/layers/sampler.py", "deepinfer/model_executor/layers/sampler_utils.py", "deepinfer/model_executor/layers/tilelang_ops/__init__.py", "deepinfer/model_executor/layers/tilelang_ops/asc/__init__.py", "deepinfer/model_executor/layers/tilelang_ops/asc/candidate_blocks.py"], "offset": 0, "limit": 50}}], "namespace": [{"name": "items", "type": "list", "size": 6, "stale": false}], "sources": {"items": []}}
