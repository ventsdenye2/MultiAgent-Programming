tool", "type": "str", "size": 11, "stale": false}, {"name": "r", "type": "dict", "size": 4, "stale": false}, {"name": "r1", "type": "dict", "size": 4, "stale": false}, {"name": "read_logger", "type": "dict", "size": 4, "stale": false}, {"name": "s", "type": "dict", "size": 1, "stale": false}, {"name": "s1", "type": "dict", "size": 1, "stale": false}, {"name": "search_stats_log", "type": "dict", "size": 1, "stale": false}, {"name": "search_stats_queue", "type": "dict", "size": 1, "stale": false}], "sources": {"items": [], "r1": [{"path": "deepinfer/environ.py", "file_hash": "fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218"}], "plan_tool": [], "read_logger": [{"path": "deepinfer/logger.py", "file_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8"}], "search_stats_log": [], "search_stats_queue": [], "baseline": [], "log_content": [{"path": "deepinfer/logger.py", "file_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8"}], "log_hash": [{"path": "deepinfer/logger.py", "file_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8"}], "env": [{"path": "deepinfer/environ.py", "file_hash": "fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218"}], "s": [], "m": [], "r": [{"path": "deepinfer/engine/stats_logger.py", "file_hash": "9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9"}], "s1": [], "a": [{"path": "deepinfer/engine/stats_logger.py", "file_hash": "9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9"}], "h": [], "old_factory": [], "new_factory": []}}
