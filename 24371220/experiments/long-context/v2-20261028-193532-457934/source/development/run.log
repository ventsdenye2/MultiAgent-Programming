ger.py", "file_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8"}], "log_hash": [{"path": "deepinfer/logger.py", "file_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8"}], "env": [{"path": "deepinfer/environ.py", "file_hash": "fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218"}], "s": [], "m": [], "r": [{"path": "deepinfer/engine/stats_logger.py", "file_hash": "9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9"}], "s1": [], "a": [{"path": "deepinfer/engine/stats_logger.py", "file_hash": "9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9"}], "h": [], "old_factory": [], "new_factory": [], "lg": [{"path": "deepinfer/logger.py", "file_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8"}]}}
