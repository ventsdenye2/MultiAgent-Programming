 "pdf", "status": "valid"}, {"id": "ev-000052", "path": "paper.pdf", "kind": "pdf", "status": "valid"}, {"id": "ev-000046", "path": "paper.pdf", "kind": "pdf", "status": "valid"}, {"id": "ev-000007", "path": "report.json", "kind": "file", "status": "valid"}, {"id": "ev-000001", "path": "report.json", "kind": "file", "status": "valid"}]}
