launch 期的 CPU-GPU 同步检查）\"\n    DEEPINFER_PROFILE_TORCH_CUDA_MEMORY = EnvVar.str_or_none()\n    DEEPINFER_ENABLE_MEMORY_TRACING = EnvVar.bool()\n    DEEPINFER_PROFILE_HTTP_ENABLE = EnvVar.bool()\n    DEEPINFER_PROFILE_HTTP_PORT_BASE = EnvVar.int(default=6070)\n    DEEPINFER_TORCH_PROFILER_DIR = EnvVar.str(default=\"/tmp\")\n\n    # -- Multi-Modal --\n    DEEPINFER_USE_MULTIMODAL_POOL = EnvVar.bool()\n    DEEPINFER_MULTIMODAL_POOL_SIZE_GB = EnvVar.int(default=8)\n    DEEPINFER_MULTI_MODAL_BUFFER_SIZE = EnvVar.int(default=512)\n    DEEPINFER_MULTI_MODAL_WORKER_TIMEOUT = EnvVar.float(default=1800.0)\n\n\ndef rearm(name: str) -> None:\n    \"\"\"Rearm specific descriptor, will resolve again on next access.\"\"\"\n    setattr(envs, name, _descriptors[name])\n\n\ndef rearm_all() -> None:\n    \"\"\"Rearm all descriptors.\"\"\"\n    for name, descriptor in _descriptors.items():\n        setattr(envs, name, descriptor)\n", "path": "deepinfer/environ.py", "file_hash": "fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218", "kind": "file", "start_line": null, "end_line": null, "page": null, "status": "valid", "seen_requests": ["request-0010"], "successful_requests": ["request-0010"], "step_id": 9, "sources": []}}], "namespace": [{"name": "e", "type": "dict", "size": 13, "stale": false}, {"name": "r", "type": "dict", "size": 13, "stale": false}, {"name": "r1", "type": "dict", "size": 4, "stale": false}, {"name": "r2", "type": "dict", "size": 6, "stale": false}, {"name": "res", "type": "dict", "size": 1, "stale": false}], "sources": {"res": [], "r1": [{"path": "deepinfer/environ.py", "file_hash": "fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218"}], "e": [{"path": "deepinfer/environ.py", "file_hash": "fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218"}], "r": [{"path": "deepinfer/environ.py", "file_hash": "fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218"}], "r2": [{"path": "deepinfer/engine/stats_logger.py", "file_hash"