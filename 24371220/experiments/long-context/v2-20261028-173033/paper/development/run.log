{"event": "context_selection", "time": 1793180459.468219, "run_id": "0fa265f013f243909b85a05f186bb159", "seq": 195, "mode": "evidence", "phase": "explore", "focus_paths": ["test_report.py"], "selected": ["unseen:ev-000035", "reuse:ev-000039", "reuse:ev-000038", "reuse:ev-000037", "reuse:ev-000034", "reuse:ev-000024", "reuse:ev-000002", "history:17"], "discarded": ["reuse:ev-000036", "reuse:ev-000033", "reuse:ev-000032", "reuse:ev-000031", "reuse:ev-000030", "reuse:ev-000029", "reuse:ev-000028", "reuse:ev-000027", "reuse:ev-000026", "reuse:ev-000025", "reuse:ev-000023", "reuse:ev-000022", "reuse:ev-000021", "reuse:ev-000020", "reuse:ev-000019", "reuse:ev-000018", "reuse:ev-000017", "reuse:ev-000016", "reuse:ev-000015", "reuse:ev-000014", "reuse:ev-000013", "reuse:ev-000012", "reuse:ev-000011", "reuse:ev-000010", "reuse:ev-000008", "reuse:ev-000007", "reuse:ev-000006", "reuse:ev-000005", "reuse:ev-000009", "reuse:ev-000004", "reuse:ev-000003", "reuse:ev-000001", "history:19", "history:18", "history:16", "history:15", "history:14", "history:13", "history:12", "history:11", "history:10", "history:9", "history:8", "history:7", "history:6", "history:5", "history:4", "history:3", "history:2", "history:1"], "chars": 29857, "manifest": [{"id": "ev-000035", "path": "paper.pdf", "kind": "pdf", "status": "valid"}, {"id": "ev-000039", "path": "paper.pdf", "kind": "pdf", "status": "valid"}, {"id": "ev-000038", "path": "paper.pdf", "kind": "pdf", "status": "valid"}, {"id": "ev-000037", "path": "paper.pdf", "kind": "pdf", "status": "valid"}, {"id": "ev-000034", "path": "paper.pdf", "kind": "pdf", "status": "valid"}, {"id": "ev-000024", "path": "paper.pdf", "kind": "pdf", "status": "valid"}, {"id": "ev-000002", "path": "report.json", "kind": "file", "status": "valid"}]}
