119:     DEEPINFER_MOE_LB_STAT_INTERVAL = EnvVar.int(default=128)\n120:     DEEPINFER_FORCE_IMBALANCE_RATIO = EnvVar.float()\n121:     DEEPINFER_FORCE_LOAD_BALANCE = EnvVar.bool()\n122:     DEEPINFER_SHOW_EPLB_DETAIL = EnvVar.bool()\n123: \n124:     # -- Attention --\n125:     DEEPINFER_PREFILL_MAX_SUM_SEQLEN_K = EnvVar.int_or_none()\n126:     \"未设置表示不限制 sum-K；传给 C++ Scheduler 时以 DEFAULT_PREFILL_MAX_SUM_SEQLEN_K 作为等效不限制的封顶值。\"\n127:     DEEPINFER_INDEX_ATTN_MEMORY_LIMIT = EnvVar.int(default=10 * 2**30)\n128: \n129:     # -- MTP --\n130:     DEEPINFER_USE_NEXTN_DECODE = EnvVar.int(default=5)\n131:     \"最大支持投机几个；默认 5，显式设为 0 可关闭投机解码\"\n132:     DEEPINFER_ENABLE_MTP_VARLEN = EnvVar.bool()\n133:     DEEPINFER_MAX_BACKTRACKING_TOKENS = EnvVar(lambda v: max(_int(v), envs.DEEPINFER_USE_NEXTN_DECODE + 1))\n134: \n135:     @EnvVar\n136:     def DEEPINFER_DFLASH_CONFIDENCE_HEAD_TEMPERATURE(v: str | None) -> float | tuple[float, ...]:\n137:         raw = v if v is not None else \"1.0\"\n138:         if \",\" in raw:\n139:             parts = [float(x.strip()) for x in raw.split(\",\")]\n140:             nextn = envs.DEEPINFER_USE_NEXTN_DECODE\n141:             if len(parts) != nextn:\n142:                 raise ValueError(f\"has {len(parts)} elements ('{raw}') but DEEPINFER_USE_NEXTN_DECODE={nextn}\")\n143:             return tuple(parts)\n144:         return float(raw)\n145: \n146:     # -- Model Loading --\n147:     DEEPINFER_ENGRAM_PAD_TOKEN = EnvVar.int(default=2)\n148:     DEEPINFER_ENGRAM_FORCE_GPU_STORAGE = EnvVar(lambda v: _bool(v) or envs.DEEPINFER_ACCELERATOR == \"ascend\")\n149: \n150:     # -- Sampling --\n151:     DEEPINFER_SAMPLER_FORCE_TOPK = EnvVar.int()\n152:     DEEPINFER_DECODE_TOKEN_BLACKLIST = EnvVar.str()\n153: \n154:     # -- CUDA Graph --\n155:     DEEPINFER_ENFORCE_EAGER = EnvVar.bool()\n156:     DEEPINFER_CUDAGRAPH_BATCH_SIZE_INTERVAL = EnvVar.int(default=8)\n157:     DEEPINFER_DFLASH_ENFORCE_EAGER = EnvVar.bool()\n158:     DEEPINFER_DFLASH_CUDAGRAPH_BATCH_SIZE_INTERVAL = EnvVar.int(default=8)\n159:     DEEPINFER_DECODE_PERF_CACHE_DIR = EnvVar.str_or_none()\n160:     DEEPINFER_DECODE_PERF_CACHE_TTL_SEC = EnvVar.int(default=60 * 60)\n161: \n162:     # -- KV Cache Store --\n163:     DEEPINFER_NUM_STATE_SLOTS_RATIO = EnvVar.float(default=1.2)\n164:     DEEPINFER_PREFILL_STORE_EXTRA_STATE = EnvVar.bool()\n165:     DEEPINFER_PREFILL_STORE_EXTRA_SIZE = EnvVar.int(default=128)\n166: \n167:     # -- Structured Output --\n168:     DEEPINFER_XGRAMMAR_DEBUG = EnvVar.bool()\n169:     DEEPINFER_XGRAMMAR_TIMEOUT = EnvVar.int(default=20)\n170:     DEEPINFER_XGRAMMAR_DISABLE_CACHE = EnvVar.bool(default=False)\n171:     DEEPINFER_XGRAMMAR_CACHE_LIMIT_BYTES = EnvVar.int(default=10 * 1024 * 1024 * 1024)\n172:     DEEPINFER_SO_BUILDER_CPUS = EnvVar.int(default=4)\n173: \n174:     # -- Scheduling --\n175:     DEEPINFER_PREFILL_ATTEMPT_INTERVAL = EnvVar.int(default=70)\n176:     \"\"\"NORMAL 引擎 prefill 尝试间隔（ALL 点：全员有活才做，逻辑见 scheduler.hpp _schedule）。\n177:     各 rank 在集体 prefill 前累积待处理的 prompt。\"\"\"\n178:     DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL = EnvVar.int(default=100)\n179:     \"ANY 保底间隔：任一 rank 有活就集体 prefill，孤立 rank 最多等这么多个 decode step\"\n180:     DEEPINFER_ZERO_OVERHEAD_SCHEDULING = EnvVar.bool()\n181: \n182:     # -- Logging --\n183:     DEEPINFER_LOGGING_INTERVAL_STEP = EnvVar.int(default=100)\n184:     DEEPINFER_NCCL_MEMORY_SAMPLE_INTERVAL_STEPS = EnvVar.int(default=1000)\n185:     DEEPINFER_RINGBUFFER_WARNING_INTERVAL = EnvVar.int(default=60)\n186:     DEEPINFER_GC_INTERVAL_STEP = EnvVar.int(default=1000)\n187: \n188:     # -- YoCo --\n189:     DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE = EnvVar.choice(default=\"off\", choices=(\"off\", \"mask\", \"compact\"))\n190:     \"\"\"YoCo consumer prefill 截断模式：off 表示关闭；mask 保留全部 query，仅收窄 SWA\n191:     可见域；compact 真正移除截断区 query，以减少 consumer 层计算。\"\"\"\n192:     DEEPINFER_YOCO_PREFILL_KEEP_TOKENS = EnvVar.int()\n193:     \"\"\"YoCo consumer prefill 截断开启时保留的末尾 query token 数。mask 与 compact 的\n194:     SWA 可见域均为原始滑窗和末尾 KEEP_TOKENS 矩形的交集。必须满足 KEEP_TOKENS >=\n195:     window_size + DEEPINFER_MAX_BACKTRACKING_TOKENS；默认 0，启用截断时必须显式设置。\"\"\"\n196: \n197:     # -- Profiling & Debug --\n198:     DEEPINFER_BATCH_INVARIANT = EnvVar.bool()\n199:     DEEPINFER_DISABLE_SYNC_GUARD = EnvVar.bool()\n200:     \"debug 用：关闭 forbid_cuda_sync 守卫（model forward/sampling launch 期的 CPU-GPU 同步检查）\"\n201:     DEEPINFER_PROFILE_TORCH_CUDA_MEMORY = EnvVar.str_or_none()\n202:     DEEPINFER_ENABLE_MEMORY_TRACING = EnvVar.bool()\n203:     DEEPINFER_PROFILE_HTTP_ENABLE = EnvVar.bool()\n204:     DEEPINFER_PROFILE_HTTP_PORT_BASE = EnvVar.int(default=6070)\n205:     DEEPINFER_TORCH_PROFILER_DIR = EnvVar.str(default=\"/tmp\")\n206: \n207:     # -- Multi-Modal --\n208:     DEEPINFER_USE_MULTIMODAL_POOL = EnvVar.bool()\n209:     DEEPINFER_MULTIMODAL_POOL_SIZE_GB = EnvVar.int(default=8)\n210:     DEEPINFER_MULTI_MODAL_BUFFER_SIZE = EnvVar.int(default=512)\n211:     DEEPINFER_MULTI_MODAL_WORKER_TIMEOUT = EnvVar.float(default=1800.0)\n212: \n213: \n214: def rearm(name: str) -> None:\n215:     \"\"\"Rearm specific descriptor, will resolve again on next access.\"\"\"\n216:     setattr(envs, name, _descriptors[name])\n217: \n218: \n219: def rearm_all() -> None:\n220:     \"\"\"Rearm all descriptors.\"\"\"\n221:     for name, descriptor in _descriptors.items():\n222:         setattr(envs, name, descriptor)\nLast output from code snippet:\nNone", "observations_images": null, "action_output": null, "token_usage": {"input_tokens": 5386, "output_tokens": 224, "total_tokens": 5610}, "is_final_answer": false}}
