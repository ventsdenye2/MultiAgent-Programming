33[1;31m\",  # bold red\n}\n_COLOR_RESET = \"\\033[0m\"\n\n\n\nEvidence ev-ddb5be78a5cf6218d616 | deepinfer/engine/stats_logger.py | lines:116-126 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\ndef _log_worker(q: queue.SimpleQueue[list[str] | None]) -> None:\n    need_sleep = True\n    for msgs in iter(q.get, None):\n        try:\n            if need_sleep:\n                time.sleep((dist.get_rank() % 8) * 0.005)\n            for m in msgs:\n                logger.info(m)\n            need_sleep = q.empty()  # we skip sleep when q has backlog\n        except Exception:\n            traceback.print_exc()\nEvidence ev-c8859274b7c70879ff16 | deepinfer/engine/stats_logger.py | lines:342-344 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\ndef _emit_logs(self, msgs: list[str]) -> None:\n        \"\"\"投递日志到固定 worker 线程，主线程不触碰 logger 的 handler 锁。\"\"\"\n        self._log_queue.put(msgs)\nEvidence ev-5a3c8c1ca1246b61b813 | deepinfer/engine/stats_logger.py | lines:20-20 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\nfrom deepinfer.logger import init_logger\nEvidence ev-5abfdabfb975754c6683 | deepinfer/engine/stats_logger.py | lines:29-29 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\nlogger = init_logger(__name__)"}]}], "model": "deepseek-flash", "max_tokens": 16384, "reasoning_effort": "high", "response_format": {"type": "json_object"}, "stop": ["Observation:", "Calling tools:"], "thinking": {"type": "enabled"}}, "chars": 21361, "content_chars": 20191, "course_content_chars": 21062}
