 setattr(envs, name, _descriptors[name])\n\n\ndef rearm_all() -> None:\n    \"\"\"Rearm all descriptors.\"\"\"\n    for name, descriptor in _descriptors.items():\n        setattr(envs, name, descriptor)\n", "file_hash": "fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218", "start_line": 180, "end_line": 221, "evidence_ids": ["ev-ce7f3452865c2cce8902"], "delivery": "Originals queued for the next model request; large batches may span requests."}}
