ars': 3680, 'exposed': True}, {'id': 'ev-76027d4e758f97793930', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:39', 'required': True, 'page': 39, 'valid': True, 'atomic': True, 'chars': 3745, 'exposed': True}, {'id': 'ev-2bcb169328f17ac85c9d', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:40', 'required': True, 'page': 40, 'valid': True, 'atomic': True, 'chars': 1952, 'exposed': True}, {'id': 'ev-a67fb4f311d1f21c4aba', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:41', 'required': True, 'page': 41, 'valid': True, 'atomic': True, 'chars': 2382, 'exposed': True}, {'id': 'ev-baddfbae8db75139dd16', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:42', 'required': True, 'page': 42, 'valid': True, 'atomic': True, 'chars': 380, 'exposed': True}, {'id': 'ev-94c9aed99ffbcdf31b43', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:43', 'required': True, 'page': 43, 'valid': True, 'atomic': True, 'chars': 3742, 'exposed': True}, {'id': 'ev-bc885ff165a165a4d614', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:44', 'required': True, 'page': 44, 'valid': True, 'atomic': True, 'chars': 2323, 'exposed': False}, {'id': 'ev-fdbf1c532c2133190b0f', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:45', 'required': True, 'page': 45, 'valid': True, 'atomic': True, 'chars': 4456, 'exposed': False}, {'id': 'ev-75546d247dedb90561b5', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:46', 'required': True, 'page': 46, 'valid': True, 'atomic': True, 'chars': 4646, 'exposed': False}, {'id': 'ev-f03e4b7f1b7fc6e66886', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:47', 'required': True, 'page': 47, 'valid': True, 'atomic': True, 'chars': 5018, 'exposed': False}, {'id': 'ev-aa9b9dbdfec8c640b495', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:48', 'required': True, 'page': 48, 'valid': True, 'atomic': True, 'chars': 4375, 'exposed': False}, {'id': 'ev-6e64db9ec6bfa8f9417f', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:49', 'required': True, 'page': 49, 'valid': True, 'atomic': True, 'chars': 4295, 'exposed': False}, {'id': 'ev-42cada09d7411017eb46', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:50', 'required': True, 'page': 50, 'valid': True, 'atomic': True, 'chars': 4663, 'exposed': False}, {'id': 'ev-99f0f0a37d328bfed1a9', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:51', 'required': True, 'page': 51, 'valid': True, 'atomic': True, 'chars': 3844, 'exposed': False}, {'id': 'ev-01ce8948bcc88d235ea3', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:52', 'required': True, 'page': 52, 'valid': True, 'atomic': True, 'chars': 4072, 'exposed': False}], 'notes': {'overview': {'id': 'overview', 'content': '论文把 agentic LLM 定义为接收自然语言输入、推理决策并自主行动以达成目标的 agent，据此分三章：reasoning、acting/assistant、interacting/multi-agent（p.4-5）。三类能力构成良性循环：推理技术服务行动，交互产生的新数据回流用于微调（p.4）。文献选择：先用 Google Scholar 检索 Agentic LLM，再用 snowballing 扩展被引但未收录的工作，只选基于 LLM 的方法（p.5）。', 'sources': ['paper.pdf'], 'evidence_ids': ['ev-26c94297c50e4ef408a2', 'ev-dbca06e364385e22f3c5'], 'valid': True, 'request': 5}, 'reasoning': {'id': 'reasoning', 'content': '推理技术三支：CoT为贪心单路径；Self-Consistency采样多路径并取最一致答案（多数投票，p.10）；Tree of Thoughts以外部搜索算法遍历推理树并回溯，论文介绍breadth-first与depth-first两种控制器（p.12-13）。改进循环有PHP、Self Refine、Reflexion、Self Discover（p.14-15）；外部搜索需外部记忆，也可内化到模型（RASP、DeepSeek-R1、RLVR）（p.15-17）。此外还有检索增强RAG，可在推理时决定何时检索（p.17）。', 'sources': ['paper.pdf'], 'evidence_ids': ['ev-2c5302116a7f6c84effa', 'ev-b8db09947ef7c899cd9d', 'ev-ced75d6936911b2f0248', 'ev-9317b06df60c30a6c12c'], 'valid': True, 'request': 9}, 'tool_use': {'id': 'tool_use', 'content': 'Acting部分：世界模型与VLA把推理落到机器人动作；工具调用把API当作要学的语言。Toolformer自学何时调用哪个API、传什么参数、如何融合结果，测试calculator、question_answering、search_engine、translation_system、calendar五种工具（p.23）。ToolBench含16,464个RapidAPI；ToolAlpaca 3938实例/400 API；Gorilla用微调LLaMa生成API调用（p.23）。规划器-调用器-摘要器分工的多LLM架构见图13（p.23）。', 'sources': ['paper.pdf'], 'evidence_ids': ['ev-731fa63b8d34dde45e62'], 'valid': True, 'request': 11}, 'multi_agent': {'id': 'multi_agent', 'content': '多智能体部分区分角色协作与开放社会模拟。CAMEL 用 inception prompting 让角色保持身份并合作；Generative Agents 模拟 25 个有独特人设与记忆的 agent，记录经历并生成反思和计划；AgentSociety 超过一万 agent；AgentVerse 分专家招募、协作决策、行动执行、评估四阶段；OASIS 可扩展到百万 agent。规范研究包括命名游戏、metanorm 与文化社会意识基准 CASA，显示局部互动可涌现全局规范，但可能出现集体偏见。', 'sources': ['paper.pdf'], 'evidence_ids': ['ev-76027d4e758f97793930', 'ev-2bcb169328f17ac85c9d', 'ev-a67fb4f311d1f21c4aba', 'ev-baddfbae8db75139dd16', 'ev-94c9aed99ffbcdf31b43'], 'valid': True, 'request': 17}}, 'answers': {'overview': {'categories': {'answer': ['reason', 'act', 'interact'], 'evidence_id': 'ev-03c9580cc4ea3469a3d3', 'page': 1, 'quote': 'Agentic LLMs are LLMs that (1) reason, (2) act, and (3) interact. We organize the literature according to these three categories.'}, 'search_methods': {'answer': ['google_scholar', 'snowballing'], 'evidence_id': 'ev-dbca06e364385e22f3c5', 'page': 5, 'quote': 'The papers were initially selected with a Google Scholar search on Agentic LLM. From there, we used a snowballing approach to discover work that was cited but not yet included in our initial set.'}}, 'reasoning': {'self_consistency_selection': {'answer': 'majority voting', 'evidence_id': 'ev-d2b420a2b23cdc8166d3', 'page': 10, 'quote': 'Self Consistency is an ensemble approach that samples diverse reasoning paths, evaluates them, and selects the most consistent answer using majority voting.'}, 'tot_search': {'answer': ['breadth_first', 'depth_first'], 'evidence_id': 'ev-4049593a30e2846f8394', 'page': 13, 'quote': 'The paper describes both a breadth-first and a depth-first controller.'}}, 'tool_use': {'toolbench_api_count': {'answer': 16464, 'evidence_id': 'ev-731fa63b8d34dde45e62', 'page': 23, 'quote': 'ToolBench [Qin et al., 2023] contains 16,464 APIs from RapidAPI, a large dataset of publicly available REST APIs.'}, 'toolformer_tools': {'answer': ['calculator', 'question_answering', 'search_engine', 'translation_system', 'calendar'], 'evidence_id': 'ev-731fa63b8d34dde45e62', 'page': 23, 'quote': 'A range of tools is tested: a calculator, a question-answering system, a search engine, a translation system, and a calendar.'}}, 'multi_agent': {'camel_prompting': {'answer': 'inception_prompting', 'evidence_id': 'ev-98a30db9253fff6cc9da', 'page': 37, 'quote': 'By using inception prompting and role descriptions, the agents stay in character and collaborate toward the goal'}}}, 'section_text': {}}\nLast output from code snippet:\nNone", "observations_images": null, "action_output": null, "token_usage": {"input_tokens": 9088, "output_tokens": 633, "total_tokens": 9721}, "is_final_answer": false}}
