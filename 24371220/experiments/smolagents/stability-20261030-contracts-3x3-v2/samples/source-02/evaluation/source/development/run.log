{"event": "context_selection", "time": 1793350315.7374084, "run_id": "92a57d598fbf4f84877057182cf4e489", "seq": 257, "evidence_ids": ["ev-2735675841e732e983d4", "ev-a89f3e55c554b7975cee", "ev-cf02850b2a4cc8d098c8", "ev-f90ae6d59118f6e559cd", "ev-2611a72b5057128d5bb6", "ev-56d5d7468a09a80be426", "ev-a5c15ce031ba27998b72", "ev-b031308ddaf8173de323", "ev-7ca79e548931a3e70ef5", "ev-ee0ff7bddd3ea8e23cc7"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-2735675841e732e983d4", 0, 139], ["ev-a89f3e55c554b7975cee", 0, 443], ["ev-cf02850b2a4cc8d098c8", 0, 30], ["ev-f90ae6d59118f6e559cd", 0, 40], ["ev-2611a72b5057128d5bb6", 0, 598], ["ev-56d5d7468a09a80be426", 0, 521], ["ev-a5c15ce031ba27998b72", 0, 2050], ["ev-b031308ddaf8173de323", 0, 2136], ["ev-7ca79e548931a3e70ef5", 0, 1707], ["ev-ee0ff7bddd3ea8e23cc7", 0, 3476]], "estimated_body_chars": 30391, "course_content_chars": 30133, "budget_parts": {"fixed": 12545, "minimum_frame": 16965, "payload_text": 12674}, "reason": "reserve required evidence before expanding recent feedback"}
