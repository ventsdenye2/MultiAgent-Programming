ault=128)\n165: \n166:     # -- Structured Output --\n167:     DEEPINFER_XGRAMMAR_DEBUG = EnvVar.bool()\n168:     DEEPINFER_XGRAMMAR_TIMEOUT = EnvVar.int(default=20)\n169:     DEEPINFER_XGRAMMAR_DISABLE_CACHE = EnvVar.bool(default=False)\n170:     DEEPINFER_XGRAMMAR_CACHE_LIMIT_BYTES = EnvVar.int(default=10 * 1024 * 1024 * 1024)\n171:     DEEPINFER_SO_BUILDER_CPUS = EnvVar.int(default=4)\n172: \n173:     # -- Scheduling --\n174:     DEEPINFER_PREFILL_ATTEMPT_INTERVAL = EnvVar.int(default=70)\n175:     \"\"\"NORMAL 引擎 prefill 尝试间隔（ALL 点：全员有活才做，逻辑见 scheduler.hpp _schedule）。\n176:     各 rank 在集体 prefill 前累积待处理的 prompt。\"\"\"\n177:     DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL = EnvVar.int(default=100)\n178:     \"ANY 保底间隔：任一 rank 有活就集体 prefill，孤立 rank 最多等这么多个 decode step\"\n179:     DEEPINFER_ZERO_OVERHEAD_SCHEDULING = EnvVar.bool()\n180: \n181:     # -- Logging --\n182:     DEEPINFER_LOGGING_INTERVAL_STEP = EnvVar.int(default=100)\n183:     DEEPINFER_NCCL_MEMORY_SAMPLE_INTERVAL_STEPS = EnvVar.int(default=1000)\n184:     DEEPINFER_RINGBUFFER_WARNING_INTERVAL = EnvVar.int(default=60)\n185:     DEEPINFER_GC_INTERVAL_STEP = EnvVar.int(default=1000)\n186: \n187:     # -- YoCo --\n188:     DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE = EnvVar.choice(default=\"off\", choices=(\"off\", \"mask\", \"compact\"))\n189:     \"\"\"YoCo consumer prefill 截断模式：off 表示关闭；mask 保留全部 query，仅收窄 SWA\n190:     可见域；compact 真正移除截断区 query，以减少 consumer 层计算。\"\"\"\n191:     DEEPINFER_YOCO_PREFILL_KEEP_TOKENS = EnvVar.int()\n192:     \"\"\"YoCo consumer prefill 截断开启时保留的末尾 query token 数。mask 与 compact 的\n193:     SWA 可见域均为原始滑窗和末尾 KEEP_TOKENS 矩形的交集。必须满足 KEEP_TOKENS >=\n194:     window_size + DEEPINFER_MAX_BACKTRACKING_TOKENS；默认 0，启用截断时必须显式设置。\"\"\"\n195: \n196:     # -- Profiling & Debug --\n197:     DEEPINFER_BATCH_INVARIANT = EnvVar.bool()\n198:     DEEPINFER_DISABLE_SYNC_GUARD = EnvVar.bool()\n199:     \"debug 用：关闭 forbid_cuda_sync 守卫（model forward/sampling launch 期的 CPU-GPU 同步检查）\"\n200:     DEEPINFER_PROFILE_TORCH_CUDA_MEMORY = EnvVar.str_or_none()\n201:     DEEPINFER_ENABLE_MEMORY_TRACING = EnvVar.bool()\n202:     DEEPINFER_PROFILE_HTTP_ENABLE = EnvVar.bool()\n203:     DEEPINFER_PROFILE_HTTP_PORT_BASE = EnvVar.int(default=6070)\n204:     DEEPINFER_TORCH_PROFILER_DIR = EnvVar.str(default=\"/tmp\")\n205: \n206:     # -- Multi-Modal --\n207:     DEEPINFER_USE_MULTIMODAL_POOL = EnvVar.bool()\n208:     DEEPINFER_MULTIMODAL_POOL_SIZE_GB = EnvVar.int(default=8)\n209:     DEEPINFER_MULTI_MODAL_BUFFER_SIZE = EnvVar.int(default=512)\n210:     DEEPINFER_MULTI_MODAL_WORKER_TIMEOUT = EnvVar.float(default=1800.0)\n211: \n212: \n213: def rearm(name: str) -> None:\n214:     \"\"\"Rearm specific descriptor, will resolve again on next access.\"\"\"\n215:     setattr(envs, name, _descriptors[name])\n216: \n217: \n218: def rearm_all() -> None:\n219:     \"\"\"Rearm all descriptors.\"\"\"\n220:     for name, descriptor in _descriptors.items():\n221:         setattr(envs, name, descriptor)\n1: # SPDX-License-Identifier: Apache-2.0\n2: # Derived from vLLM; modified by DeepSeek.\n3: \n4: # Adapted from\n5: # https://github.com/skypilot-org/skypilot/blob/86dc0f6283a335e4aa37b3c10716f90999f48ab6/sky/sky_logging.py\n6: \"\"\"Logging configuration for DeepInfer.\"\"\"\n7: \n8: import datetime\n9: import logging\n10: import multiprocessing\n11: import os\n12: import sys\n13: import threading\n14: import time\n15: from multiprocessing.context import ForkProcess, SpawnProcess\n16: from multiprocessing.process import BaseProcess\n17: from types import TracebackType\n18: \n19: _FORMAT = \"[%(levelname)s %(asctime)s %(filename)s:%(lineno)d] %(message)s\"\n20: _DATE_FORMAT = \"%m-%d %H:%M:%S\"\n21: \n22: # ANSI 颜色（仅在 TTY 输出时使用），按日志级别区分\n23: _LEVEL_COLORS = {\n24:     logging.DEBUG: \"\\033[36m\",  # cyan\n25:     logging.INFO: \"\\033[32m\",  # green\n26:     logging.WARNING: \"\\033[33m\",  # yellow\n27:     logging.ERROR: \"\\033[31m\",  # red\n28:     logging.CRITICAL: \"\\033[1;31m\",  # bold red\n29: }\n30: _COLOR_RESET = \"\\033[0m\"\n31: \n32: \n=== 69-120 ===\n69: \n70: \n71: _root_logger = logging.getLogger(\"deepinfer\")\n72: _default_handler = None\n73: \n74: \n75: def _setup_logger() -> None:\n76:     global _default_handler\n77:     _root_logger.setLevel(logging.DEBUG)\n78:     if _default_handler is None:\n79:         _default_handler = logging.StreamHandler(sys.stdout)\n80:         _default_handler.flush = sys.stdout.flush\n81:         _default_handler.setLevel(logging.INFO)\n82:         _root_logger.addHandler(_default_handler)\n83: \n84:     fmt = NewLineFormatter(\n85:         _FORMAT,\n86:         datefmt=_DATE_FORMAT,\n87:         use_color=sys.stdout.isatty(),\n88:     )\n89:     _default_handler.setFormatter(fmt)\n90:     _root_logger.propagate = False\n91: \n92: \n93: _setup_logger()\n94: \n95: \n96: def init_logger(name: str) -> logging.Logger:\n97:     logger = logging.getLogger(name)\n98:     logger.setLevel(logging.DEBUG)\n99:     # name 在 \"deepinfer\" 层级下时，通过 propagate 冒泡复用 root logger 的 handler，\n100:     # 无需自己挂 handler。否则回退到直接挂 handler（避免重复添加）。\n101:     if name == \"deepinfer\" or name.startswith(\"deepinfer.\"):\n102:         logger.propagate = True\n103:     else:\n104:         logger.propagate = False\n105:         if _default_handler is not None and _default_handler not in logger.handlers:\n106:             logger.addHandler(_default_handler)\n107:     return logger\n108: \n109: \n110: def _print_error_line(message: str) -> None:\n111:     now = datetime.datetime.now().strftime(f\"{_DATE_FORMAT}.%f\")\n112:     print(f\"[ERROR {now}] {message}\", file=sys.stderr, flush=True)\n113: \n114: \n115: def print_crash_header() -> None:\n116:     process_name = multiprocessing.current_process().name\n117:     thread_name = threading.current_thread().name\n118:     _print_error_line(f\"Uncaught exception in process {process_name} thread {thread_name} (pid {os.getpid()}):\")\n119: \n120: \ntotal logger lines 174\nLast output from cod