[str] | None]) -> None:\n117:     need_sleep = True\n118:     for msgs in iter(q.get, None):\n119:         try:\n120:             if need_sleep:\n121:                 time.sleep((dist.get_rank() % 8) * 0.005)\n122:             for m in msgs:\n123:                 logger.info(m)\n124:             need_sleep = q.empty()  # we skip sleep when q has backlog\n125:         except Exception:\n126:             traceback.print_exc()\n127: \n128: \n129: class StatsLogger:\n130:     \"\"\"Owns all sliding-window data, timing accumulators and logging state.\nLast output from code snippet:\nNone", "observations_images": null, "action_output": null, "token_usage": {"input_tokens": 7622, "output_tokens": 255, "total_tokens": 7877}, "is_final_answer": false}}
