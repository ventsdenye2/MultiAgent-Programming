{"event": "context_selection", "time": 1793349764.3810732, "run_id": "a770b5136c284e1a8a1f57abd913ae90", "seq": 139, "evidence_ids": ["ev-2735675841e732e983d4", "ev-a89f3e55c554b7975cee", "ev-cf02850b2a4cc8d098c8", "ev-f90ae6d59118f6e559cd", "ev-04cf83efaa23c07c924a", "ev-ac22c6384eb74cd8f4c8", "ev-fd24ff88cdcd08cbbdac", "ev-484abef7d15048d3b53f", "ev-73eb3c27293a8c4b843b", "ev-dca2c7366f2e1896330b"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-2735675841e732e983d4", 0, 139], ["ev-a89f3e55c554b7975cee", 0, 443], ["ev-cf02850b2a4cc8d098c8", 0, 30], ["ev-f90ae6d59118f6e559cd", 0, 40], ["ev-04cf83efaa23c07c924a", 0, 2694], ["ev-ac22c6384eb74cd8f4c8", 0, 147], ["ev-fd24ff88cdcd08cbbdac", 0, 145], ["ev-484abef7d15048d3b53f", 0, 521], ["ev-73eb3c27293a8c4b843b", 0, 2867], ["ev-dca2c7366f2e1896330b", 0, 638]], "estimated_body_chars": 25451, "course_content_chars": 25193, "budget_parts": {"fixed": 12636, "minimum_frame": 15980, "payload_text": 9202}, "reason": "reserve required evidence before expanding recent feedback"}
