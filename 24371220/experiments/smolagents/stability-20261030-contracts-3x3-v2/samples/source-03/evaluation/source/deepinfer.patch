+    def _shorten_message(self, message: str) -> str:
+        budget = self.max_message_chars
+        if budget is None or len(message) <= budget:
+            return message
+        budget -= len(_OMITTED_MARKER)
+        head = (budget + 1) // 2
+        tail = budget - head
+        rest = message[len(message) - tail :] if tail > 0 else ""
+        return f"{message[:head]}{_OMITTED_MARKER}{rest}"
