    else:\n            full_message = record.getMessage()\n            shortened = self._shorten_message(full_message)\n            if shortened == full_message:\n                msg = super().format(record)\n            else:\n                # 只在渲染期间临时替换，避免污染共享的 LogRecord\n                original_msg, original_args = record.msg, record.args\n                record.msg, record.args = shortened, ()\n                try:\n                    msg = super().format(record)\n                finally:\n                    record.msg, record.args = original_msg, original_args\n"}, {"old_text": "    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n", "new_text": "    from deepinfer.environ import envs\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n        max_message_chars=envs.DEEPINFER_LOG_MAX_MESSAGE_CHARS,\n    )\n"}], "expected_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8"}, "result": {"ok": true, "path": "deepinfer/logger.py", "file_hash": "7a592045984428f2b13a47ca7d00d8e01225bb9c82bcd5ef67c6b50ac533ee5c", "before_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8", "changed": true}}
