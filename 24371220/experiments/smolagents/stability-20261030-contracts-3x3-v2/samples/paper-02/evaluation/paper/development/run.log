{"event": "tool_call", "time": 1793351320.1474721, "run_id": "6222ed77274a4da8965a40987f57b9f7", "seq": 484, "tool": "write_note", "arguments": {"title": "multi_agent", "content": "multi_agent（pp.28–31）：CAMEL 用角色扮演加 inception prompting，让两个 agent 分别扮演任务与助理角色，在对话中保持身份并协作。Generative Agents 把小镇放进沙盒，用记忆流与反思驱动日程与社交行为，可信度（believability）评估由 100 名人类评估者完成，并与真人行为对照。多智能体还被用于辩论、分工与相互校验以提升推理可靠性，但通信开销与一致性仍是难点。", "evidence_ids": ["ev-419793694ae75f1e2b97", "ev-d2b420a2b23cdc8166d3"], "section": "multi_agent"}}
