sion=False, use_color=False, *, max_message_chars=None):\n        super().__init__(fmt, datefmt)\n        if max_message_chars is not None:\n            if isinstance(max_message_chars, bool) or not isinstance(max_message_chars, int):\n                raise ValueError(\"max_message_chars must be an int >= 32 or None\")\n            if max_message_chars < 32:\n                raise ValueError(...)\n        self.max_message_chars = max_message_chars\n```\n\nSetup logger: `from deepinfer.environ import envs`? Check logger.py imports. Let me read logger.py top (1-32) and end (107-end).\n\n3. stats_logger: `logger.info(m, extra={\"keep_full_message\": True})`.\n\nLet me read needed regions now."}, "logprobs": null, "finish_reason": "stop"}], "usage": {"prompt_tokens": 7151, "completion_tokens": 1503, "total_tokens": 8654, "prompt_tokens_details": {"cached_tokens": 4096}, "completion_tokens_details": {"reasoning_tokens": 1292}, "prompt_cache_hit_tokens": 4096, "prompt_cache_miss_tokens": 3055}, "system_fingerprint": "bc19ba97cbe016479903222bb1578db6"}, "classification": "ok"}
