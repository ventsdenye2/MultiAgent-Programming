{"event": "file_read", "time": 1793240171.8411138, "run_id": "b8c5781914a64e14b8d8d6d79b8feb93", "seq": 118, "path": "deepinfer/environ.py", "content": "from __future__ import annotations\n\nimport os\nimport threading\nfrom collections.abc import Callable\nfrom datetime import timedelta\nfrom typing import Any\n\nDEFAULT_PREFILL_MAX_SUM_SEQLEN_K = 2**30\n\n\ndef _bool(v: str | None, default: str = \"0\") -> bool:\n    return (v if v is not None else default) not in (\"0\", \"\", \"false\", \"False\")\n\n\ndef _int(v: str | None, default: int = 0) -> int:\n    return int(v if v is not None else str(default))\n\n\ndef _float(v: str | None, default: float = 0.0) -> float:\n    return float(v if v is not None else str(default))\n\n\ndef _str(v: str | None, default: str = \"\") -> str:\n    return v if v is not None else default\n\n\n_descriptors: dict[str, EnvVar[Any]] = {}\n\n\n", "start_line": 1, "end_line": 30}
{"event": "evidence", "time": 1793240171.8411539, "run_id": "b8c5781914a64e14b8d8d6d79b8feb93", "seq": 119, "id": "ev-ed2914917db6a069f2c0", "source": "deepinfer/environ.py", "version": "fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218", "locator": "lines:1-30", "text": "from __future__ import annotations\n\nimport os\nimport threading\nfrom collections.abc import Callable\nfrom datetime import timedelta\nfrom typing import Any\n\nDEFAULT_PREFILL_MAX_SUM_SEQLEN_K = 2**30\n\n\ndef _bool(v: str | None, default: str = \"0\") -> bool:\n    return (v if v is not None else default) not in (\"0\", \"\", \"false\", \"False\")\n\n\ndef _int(v: str | None, default: int = 0) -> int:\n    return int(v if v is not None else str(default))\n\n\ndef _float(v: str | None, default: float = 0.0) -> float:\n    return float(v if v is not None else str(default))\n\n\ndef _str(v: str | None, default: str = \"\") -> str:\n    return v if v is not None else default\n\n\n_descriptors: dict[str, EnvVar[Any]] = {}\n\n\n", "required": false, "page": null, "valid": true, "atomic": true}
{"event": "tool_result", "time": 1793240171.8411794, "run_id": "b8c5781914a64e14b8d8d6d79b8feb93", "seq": 120, "action": {"tool": "read_range", "path": "deepinfer/environ.py", "start_line": 1, "end_line": 30}, "result": {"path": "deepinfer/environ.py", "content": "from __future__ import annotations\n\nimport os\nimport threading\nfrom collections.abc import Callable\nfrom datetime import timedelta\nfrom typing import Any\n\nDEFAULT_PREFILL_MAX_SUM_SEQLEN_K = 2**30\n\n\ndef _bool(v: str | None, default: str = \"0\") -> bool:\n    return (v if v is not None else default) not in (\"0\", \"\", \"false\", \"False\")\n\n\ndef _int(v: str | None, default: int = 0) -> int:\n    return int(v if v is not None else str(default))\n\n\ndef _float(v: str | None, default: float = 0.0) -> float:\n    return float(v if v is not None else str(default))\n\n\ndef _str(v: str | None, default: str = \"\") -> str:\n    return v if v is not None else default\n\n\n_descriptors: dict[str, EnvVar[Any]] = {}\n\n\n", "file_hash": "fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218", "start_line": 1, "end_line": 30, "evidence_ids": ["ev-ed2914917db6a069f2c0"]}}
