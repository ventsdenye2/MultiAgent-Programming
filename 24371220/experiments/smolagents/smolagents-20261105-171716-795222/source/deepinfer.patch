+# 超长消息中间被替换掉的固定标记（计入长度预算）
+_TRUNCATION_MARKER = "...<omitted>..."
+_MIN_MAX_MESSAGE_CHARS = 32
+
+
+def _truncate_message(message: str, max_chars: int) -> str:
+    """保留开头与结尾，用固定标记替换中间内容，结果长度等于 max_chars。"""
+    keep = max_chars - len(_TRUNCATION_MARKER)
+    head = (keep + 1) // 2
+    tail = keep - head
+    truncated = message[:head] + _TRUNCATION_MARKER
+    if tail > 0:
+        truncated += message[len(message) - tail :]
+    return truncated
+
 
