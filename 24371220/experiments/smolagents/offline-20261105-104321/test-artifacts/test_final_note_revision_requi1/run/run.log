ead. Do not print all pages.\\nstart_page: {\"type\":\"integer\"}\\nend_page: {\"type\":\"integer\"}'\n\ndef run_command(argv: list, cwd: str = None) -> dict:\n    'Run one allowed argv command without a shell. Omit cwd or use \\'.\\' for the task repository root. argv is a Python list[str]. Returns dict: rc, stdout (text), stderr, timed_out.\\nargv: {\"type\":\"array\",\"items\":{\"type\":\"string\"}}\\ncwd: {\"type\":\"string\"}'\n\ndef update_plan(items: list) -> dict:\n    'Set the task plan; preserve titles/order and update todo/doing/done.\\nitems: {\"type\":\"array\",\"description\":\"List of objects, e.g. [{\\\\\"title\\\\\":\\\\\"Read sources\\\\\",\\\\\"status\\\\\":\\\\\"doing\\\\\"}]. Each status is todo, doing or done; retain existing titles/order.\"}'\n\ndef recall(evidence_ids: list) -> dict:\n    'Queue evidence ids; batches are bounded and overflow remains pending.\\nevidence_ids: {\"type\":\"array\"}'\n\ndef task_status() -> dict:\n    'Show the current plan, remaining reading, notes, changes and verification, plus evidence ids.'\n\ndef save_answer(section: str, question_id: str, answer: dict, evidence_id: str, page: int, quote: str) -> dict:\n    'Save an answer with exact cited page text. answer must contain exactly value. Returns dict: section, question_id, saved.\\nsection: {\"type\":\"string\"}\\nquestion_id: {\"type\":\"string\"}\\nanswer: {\"type\":\"object\",\"description\":\"{\\'value\\': string, integer or list of strings}\"}\\nevidence_id: {\"type\":\"string\"}\\npage: {\"type\":\"integer\"}\\nquote: {\"type\":\"string\"}'\n\ndef save_section(section: str, summary: str, application: str) -> dict:\n    'Save section prose. Returns dict: section, saved.\\nsection: {\"type\":\"string\"}\\nsummary: {\"type\":\"string\"}\\napplication: {\"type\":\"string\"}'\n\ndef submit_report(overview: str, expected_hash: str) -> dict:\n    'Serialize saved results to report.json. Returns dict: ok, path, before_hash, file_hash, changed.\\noverview: {\"type