{"event": "context_selection", "time": 1793327649.4616709, "run_id": "735d83ad58094f98a42bd72a0196524e", "seq": 176, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-c8859274b7c70879ff16", "ev-ed9882c5a5fbad916785", "ev-fc71f232b8c4f296a126", "ev-684663f9df85ab006e4e"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-c8859274b7c70879ff16", 0, 139], ["ev-ed9882c5a5fbad916785", 0, 874], ["ev-fc71f232b8c4f296a126", 0, 2455], ["ev-684663f9df85ab006e4e", 0, 3459]], "estimated_body_chars": 24341, "course_content_chars": 24083, "budget_parts": {"fixed": 12788, "minimum_frame": 15476, "payload_text": 7937}, "reason": "reserve required evidence before expanding recent feedback"}
