dget is None or len(message) <= budget:\n            return message\n        marker = self._OMISSION_MARKER\n        remaining = budget - len(marker)\n        if remaining <= 0:\n            return marker[:budget]\n        head = (remaining + 1) // 2\n        tail = remaining - head\n        suffix = message[len(message) - tail:] if tail else \"\"\n        return f\"{message[:head]}{marker}{suffix}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        if self.max_message_chars is not None and getattr(record, \"keep_full_message\", None) is not True:\n            full_message = record.getMessage()\n            truncated = self._truncate_message(full_message)\n            if truncated != full_message:\n                # 复制记录，绝不改写共享原记录的 msg/args/exc_info/stack_info\n                record = copy.copy(record)\n                record.msg = truncated\n                record.args = ()\n        msg = super().format(record)\n'''\nr = replace_text(\"deepinfer/logger.py\", old_fmt, new_fmt, lh)\nprint(\"logger format:\", r.get('rc', r.get('status', r)))\nlh = read_file(\"deepinfer/logger.py\")['file_hash']\n\nold_setup = \"\"\"    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n\"\"\"\nnew_setup = \"\"\"    from deepinfer.environ import envs\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n        max_message_chars=envs.DEEPINFER_LOG_MAX_MESSAGE_CHARS,\n    )\n\"\"\"\nr = replace_text(\"deepinfer/logger.py\", old_setup, new_setup, lh)\nprint(\"logger setup:\", r.get('rc', r.get('status', r)))\n\n# ---- stats_logger.py ----\nsh = \"9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\"\nold_loop = \"\"\"            for m in msgs:\n                logger.info(m)\n\"\"\"\nnew_loop = \"\"\"            for m in msgs:\n                logger.info(m, extra={\"keep_full_message\": True})\n\"\"\"\nr = replace_text(\