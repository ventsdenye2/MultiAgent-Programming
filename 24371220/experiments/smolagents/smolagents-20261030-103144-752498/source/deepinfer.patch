+    def _truncate_message(self, message: str) -> str:
+        budget = self.max_message_chars
+        if budget is None or len(message) <= budget:
+            return message
+        marker = self._OMISSION_MARKER
+        remaining = budget - len(marker)
+        if remaining <= 0:
+            return marker[:budget]
+        head = (remaining + 1) // 2
+        tail = remaining - head
+        suffix = message[len(message) - tail:] if tail else ""
+        return f"{message[:head]}{marker}{suffix}"
