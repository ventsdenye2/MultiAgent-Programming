{"event": "context_selection", "time": 1793848097.5766618, "run_id": "10639db121d146fa9696d9099c6f2d6e", "seq": 210, "evidence_ids": ["ev-e5b9499e130a976eefe2", "ev-7f4d5e2fe0886c80c09b", "ev-731fa63b8d34dde45e62"], "note_ids": ["overview"], "deferred": ["ev-4e747765f5046c8ad8b1", "ev-daeb56e673fc61cae0ef", "ev-a30e6edea79391cf315d", "ev-1e23be7c32e2bf283689", "ev-eb42e63472799e638c3f", "ev-81117fe71aa5d10b548d", "ev-97c7764bd93b97111551", "ev-2c646589154451e7b722", "ev-1d8af21fdc46c86a5055", "ev-e403dfb2811682ecd186", "ev-41048209f3096e51f36b", "ev-a9b70da77a1c104405a2", "ev-345e6706309ac04ee927", "ev-98a30db9253fff6cc9da", "ev-2f8846ab5b1bc7072a1b", "ev-76027d4e758f97793930", "ev-2bcb169328f17ac85c9d", "ev-a67fb4f311d1f21c4aba", "ev-baddfbae8db75139dd16", "ev-94c9aed99ffbcdf31b43", "ev-bc885ff165a165a4d614", "ev-fdbf1c532c2133190b0f", "ev-75546d247dedb90561b5", "ev-f03e4b7f1b7fc6e66886", "ev-aa9b9dbdfec8c640b495", "ev-6e64db9ec6bfa8f9417f", "ev-42cada09d7411017eb46", "ev-99f0f0a37d328bfed1a9", "ev-01ce8948bcc88d235ea3"], "delivered_parts": [["ev-e5b9499e130a976eefe2", 0, 4468], ["ev-7f4d5e2fe0886c80c09b", 0, 1572], ["ev-731fa63b8d34dde45e62", 0, 2663]], "estimated_body_chars": 26936, "course_content_chars": 26678, "budget_parts": {"fixed": 12938, "minimum_frame": 16633, "payload_text": 9855}, "reason": "reserve required evidence before expanding recent feedback"}
