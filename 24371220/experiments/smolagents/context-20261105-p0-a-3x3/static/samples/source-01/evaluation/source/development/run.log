{"event": "file_read", "time": 1793847706.8180835, "run_id": "136633a8d46f4c379e4bb81886eb147c", "seq": 79, "path": "deepinfer/logger.py", "content": "# SPDX-License-Identifier: Apache-2.0\n# Derived from vLLM; modified by DeepSeek.\n\n# Adapted from\n# https://github.com/skypilot-org/skypilot/blob/86dc0f6283a335e4aa37b3c10716f90999f48ab6/sky/sky_logging.py\n\"\"\"Logging configuration for DeepInfer.\"\"\"\n\nimport datetime\nimport logging\nimport multiprocessing\nimport os\nimport sys\nimport threading\nimport time\nfrom multiprocessing.context import ForkProcess, SpawnProcess\nfrom multiprocessing.process import BaseProcess\nfrom types import TracebackType\n\n_FORMAT = \"[%(levelname)s %(asctime)s %(filename)s:%(lineno)d] %(message)s\"\n_DATE_FORMAT = \"%m-%d %H:%M:%S\"\n\n# ANSI 颜色（仅在 TTY 输出时使用），按日志级别区分\n_LEVEL_COLORS = {\n    logging.DEBUG: \"\\033[36m\",  # cyan\n    logging.INFO: \"\\033[32m\",  # green\n    logging.WARNING: \"\\033[33m\",  # yellow\n    logging.ERROR: \"\\033[31m\",  # red\n    logging.CRITICAL: \"\\033[1;31m\",  # bold red\n}\n_COLOR_RESET = \"\\033[0m\"\n\n\nclass NewLineFormatter(logging.Formatter):\n", "start_line": 1, "end_line": 33}
{"event": "evidence", "time": 1793847706.8182304, "run_id": "136633a8d46f4c379e4bb81886eb147c", "seq": 80, "id": "ev-eae82c05a3a3c473d07d", "source": "deepinfer/logger.py", "version": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8", "locator": "lines:1-33", "text": "# SPDX-License-Identifier: Apache-2.0\n# Derived from vLLM; modified by DeepSeek.\n\n# Adapted from\n# https://github.com/skypilot-org/skypilot/blob/86dc0f6283a335e4aa37b3c10716f90999f48ab6/sky/sky_logging.py\n\"\"\"Logging configuration for DeepInfer.\"\"\"\n\nimport datetime\nimport logging\nimport multiprocessing\nimport os\nimport sys\nimport threading\nimport time\nfrom multiprocessing.context import ForkProcess, SpawnProcess\nfrom multiprocessing.process import BaseProcess\nfrom types import TracebackType\n\n_FORMAT = \"[%(levelname)s %(asctime)s %(filename)s:%(lineno)d] %(message)s\"\n_DATE_FORMAT = \"%m-%d %H:%M:%S\"\n\n# ANSI 颜色（仅在 TTY 输出时使用），按日志级别区分\n_LEVEL_COLORS = {\n    logging.DEBUG: \"\\033[36m\",  # cyan\n    logging.INFO: \"\\033[32m\",  # green\n    logging.WARNING: \"\\033[33m\",  # yellow\n    logging.ERROR: \"\\033[31m\",  # red\n    logging.CRITICAL: \"\\033[1;31m\",  # bold red\n}\n_COLOR_RESET = \"\\033[0m\"\n\n\nclass NewLineFormatter(logging.Formatter):\n", "required": false, "page": null, "valid": true, "atomic": true}
{"event": "tool_result", "time": 1793847706.8183432, "run_id": "136633a8d46f4c379e4bb81886eb147c", "seq": 81, "action": {"tool": "read_range", "path": "deepinfer/logger.py", "start_line": 1, "end_line": 33}, "result": {"path": "deepinfer/logger.py", "content": "# SPDX-License-Identifier: Apache-2.0\n# Derived from vLLM; modified by DeepSeek.\n\n# Adapted from\n# https://github.com/skypilot-org/skypilot/blob/86dc0f6283a335e4aa37b3c10716f90999f48ab6/sky/sky_logging.py\n\"\"\"Logging configuration for DeepInfer.\"\"\"\n\nimport datetime\nimport logging\nimport multiprocessing\nimport os\nimport sys\nimport threading\nimport time\nfrom multiprocessing.context import ForkProcess, SpawnProcess\nfrom multiprocessing.process import BaseProcess\nfrom types import TracebackType\n\n_FORMAT = \"[%(levelname)s %(asctime)s %(filename)s:%(lineno)d] %(message)s\"\n_DATE_FORMAT = \"%m-%d %H:%M:%S\"\n\n# ANSI 颜色（仅在 TTY 输出时使用），按日志级别区分\n_LEVEL_COLORS = {\n    logging.DEBUG: \"\\033[36m\",  # cyan\n    logging.INFO: \"\\033[32m\",  # green\n    logging.WARNING: \"\\033[33m\",  # yellow\n    logging.ERROR: \"\\033[31m\",  # red\n    logging.CRITICAL: \"\\033[1;31m\",  # bold red\n}\n_COLOR_RESET = \"\\033[0m\"\n\n\nclass NewLineFormatter(logging.Formatter):\n", "file_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8", "start_line": 1, "end_line": 33, "evidence_ids": ["ev-eae82c05a3a3c473d07d"], "delivery": "Originals queued for the next model request; large batches may span requests."}}
