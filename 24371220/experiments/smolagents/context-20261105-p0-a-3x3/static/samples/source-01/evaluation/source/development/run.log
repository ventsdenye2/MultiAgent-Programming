\n        print_crash_header()\n        threading.__excepthook__(args)\n        if exit_on_thread_exception:\n            _print_error_line(f\"Aborting process due to uncaught exception in thread {args.thread.name}: {args.exc_value}\")\n", "file_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8", "start_line": 88, "end_line": 140, "evidence_ids": ["ev-e77f65247b1dcb7253c1"], "delivery": "Originals queued for the next model request; large batches may span requests."}}
