{"event": "tool_result", "time": 1793847861.8162389, "run_id": "136633a8d46f4c379e4bb81886eb147c", "seq": 301, "action": {"tool": "replace_text_batch", "path": "deepinfer/logger.py", "edits": [{"old_text": "    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n", "new_text": "    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n        *,\n        max_message_chars: int | None = None,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n        if max_message_chars is not None:\n            if (\n                isinstance(max_message_chars, bool)\n                or not isinstance(max_message_chars, int)\n                or max_message_chars < 32\n            ):\n                raise ValueError(\"max_message_chars must be an integer >= 32 or None\")\n        self.max_message_chars = max_message_chars\n"}, {"old_text": "    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg\n", "new_text": "    def _truncate_message(self, message: str) -> str:\n        if self.max_message_chars is None or len(message) <= self.max_message_chars:\n            return message\n        omitted = \"...<omitted>...\"\n        available = self.max_message_chars - len(omitted)\n        head = (available + 1) // 2\n        tail = available - head\n        return message[:head] + omitted + (message[-tail:] if tail else \"\")\n\n    def format(self, record: logging.LogRecord) -> str:\n        message = record.getMessage()\n        if getattr(record, \"keep_full_message\", None) is not True:\n            message = self._truncate_message(message)\n        # 使用副本，避免当前 handler 的截断影响同一记录的其他 handler。\n        work_record = logging.makeLogRecord(record.__dict__)\n        work_record.msg = message\n        work_record.args = ()\n        msg = super().format(work_record)\n        runtime_message = work_record.message\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and runtime_message:\n            prefix = msg[: msg.find(runtime_message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg\n"}, {"old_text": "    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n", "new_text": "    from deepinfer import envs\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n        max_message_chars=envs.DEEPINFER_LOG_MAX_MESSAGE_CHARS,\n    )\n"}], "expected_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8"}, "result": {"ok": true, "path": "deepinfer/logger.py", "file_hash": "b70a3b2b7b3501fe242f99292f6e1b5cfc262993917e0dd47cee0546aaea6f69", "before_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8", "changed": true}}
