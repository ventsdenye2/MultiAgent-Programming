ssage_chars must be an int >= {_MIN_MESSAGE_CHARS} or None, \"\n                    f\"got {max_message_chars!r}\"\n                )\n        self.max_message_chars = max_message_chars\n\n    def _truncate_message(self, record: logging.LogRecord) -> str | None:\n        \"\"\"返回截断后的消息正文；无需截断时返回 None。\"\"\"\n        budget = self.max_message_chars\n        if budget is None:\n            return None\n        if getattr(record, \"keep_full_message\", None) is True:\n            return None\n        message = record.getMessage()\n        if len(message) <= budget:\n            return None\n        mark = _OMITTED_MARK\n        remaining = budget - len(mark)\n        if remaining <= 0:\n            return message[:budget]\n        head = -(-remaining // 2)\n        tail = remaining - head\n        head_part = message[:head]\n        tail_part = message[len(message) - tail :] if tail > 0 else \"\"\n        return f\"{head_part}{mark}{tail_part}\"\n\n    def formatTime\n```\n\nMove formatTime to old_text anchor: `        self.use_color = use_color\\n\\n    def formatTime` — that's in the constructor block old text. I'll include `\\n\\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:` in old text and reappend.\n\nformat method old:\n```\n    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n```\nnew:\n```\n    def format(self, record: logging.LogRecord) -> str:\n        truncated = self._truncate_message(record)\n        if truncated is not None:\n            # 复制记录再格式化，避免改动共享原记录的 msg/args/message\n            record = logging.makeLogRecord(dict(record.__dict__))\n            record.msg = truncated\n            record.args = None\n        msg = super().format(record)\n```\n\nCareful: makeLogRecord copy retains exc_info/exc_text — good.\n\nHmm: if truncated, the truncated message may contain no newline; fine.\n\n_setup_logger old:\n```\n    fmt = NewLineFormatter(\n        _FORMAT,\n        dat