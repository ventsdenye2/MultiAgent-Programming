+    def int_or_none_ge(*, minimum: int, name: str):
+        """可选整数配置：未设置时为 None；设置时用 int 解析且不得小于 minimum。"""
+
+        def _init(v: str | None):
+            if v is None:
+                return None
+            try:
+                value = int(v)
+            except (TypeError, ValueError) as exc:
+                raise ValueError(
+                    f"{name} must be an integer >= {minimum}, got {v!r}"
+                ) from exc
+            if value < minimum:
+                raise ValueError(f"{name} must be an integer >= {minimum}, got {v!r}")
+            return value
+
+        return EnvVar(_init)
+
 
