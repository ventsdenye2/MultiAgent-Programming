.init = init\n        self.lock = threading.Lock()\n\n    def __set_name__(self, owner: type[envs], name: str) -> None:\n        self.name = name\n        _descriptors[name] = self\n\n    def __get__(self, instance: envs | None, owner: type[envs]) -> T:\n        with self.lock:\n            cached = owner.__dict__.get(self.name, self)\n            if cached is not self:\n                return cached\n            try:\n                value = self.init(os.getenv(self.name))\n            except Exception as e:  # noqa: BLE001\n                try:\n                    raise type(e)(f\"{self.name}: {e}\") from e\n                except TypeError:\n                    raise e from None\n            setattr(owner, self.name, value)\n            return value\n\n    # -- Factory Methods --\n\n    @staticmethod\n    def int(*, default: int = 0) -> EnvVar[int]:\n        return EnvVar(lambda v: _int(v, default))\n\n    @staticmethod\n    def float(*, default: float = 0.0) -> EnvVar[float]:\n        return EnvVar(lambda v: _float(v, default))\n\n    @staticmethod\n    def bool(*, default: bool = False) -> EnvVar[bool]:\n        return EnvVar(lambda v: _bool(v, \"1\" if default else \"0\"))\n\n    @staticmethod\n    def str(*, default: str = \"\") -> EnvVar[str]:\n        return EnvVar(lambda v: _str(v, default))\n\n    @staticmethod\n    def str_or_none() -> EnvVar[str | None]:\n        return EnvVar(lambda v: v)\n\n    @staticmethod\n    def int_or_none() -> EnvVar[int | None]:\n        return EnvVar(lambda v: int(v) if v is not None else None)\n\n    @staticmethod\n    def choice(*, default: str | None = None, choices: tuple[str, ...]) -> EnvVar[str | None]:\n        def _init(v: str | None) -> str | None:\n            if v is None:\n                return default\n            if v not in choices:\n                raise ValueError(f\"{v!r}, must be one of {choices}\")\n            return v\n\n        return EnvVar(_init)"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-ef45633e339c9e5fd82f | deepinfer/environ.py | lines:218-221 | sha256=fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218\ndef rearm_all() -> None:\n    \"\"\"Rearm all descriptors.\"\"\"\n    for name, descriptor in _descriptors.items():\n        setattr(envs, name, descriptor)"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-30754515034e43628968 | deepinfer/logger.py | lines:33-68 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\nclass NewLineFormatter(logging.Formatter):\n    \"\"\"Adds logging prefix to newlines to align multi-line messages, optionally with microsecond precision.\n\n    若 use_color=True 且输出为 TTY，会给日志级别染色（不影响写入文件的纯净度）。\n    \"\"\"\n\n    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:\n        if not self.high_precision:\n            # 调用 logging.Formatter 默认实现，保持原来的格式\n            return super().formatTime(record, datefmt)\n        # ===== 高精度模式：在普通 datefmt 基础上附加微秒 =====\n        base = time.strftime(datefmt or _DATE_FORMAT, self.converter(record.created))\n        return f\"{base}.{record.msecs * 1000:06.0f}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-51e2fa3b9fc1aebe86f3 | deepinfer/logger.py | lines:96-107 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\ndef init_logger(name: str) -> logging.Logger:\n    logger = logging.getLogger(name)\n    logger.setLevel(logging.DEBUG)\n    # name 在 \"deepinfer\" 层级下时，通过 propagate 冒泡复用 root logger 的 handler，\n    # 无需自己挂 handler。否则回退到直接挂 handler（避免重复添加）。\n    if name == \"deepinfer\" or name.startswith(\"deepinfer.\"):\n        logger.propagate = True\n    else:\n        logger.propagate = False\n        if _default_handler is not None and _default_handler not in logger.handlers:\n            logger.addHandler(_default_handler)\n    return logger"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-57e48f50b5e8ebc7b66b | deepinfer/engine/stats_logger.py | lines:100-120 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\n    def __len__(self) -> int:\n        return len(self.entries)\n\n    def __bool__(self) -> bool:\n        return bool(self.entries)\n\n    def append(self, now: float, payload: object, step: int) -> None:\n        self.entries.append((now, payload, step))\n\n    def trim(self, step: int, max_age: int) -> None:\n        self.entries = [e for e in self.entries if step - e[2] <= max_age]\n\n    def sum(self, key: Callable[[object], float]) -> float:\n        return sum(key(p) for _, p, _ in self.entries)\n\n\ndef _log_worker(q: queue.SimpleQueue[list[str] | None]) -> None:\n    need_sleep = True\n    for msgs in iter(q.get, None):\n        try:\n            if need_sleep:\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-0a382ced087bf000f97b | deepinfer/environ.py | lines:85-100 | sha256=fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218\n    @staticmethod\n    def choice(*, default: str | None = None, choices: tuple[str, ...]) -> EnvVar[str | None]:\n        def _init(v: str | None) -> str | None:\n            if v is None:\n                return default\n            if v not in choices:\n                raise ValueError(f\"{v!r}, must be one of {choices}\")\n            return v\n\n        return EnvVar(_init)\n\n\nclass envs:\n    \"环境变量的集中定义模块\"\n\n    # -- Platform --\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-243db72e3811e6161ab9 | deepinfer/logger.py | lines:68-100 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\n        return msg\n\n\n_root_logger = logging.getLogger(\"deepinfer\")\n_default_handler = None\n\n\ndef _setup_logger() -> None:\n    global _default_handler\n    _root_logger.setLevel(logging.DEBUG)\n    if _default_handler is None:\n        _default_handler = logging.StreamHandler(sys.stdout)\n        _default_handler.flush = sys.stdout.flush\n        _default_handler.setLevel(logging.INFO)\n        _root_logger.addHandler(_default_handler)\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n    _default_handler.setFormatter(fmt)\n    _root_logger.propagate = False\n\n\n_setup_logger()\n\n\ndef init_logger(name: str) -> logging.Logger:\n    logger = logging.getLogger(name)\n    logger.setLevel(logging.DEBUG)\n    # name 在 \"deepinfer\" 层级下时，通过 propagate 冒泡复用 root logger 的 handler，\n    # 无需自己挂 handler。否则回退到直接挂 handler（避免重复添加）。\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-eae82c05a3a3c473d07d | deepinfer/logger.py | lines:1-33 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\n# SPDX-License-Identifier: Apache-2.0\n# Derived from vLLM; modified by DeepSeek.\n\n# Adapted from\n# https://github.com/skypilot-org/skypilot/blob/86dc0f6283a335e4aa37b3c10716f90999f48ab6/sky/sky_logging.py\n\"\"\"Logging configuration for DeepInfer.\"\"\"\n\nimport datetime\nimport logging\nimport multiprocessing\nimport os\nimport sys\nimport threading\nimport time\nfrom multiprocessing.context import ForkProcess, SpawnProcess\nfrom multiprocessing.process import BaseProcess\nfrom types import TracebackType\n\n_FORMAT = \"[%(levelname)s %(asctime)s %(filename)s:%(lineno)d] %(message)s\"\n_DATE_FORMAT = \"%m-%d %H:%M:%S\"\n\n# ANSI 颜色（仅在 TTY 输出时使用），按日志级别区分\n_LEVEL_COLORS = {\n    logging.DEBUG: \"\\033[36m\",  # cyan\n    logging.INFO: \"\\033[32m\",  # green\n    logging.WARNING: \"\\033[33m\",  # yellow\n    logging.ERROR: \"\\033[31m\",  # red\n    logging.CRITICAL: \"\\033[1;31m\",  # bold red\n}\n_COLOR_RESET = \"\\033[0m\"\n\n\nclass NewLineFormatter(logging.Formatter):\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-05b685ba4929af63eb62 | deepinfer/engine/stats_logger.py | lines:108-135 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\n\n    def trim(self, step: int, max_age: int) -> None:\n        self.entries = [e for e in self.entries if step - e[2] <= max_age]\n\n    def sum(self, key: Callable[[object], float]) -> float:\n        return sum(key(p) for _, p, _ in self.entries)\n\n\ndef _log_worker(q: queue.SimpleQueue[list[str] | None]) -> None:\n    need_sleep = True\n    for msgs in iter(q.get, None):\n        try:\n            if need_sleep:\n                time.sleep((dist.get_rank() % 8) * 0.005)\n            for m in msgs:\n                logger.info(m)\n            need_sleep = q.empty()  # we skip sleep when q has backlog\n        except Exception:\n            traceback.print_exc()\n\n\nclass StatsLogger:\n    \"\"\"Owns all sliding-window data, timing accumulators and logging state.\n\n    The ``engine`` back-reference is used as follows:\n\n    Read-only:\n      - ``scheduler`` (block counts, preempted/aborted, running/pending/chunked)\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-aa31811a8ad5ebea31bb | deepinfer/engine/stats_logger.py | lines:1-40 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\n\"\"\"Engine statistics collection, aggregation and logging.\"\"\"\n\nfrom __future__ import annotations\n\nimport queue\nimport statistics\nimport threading\nimport time\nimport traceback\nfrom collections import deque\nfrom collections.abc import Callable\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING\n\nimport numpy as np\nimport torch.distributed as dist\n\nfrom deepinfer import envs\nfrom deepinfer.engine.engine_type import EngineType\nfrom deepinfer.logger import init_logger\nfrom deepinfer.model_executor.parallel_utils.nccl_memory import NCCLMemoryStatsLogger\nfrom deepinfer.timer import cpu_timer, get_timers\nfrom deepinfer.utils import safe_divide\n\nif TYPE_CHECKING:\n    from deepinfer.config import CacheConfig, ModelConfig, ParallelConfig\n    from deepinfer.engine.llm_engine import LLMEngine\n\nlogger = init_logger(__name__)\n\n\n@dataclass\nclass StepStats:\n    \"\"\"Per-step statistics fed into :py:meth:`StatsLogger.log_step`.\"\"\"\n\n    prompt_run: bool\n    num_seqs: int\n    num_batched_tokens: int\n    sum_seqlen_qxk: int\n    max_seqlen_k: int\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-ed2914917db6a069f2c0 | deepinfer/environ.py | lines:1-30 | sha256=fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218\nfrom __future__ import annotations\n\nimport os\nimport threading\nfrom collections.abc import Callable\nfrom datetime import timedelta\nfrom typing import Any\n\nDEFAULT_PREFILL_MAX_SUM_SEQLEN_K = 2**30\n\n\n