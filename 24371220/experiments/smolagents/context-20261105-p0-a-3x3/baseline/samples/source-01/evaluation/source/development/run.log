{"event": "file_read", "time": 1793847508.612436, "run_id": "d4db2757396a4dc8862fc4cf32093cae", "seq": 325, "path": "deepinfer/logger.py", "content": "# SPDX-License-Identifier: Apache-2.0\n# Derived from vLLM; modified by DeepSeek.\n\n# Adapted from\n# https://github.com/skypilot-org/skypilot/blob/86dc0f6283a335e4aa37b3c10716f90999f48ab6/sky/sky_logging.py\n\"\"\"Logging configuration for DeepInfer.\"\"\"\n\nimport datetime\nimport logging\nimport multiprocessing\nimport os\nimport sys\nimport threading\nimport time\nfrom multiprocessing.context import ForkProcess, SpawnProcess\nfrom multiprocessing.process import BaseProcess\nfrom types import TracebackType\n\n_FORMAT = \"[%(levelname)s %(asctime)s %(filename)s:%(lineno)d] %(message)s\"\n_DATE_FORMAT = \"%m-%d %H:%M:%S\"\n\n# ANSI 颜色（仅在 TTY 输出时使用），按日志级别区分\n_LEVEL_COLORS = {\n    logging.DEBUG: \"\\033[36m\",  # cyan\n    logging.INFO: \"\\033[32m\",  # green\n    logging.WARNING: \"\\033[33m\",  # yellow\n    logging.ERROR: \"\\033[31m\",  # red\n    logging.CRITICAL: \"\\033[1;31m\",  # bold red\n}\n_COLOR_RESET = \"\\033[0m\"\n\n\nclass NewLineFormatter(logging.Formatter):\n    \"\"\"Adds logging prefix to newlines to align multi-line messages, optionally with microsecond precision.\n\n    若 use_color=True 且输出为 TTY，会给日志级别染色（不影响写入文件的纯净度）。\n    \"\"\"\n\n    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:\n        if not self.high_precision:\n            # 调用 logging.Formatter 默认实现，保持原来的格式\n            return super().formatTime(record, datefmt)\n        # ===== 高精度模式：在普通 datefmt 基础上附加微秒 =====\n        base = time.strftime(datefmt or _DATE_FORMAT, self.converter(record.created))\n        return f\"{base}.{record.msecs * 1000:06.0f}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg\n\n\n_root_logger = logging.getLogger(\"deepinfer\")\n_default_handler = None\n\n\ndef _setup_logger() -> None:\n    global _default_handler\n    _root_logger.setLevel(logging.DEBUG)\n    if _default_handler is None:\n        _default_handler = logging.StreamHandler(sys.stdout)\n        _default_handler.flush = sys.stdout.flush\n        _default_handler.setLevel(logging.INFO)\n        _root_logger.addHandler(_default_handler)\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n    _default_handler.setFormatter(fmt)\n    _root_logger.propagate = False\n\n\n_setup_logger()\n\n\ndef init_logger(name: str) -> logging.Logger:\n    logger = logging.getLogger(name)\n    logger.setLevel(logging.DEBUG)\n    # name 在 \"deepinfer\" 层级下时，通过 propagate 冒泡复用 root logger 的 handler，\n    # 无需自己挂 handler。否则回退到直接挂 handler（避免重复添加）。\n    if name == \"deepinfer\" or name.startswith(\"deepinfer.\"):\n        logger.propagate = True\n    else:\n        logger.propagate = False\n        if _default_handler is not None and _default_handler not in logger.handlers:\n            logger.addHandler(_default_handler)\n    return logger\n\n\ndef _print_error_line(message: str) -> None:\n    now = datetime.datetime.now().strftime(f\"{_DATE_FORMAT}.%f\")\n    print(f\"[ERROR {now}] {message}\", file=sys.stderr, flush=True)\n\n\ndef print_crash_header() -> None:\n    process_name = multiprocessing.current_process().name\n    thread_name = threading.current_thread().name\n    _print_error_line(f\"Uncaught exception in process {process_name} thread {thread_name} (pid {os.getpid()}):\")\n\n\ndef install_excepthook(exit_on_thread_exception: bool = False) -> None:\n    \"\"\"Print error timestamp, traceback, and process/thread info when an uncaught exception occurs.\n\n    Args:\n        exit_on_thread_exception (bool): If True, the process will exit when an uncaught exception occurs in a thread.\n    \"\"\"\n\n    def _excepthook(\n        exc_type: type[BaseException],\n        exc_value: BaseException,\n        exc_tb: TracebackType | None,\n    ) -> None:\n        print_crash_header()\n        sys.__excepthook__(exc_type, exc_value, exc_tb)\n\n    def _thread_excepthook(args: threading.ExceptHookArgs) -> None:\n        print_crash_header()\n        threading.__excepthook__(args)\n        if exit_on_thread_exception:\n            _print_error_line(f\"Aborting process due to uncaught exception in thread {args.thread.name}: {args.exc_value}\")\n            sys.stdout.flush()\n            sys.stderr.flush()\n            os._exit(1)\n\n    sys.excepthook = _excepthook\n    threading.excepthook = _thread_excepthook\n\n\nclass _CrashHeaderProcessMixin(BaseProcess):\n    \"\"\"给子进程崩溃打印头信息，每条路径恰好一次：\n\n    - 主线程崩溃：BaseProcess._bootstrap 用裸 except 拦截 run() 抛出的异常后直接退出，\n      sys.excepthook 不会触发，头信息仅由下面的 except 分支打印；\n    - 子线程崩溃：异常不会传播到 run()，头信息仅由 install_excepthook\n      安装的 threading.excepthook 打印。\n    \"\"\"\n\n    def run(self) -> None:\n        install_excepthook()\n        try:\n            super().run()\n        except SystemExit:\n            raise\n        except BaseException:\n            print_crash_header()\n            raise\n\n\nclass SpawnProcessWithCrashHeader(_CrashHeaderProcessMixin, SpawnProcess):\n    pass\n\n\nclass ForkProcessWithCrashHeader(_CrashHeaderProcessMixin, ForkProcess):\n    pass\n"}
{"event": "tool_result", "time": 1793847508.6984534, "run_id": "d4db2757396a4dc8862fc4cf32093cae", "seq": 326, "action": {"tool": "read_file", "path": "deepinfer/logger.py"}, "result": {"path": "deepinfer/logger.py", "content": "# SPDX-License-Identifier: Apache-2.0\n# Derived from vLLM; modified by DeepSeek.\n\n# Adapted from\n# https://github.com/skypilot-org/skypilot/blob/86dc0f6283a335e4aa37b3c10716f90999f48ab6/sky/sky_logging.py\n\"\"\"Logging configuration for DeepInfer.\"\"\"\n\nimport datetime\nimport logging\nimport multiprocessing\nimport os\nimport sys\nimport threading\nimport time\nfrom multiprocessing.context import ForkProcess, SpawnProcess\nfrom multiprocessing.process import BaseProcess\nfrom types import TracebackType\n\n_FORMAT = \"[%(levelname)s %(asctime)s %(filename)s:%(lineno)d] %(message)s\"\n_DATE_FORMAT = \"%m-%d %H:%M:%S\"\n\n# ANSI 颜色（仅在 TTY 输出时使用），按日志级别区分\n_LEVEL_COLORS = {\n    logging.DEBUG: \"\\033[36m\",  # cyan\n    logging.INFO: \"\\033[32m\",  # green\n    logging.WARNING: \"\\033[33m\",  # yellow\n    logging.ERROR: \"\\033[31m\",  # red\n    logging.CRITICAL: \"\\033[1;31m\",  # bold red\n}\n_COLOR_RESET = \"\\033[0m\"\n\n\nclass NewLineFormatter(logging.Formatter):\n    \"\"\"Adds logging prefix to newlines to align multi-line messages, optionally with microsecond precision.\n\n    若 use_color=True 且输出为 TTY，会给日志级别染色（不影响写入文件的纯净度）。\n    \"\"\"\n\n    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:\n        if not self.high_precision:\n            # 调用 logging.Formatter 默认实现，保持原来的格式\n            return super().formatTime(record, datefmt)\n        # ===== 高精度模式：在普通 datefmt 基础上附加微秒 =====\n        base = time.strftime(datefmt or _DATE_FORMAT, self.converter(record.created))\n        return f\"{base}.{record.msecs * 1000:06.0f}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg\n\n\n_root_logger = logging.getLogger(\"deepinfer\")\n_default_handler = None\n\n\ndef _setup_logger() -> None:\n    global _default_handler\n    _root_logger.setLevel(logging.DEBUG)\n    if _default_handler is None:\n        _default_handler = logging.StreamHandler(sys.stdout)\n        _default_handler.flush = sys.stdout.flush\n        _default_handler.setLevel(logging.INFO)\n        _root_logger.addHandler(_default_handler)\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n    _default_handler.setFormatter(fmt)\n    _root_logger.propagate = False\n\n\n_setup_logger()\n\n\ndef init_logger(name: str) -> logging.Logger:\n    logger = logging.getLogger(name)\n    logger.setLevel(logging.DEBUG)\n    # name 在 \"deepinfer\" 层级下时，通过 propagate 冒泡复用 root logger 的 handler，\n    # 无需自己挂 handler。否则回退到直接挂 handler（避免重复添加）。\n    if name == \"deepinfer\" or name.startswith(\"deepinfer.\"):\n        logger.propagate = True\n    else:\n        logger.propagate = False\n        if _default_handler is not None and _default_handler not in logger.handlers:\n            logger.addHandler(_default_handler)\n    return logger\n\n\ndef _print_error_line(message: str) -> None:\n    now = datetime.datetime.now().strftime(f\"{_DATE_FORMAT}.%f\")\n    print(f\"[ERROR {now}] {message}\", file=sys.stderr, flush=True)\n\n\ndef print_crash_header() -> None:\n    process_name = multiprocessing.current_process().name\n    thread_name = threading.current_thread().name\n    _print_error_line(f\"Uncaught exception in process {process_name} thread {thread_name} (pid {os.getpid()}):\")\n\n\ndef install_excepthook(exit_on_thread_exception: bool = False) -> None:\n    \"\"\"Print error timestamp, traceback, and process/thread info when an uncaught exception occurs.\n\n    Args:\n        exit_on_thread_exception (bool): If True, the process will exit when an uncaught exception occurs in a thread.\n    \"\"\"\n\n    def _excepthook(\n        exc_type: type[BaseException],\n        exc_value: BaseException,\n        exc_tb: TracebackType | None,\n    ) -> None:\n        print_crash_header()\n        sys.__excepthook__(exc_type, exc_value, exc_tb)\n\n    def _thread_excepthook(args: threading.ExceptHookArgs) -> None:\n        print_crash_header()\n        threading.__excepthook__(args)\n        if exit_on_thread_exception:\n            _print_error_line(f\"Aborting process due to uncaught exception in thread {args.thread.name}: {args.exc_value}\")\n            sys.stdout.flush()\n            sys.stderr.flush()\n            os._exit(1)\n\n    sys.excepthook = _excepthook\n    threading.excepthook = _thread_excepthook\n\n\nclass _CrashHeaderProcessMixin(BaseProcess):\n    \"\"\"给子进程崩溃打印头信息，每条路径恰好一次：\n\n    - 主线程崩溃：BaseProcess._bootstrap 用裸 except 拦截 run() 抛出的异常后直接退出，\n      sys.excepthook 不会触发，头信息仅由下面的 except 分支打印；\n    - 子线程崩溃：异常不会传播到 run()，头信息仅由 install_excepthook\n      安装的 threading.excepthook 打印。\n    \"\"\"\n\n    def run(self) -> None:\n        install_excepthook()\n        try:\n            super().run()\n        except SystemExit:\n            raise\n        except BaseException:\n            print_crash_header()\n            raise\n\n\nclass SpawnProcessWithCrashHeader(_CrashHeaderProcessMixin, SpawnProcess):\n    pass\n\n\nclass ForkProcessWithCrashHeader(_CrashHeaderProcessMixin, ForkProcess):\n    pass\n", "file_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8", "evidence_ids": ["ev-30754515034e43628968", "ev-d69c220908cefeeae7f2", "ev-51e2fa3b9fc1aebe86f3"], "delivery": "Originals queued for the next model request; large batches may span requests.", "evidence_scope": "Complete required mechanisms. Full file stays in this Python result and run.log; use read_range/read_symbol for other regions."}}
{"event": "tool_call", "time": 1793847508.6988688, "run_id": "d4db2757396a4dc8862fc4cf32093cae", "seq": 327, "tool": "replace_text_batch", "arguments": {"path": "deepinfer/logger.py", "edits": [{"old_text": "_DATE_FORMAT = \"%m-%d %H:%M:%S\"", "new_text": "_DATE_FORMAT = \"%m-%d %H:%M:%S\"\n_MIN_MESSAGE_CHARS = 32\n_OMITTED_MARK = \"...<omitted>...\""}, {"old_text": "        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:", "new_text": "        use_color: bool = False,\n        *,\n        max_message_chars: int | None = None,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n        if max_message_chars is not None:\n            if isinstance(max_message_chars, bool) or not isinstance(max_message_chars, int):\n                raise ValueError(\n                    f\"max_message_chars must be an int >= {_MIN_MESSAGE_CHARS} or None, \"\n                    f\"got {max_message_chars!r}\"\n                )\n            if max_message_chars < _MIN_MESSAGE_CHARS:\n                raise ValueError(\n                    f\"max_message_chars must be an int >= {_MIN_MESSAGE_CHARS} or None, \"\n                    f\"got {max_message_chars!r}\"\n                )\n        self.max_message_chars = max_message_chars\n\n    def _truncate_message(self, record: logging.LogRecord) -> str | None:\n        \"\"\"返回截断后的消息正文；无需截断时返回 None（不改动 record）。\"\"\"\n        budget = self.max_message_chars\n        if budget is None:\n            return None\n        if getattr(record, \"keep_full_message\", None) is True:\n            return None\n        message = record.getMessage()\n        if len(message) <= budget:\n            return None\n        mark = _OMITTED_MARK\n        remaining = budget - len(mark)\n        if remaining <= 0:\n            return message[:budget]\n        head = -(-remaining // 2)\n        tail = remaining - head\n        head_part = message[:head]\n        tail_part = message[len(message) - tail :] if tail > 0 else \"\"\n        return f\"{head_part}{mark}{tail_part}\"\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:"}, {"old_text": "    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)", "new_text": "    def format(self, record: logging.LogRecord) -> str:\n        truncated = self._truncate_message(record)\n        if truncated is not None:\n            # 复制记录后再格式化，避免改写共享原记录的 msg/args/message\n            record = logging.makeLogRecord(dict(record.__dict__))\n            record.msg = truncated\n            record.args = None\n        msg = super().format(record)"}, {"old_text": "    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )", "new_text": "    from deepinfer.environ import envs\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n        max_message_chars=envs.DEEPINFER_LOG_MAX_MESSAGE_CHARS,\n    )"}], "expected_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8"}}
{"event": "file_write", "time": 1793847508.7093349, "run_id": "d4db2757396a4dc8862fc4cf32093cae", "seq": 328, "path": "deepinfer/logger.py", "content": "# SPDX-License-Identifier: Apache-2.0\n# Derived from vLLM; modified by DeepSeek.\n\n# Adapted from\n# https://github.com/skypilot-org/skypilot/blob/86dc0f6283a335e4aa37b3c10716f90999f48ab6/sky/sky_logging.py\n\"\"\"Logging configuration for DeepInfer.\"\"\"\n\nimport datetime\nimport logging\nimport multiprocessing\nimport os\nimport sys\nimport threading\nimport time\nfrom multiprocessing.context import ForkProcess, SpawnProcess\nfrom multiprocessing.process import BaseProcess\nfrom types import TracebackType\n\n_FORMAT = \"[%(levelname)s %(asctime)s %(filename)s:%(lineno)d] %(message)s\"\n_DATE_FORMAT = \"%m-%d %H:%M:%S\"\n_MIN_MESSAGE_CHARS = 32\n_OMITTED_MARK = \"...<omitted>...\"\n\n# ANSI 颜色（仅在 TTY 输出时使用），按日志级别区分\n_LEVEL_COLORS = {\n    logging.DEBUG: \"\\033[36m\",  # cyan\n    logging.INFO: \"\\033[32m\",  # green\n    logging.WARNING: \"\\033[33m\",  # yellow\n    logging.ERROR: \"\\033[31m\",  # red\n    logging.CRITICAL: \"\\033[1;31m\",  # bold red\n}\n_COLOR_RESET = \"\\033[0m\"\n\n\nclass NewLineFormatter(logging.Formatter):\n    \"\"\"Adds logging prefix to newlines to align multi-line messages, optionally with microsecond precision.\n\n    若 use_color=True 且输出为 TTY，会给日志级别染色（不影响写入文件的纯净度）。\n    \"\"\"\n\n    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n        *,\n        max_message_chars: int | None = None,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n        if max_message_chars is not None:\n            if isinstance(max_message_chars, bool) or not isinstance(max_message_chars, int):\n                raise ValueError(\n                    f\"max_message_chars must be an int >= {_MIN_MESSAGE_CHARS} or None, \"\n                    f\"got {max_message_chars!r}\"\n                )\n            if max_message_chars < _MIN_MESSAGE_CHARS:\n                raise ValueError(\n                    f\"max_message_chars must be an int >= {_MIN_MESSAGE_CHARS} or None, \"\n                    f\"got {max_message_chars!r}\"\n                )\n        self.max_message_chars = max_message_chars\n\n    def _truncate_message(self, record: logging.LogRecord) -> str | None:\n        \"\"\"返回截断后的消息正文；无需截断时返回 None（不改动 record）。\"\"\"\n        budget = self.max_message_chars\n        if budget is None:\n            return None\n        if getattr(record, \"keep_full_message\", None) is True:\n            return None\n        message = record.getMessage()\n        if len(message) <= budget:\n            return None\n        mark = _OMITTED_MARK\n        remaining = budget - len(mark)\n        if remaining <= 0:\n            return message[:budget]\n        head = -(-remaining // 2)\n        tail = remaining - head\n        head_part = message[:head]\n        tail_part = message[len(message) - tail :] if tail > 0 else \"\"\n        return f\"{head_part}{mark}{tail_part}\"\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:\n        if not self.high_precision:\n            # 调用 logging.Formatter 默认实现，保持原来的格式\n            return super().formatTime(record, datefmt)\n        # ===== 高精度模式：在普通 datefmt 基础上附加微秒 =====\n        base = time.strftime(datefmt or _DATE_FORMAT, self.converter(record.created))\n        return f\"{base}.{record.msecs * 1000:06.0f}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        truncated = self._truncate_message(record)\n        if truncated is not None:\n            # 复制记录后再格式化，避免改写共享原记录的 msg/args/message\n            record = logging.makeLogRecord(dict(record.__dict__))\n            record.msg = truncated\n            record.args = None\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg\n\n\n_root_logger = logging.getLogger(\"deepinfer\")\n_default_handler = None\n\n\ndef _setup_logger() -> None:\n    global _default_handler\n    _root_logger.setLevel(logging.DEBUG)\n    if _default_handler is None:\n        _default_handler = logging.StreamHandler(sys.stdout)\n        _default_handler.flush = sys.stdout.flush\n        _default_handler.setLevel(logging.INFO)\n        _root_logger.addHandler(_default_handler)\n\n    from deepinfer.environ import envs\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n        max_message_chars=envs.DEEPINFER_LOG_MAX_MESSAGE_CHARS,\n    )\n    _default_handler.setFormatter(fmt)\n    _root_logger.propagate = False\n\n\n_setup_logger()\n\n\ndef init_logger(name: str) -> logging.Logger:\n    logger = logging.getLogger(name)\n    logger.setLevel(logging.DEBUG)\n    # name 在 \"deepinfer\" 层级下时，通过 propagate 冒泡复用 root logger 的 handler，\n    # 无需自己挂 handler。否则回退到直接挂 handler（避免重复添加）。\n    if name == \"deepinfer\" or name.startswith(\"deepinfer.\"):\n        logger.propagate = True\n    else:\n        logger.propagate = False\n        if _default_handler is not None and _default_handler not in logger.handlers:\n            logger.addHandler(_default_handler)\n    return logger\n\n\ndef _print_error_line(message: str) -> None:\n    now = datetime.datetime.now().strftime(f\"{_DATE_FORMAT}.%f\")\n    print(f\"[ERROR {now}] {message}\", file=sys.stderr, flush=True)\n\n\ndef print_crash_header() -> None:\n    process_name = multiprocessing.current_process().name\n    thread_name = threading.current_thread().name\n    _print_error_line(f\"Uncaught exception in process {process_name} thread {thread_name} (pid {os.getpid()}):\")\n\n\ndef install_excepthook(exit_on_thread_exception: bool = False) -> None:\n    \"\"\"Print error timestamp, traceback, and process/thread info when an uncaught exception occurs.\n\n    Args:\n        exit_on_thread_exception (bool): If True, the process will exit when an uncaught exception occurs in a thread.\n    \"\"\"\n\n    def _excepthook(\n        exc_type: type[BaseException],\n        exc_value: BaseException,\n        exc_tb: TracebackType | None,\n    ) -> None:\n        print_crash_header()\n        sys.__excepthook__(exc_type, exc_value, exc_tb)\n\n    def _thread_excepthook(args: threading.ExceptHookArgs) -> None:\n        print_crash_header()\n        threading.__excepthook__(args)\n        if exit_on_thread_exception:\n            _print_error_line(f\"Aborting process due to uncaught exception in thread {args.thread.name}: {args.exc_value}\")\n            sys.stdout.flush()\n            sys.stderr.flush()\n            os._exit(1)\n\n    sys.excepthook = _excepthook\n    threading.excepthook = _thread_excepthook\n\n\nclass _CrashHeaderProcessMixin(BaseProcess):\n    \"\"\"给子进程崩溃打印头信息，每条路径恰好一次：\n\n    - 主线程崩溃：BaseProcess._bootstrap 用裸 except 拦截 run() 抛出的异常后直接退出，\n      sys.excepthook 不会触发，头信息仅由下面的 except 分支打印；\n    - 子线程崩溃：异常不会传播到 run()，头信息仅由 install_excepthook\n      安装的 threading.excepthook 打印。\n    \"\"\"\n\n    def run(self) -> None:\n        install_excepthook()\n        try:\n            super().run()\n        except SystemExit:\n            raise\n        except BaseException:\n            print_crash_header()\n            raise\n\n\nclass SpawnProcessWithCrashHeader(_CrashHeaderProcessMixin, SpawnProcess):\n    pass\n\n\nclass ForkProcessWithCrashHeader(_CrashHeaderProcessMixin, ForkProcess):\n    pass\n", "before_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8", "file_hash": "19a2f3636e6fff821c6eebff49bc178aa4fa1e60a60c5bbabd5dfa7500074a1f", "changed": true}
