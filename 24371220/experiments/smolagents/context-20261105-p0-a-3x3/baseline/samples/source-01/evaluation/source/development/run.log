{"event": "tool_result", "time": 1793847508.6116428, "run_id": "d4db2757396a4dc8862fc4cf32093cae", "seq": 323, "action": {"tool": "replace_text_batch", "path": "deepinfer/environ.py", "edits": [{"old_text": "    @staticmethod\n    def int_or_none_ge(*, minimum: int) -> EnvVar[int | None]:\n        \"\"\"Optional int parsed with ``int``; unset stays None, values below ``minimum`` are rejected.\"\"\"\n\n        def _init(v: str | None) -> int | None:\n            if v is None:\n                return None\n            value = int(v)\n            if value < minimum:\n                raise ValueError(f\"{v!r} must be >= {minimum}\")\n            return value\n\n        return EnvVar(_init)", "new_text": "    @staticmethod\n    def int_or_none_ge(*, minimum: int, name: str):\n        \"\"\"可选整数配置：未设置时为 None；设置时用 int 解析且不得小于 minimum。\"\"\"\n\n        def _init(v: str | None):\n            if v is None:\n                return None\n            try:\n                value = int(v)\n            except (TypeError, ValueError) as exc:\n                raise ValueError(\n                    f\"{name} must be an integer >= {minimum}, got {v!r}\"\n                ) from exc\n            if value < minimum:\n                raise ValueError(f\"{name} must be an integer >= {minimum}, got {v!r}\")\n            return value\n\n        return EnvVar(_init)"}, {"old_text": "    DEEPINFER_LOG_MAX_MESSAGE_CHARS = EnvVar.int_or_none_ge(minimum=32)", "new_text": "    DEEPINFER_LOG_MAX_MESSAGE_CHARS = EnvVar.int_or_none_ge(\n        minimum=32, name=\"DEEPINFER_LOG_MAX_MESSAGE_CHARS\"\n    )"}], "expected_hash": "e6763ac3f03673b05c866b5cd6942e6e6f47725513e456b70f4fc88847181151"}, "result": {"ok": true, "path": "deepinfer/environ.py", "file_hash": "7022819b244f2f2404ab29929ffa3164e17cb2fb06cbf55a31142287c9b09ad7", "before_hash": "e6763ac3f03673b05c866b5cd6942e6e6f47725513e456b70f4fc88847181151", "changed": true}}
