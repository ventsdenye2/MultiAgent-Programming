{"event": "snapshot", "time": 1793235803.6827214, "run_id": "249581b57a1f4b90a455788f90227d53", "seq": 1, "path": "calc.py", "content": "\"\"\"简单的价格计算模块。\"\"\"\n\nTAX_RATE = 0.13\n\n\ndef add_tax(price):\n    \"\"\"含税价 = 价格 * (1 + 税率)。\"\"\"\n    return price * (1 + TAX_RATE)\n\n\ndef apply_discount(price, discount):\n    \"\"\"打折：discount 为折扣率，如 0.8 表示八折。\"\"\"\n    return price * discount / 100\n\n\ndef total(prices):\n    \"\"\"合计含税总价。\"\"\"\n    return add_tax(sum(prices))\n\n\ndef split_bill(amount, n):\n    \"\"\"n 人 AA，每人应付（保留两位小数）。\"\"\"\n    return round(amount / n, 2)\n"}
