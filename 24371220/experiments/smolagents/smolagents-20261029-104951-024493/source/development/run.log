xin(BaseProcess):\n    \"\"\"给子进程崩溃打印头信息，每条路径恰好一次：\n\n    - 主线程崩溃：BaseProcess._bootstrap 用裸 except 拦截 run() 抛出的异常后直接退出，\n      sys.excepthook 不会触发，头信息仅由下面的 except 分支打印；\n    - 子线程崩溃：异常不会传播到 run()，头信息仅由 install_excepthook\n      安装的 threading.excepthook 打印。\n    \"\"\"\n\n    def run(self) -> None:\n        install_excepthook()\n        try:\n            super().run()\n        except SystemExit:\n            raise\n        except BaseException:\n            print_crash_header()\n            raise\n\n\nclass SpawnProcessWithCrashHeader(_CrashHeaderProcessMixin, SpawnProcess):\n    pass\n\n\nclass ForkProcessWithCrashHeader(_CrashHeaderProcessMixin, ForkProcess):\n    pass\n\nNot fully delivered yet: ev-09ad159a760dde85bd25, ev-5d7d6c21b538b46f40cf. Continue the pending batch; do not reread unchanged sources. Write notes only from originals already received."}]}], "model": "deepseek-flash", "max_tokens": 4096, "response_format": {"type": "json_object"}, "stop": ["Observation:", "Calling tools:"], "thinking": {"type": "disabled"}}, "chars": 28866, "content_chars": 27391, "course_content_chars": 28593}
