= init_logger(__name__)`. The real queue consumer is `_log_worker(q)`: iterates `for msgs in iter(q.get, None)`, sleeps based on `dist.get_rank() % 8`, then `for m in msgs: logger.info(m)` and sets need_sleep = q.empty(); exceptions go to traceback.print_exc(). Producer `_emit_logs` puts msgs list on queue. The only place to add `extra={\"keep_full_message\": True}` is the `logger.info(m)` call inside _log_worker, preserving queue, ordering, sleep, sentinel and exception handling."}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-5d7d6c21b538b46f40cf | deepinfer/logger.py | lines:33-140 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\nclass NewLineFormatter(logging.Formatter):\n    \"\"\"Adds logging prefix to newlines to align multi-line messages, optionally with microsecond precision.\n\n    若 use_color=True 且输出为 TTY，会给日志级别染色（不影响写入文件的纯净度）。\n    \"\"\"\n\n    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:\n        if not self.high_precision:\n            # 调用 logging.Formatter 默认实现，保持原来的格式\n            return super().formatTime(record, datefmt)\n        # ===== 高精度模式：在普通 datefmt 基础上附加微秒 =====\n        base = time.strftime(datefmt or _DATE_FORMAT, self.converter(record.created))\n        return f\"{base}.{record.msecs * 1000:06.0f}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg\n\n\n_root_logger = logging.getLogger(\"deepinfer\")\n_default_handler = None\n\n\ndef _setup_logger() -> None:\n    global _default_handler\n    _root_logger.setLevel(logging.DEBUG)\n    if _default_handler is None:\n        _default_handler = logging.StreamHandler(sys.stdout)\n        _default_handler.flush = sys.stdout.flush\n        _default_handler.setLevel(logging.INFO)\n        _root_logger.addHandler(_default_handler)\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n    _default_handler.setFormatter(fmt)\n    _root_logger.propagate = False\n\n\n_setup_logger()\n\n\ndef init_logger(name: str) -> logging.Logger:\n    logger = logging.getLogger(name)\n    logger.setLevel(logging.DEBUG)\n    # name 在 \"deepinfer\" 层级下时，通过 propagate 冒泡复用 root logger 的 handler，\n    # 无需自己挂 handler。否则回退到直接挂 handler（避免重复添加）。\n    if name == \"deepinfer\" or name.startswith(\"deepinfer.\"):\n        logger.propagate = True\n    else:\n        logger.propagate = False\n        if _default_handler is not None and _default_handler not in logger.handlers:\n            logger.addHandler(_default_handler)\n    return logger\n\n\ndef _print_error_line(message: str) -> None:\n    now = datetime.datetime.now().strftime(f\"{_DATE_FORMAT}.%f\")\n    print(f\"[ERROR {now}] {message}\", file=sys.stderr, flush=True)\n\n\ndef print_crash_header() -> None:\n    process_name = multiprocessing.current_process().name\n    thread_name = threading.current_thread().name\n    _print_error_line(f\"Uncaught exception in process {process_name} thread {thread_name} (pid {os.getpid()}):\")\n\n\ndef install_excepthook(exit_on_thread_exception: bool = False) -> None:\n    \"\"\"Print error timestamp, traceback, and process/thread info when an uncaught exception occurs.\n\n    Args:\n        exit_on_thread_exception (bool): If True, the process will exit when an uncaught exception occurs in a thread.\n    \"\"\"\n\n    def _excepthook(\n        exc_type: type[BaseException],\n        exc_value: BaseException,\n        exc_tb: TracebackType | None,\n    ) -> None:\n        print_crash_header()\n        sys.__excepthook__(exc_type, exc_value, exc_tb)\n\n    def _thread_excepthook(args: threading.ExceptHookArgs) -> None:\n        print_crash_header()\n        threading.__excepthook__(args)\n        if exit_on_thread_exception:\n            _print_error_line(f\"Aborting process due to uncaught exception in thread {args.thread.name}: {args.exc_value}\")\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-ddb5be78a5cf6218d616 | deepinfer/engine/stats_logger.py | lines:116-126 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\ndef _log_worker(q: queue.SimpleQueue[list[str] | None]) -> None:\n    need_sleep = True\n    for msgs in iter(q.get, None):\n        try:\n            if need_sleep:\n                time.sleep((dist.get_rank() % 8) * 0.005)\n            for m in msgs:\n                logger.info(m)\n            need_sleep = q.empty()  # we skip sleep when q has backlog\n        except Exception:\n            traceback.print_exc()"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-c8859274b7c70879ff16 | deepinfer/engine/stats_logger.py | lines:342-344 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\ndef _emit_logs(self, msgs: list[str]) -> None:\n        \"\"\"投递日志到固定 worker 线程，主线程不触碰 logger 的 handler 锁。\"\"\"\n        self._log_queue.put(msgs)"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-5a3c8c1ca1246b61b813 | deepinfer/engine/stats_logger.py | lines:20-20 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\nfrom deepinfer.logger import init_logger"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-5abfdabfb975754c6683 | deepinfer/engine/stats_logger.py | lines:29-29 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\nlogger = init_logger(__name__)"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-30754515034e43628968 | deepinfer/logger.py | lines:33-68 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\nclass NewLineFormatter(logging.Formatter):\n    \"\"\"Adds logging prefix to newlines to align multi-line messages, optionally with microsecond precision.\n\n    若 use_color=True 且输出为 TTY，会给日志级别染色（不影响写入文件的纯净度）。\n    \"\"\"\n\n    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:\n        if not self.high_precision:\n            # 调用 logging.Formatter 默认实现，保持原来的格式\n            return super().formatTime(record, datefmt)\n        # ===== 高精度模式：在普通 datefmt 基础上附加微秒 =====\n        base = time.strftime(datefmt or _DATE_FORMAT, self.converter(record.created))\n        return f\"{base}.{record.msecs * 1000:06.0f}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-51e2fa3b9fc1aebe86f3 | deepinfer/logger.py | lines:96-107 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\ndef init_logger(name: str) -> logging.Logger:\n    logger = logging.getLogger(name)\n    logger.setLevel(logging.DEBUG)\n    # name 在 \"deepinfer\" 层级下时，通过 propagate 冒泡复用 root logger 的 handler，\n    # 无需自己挂 handler。否则回退到直接挂 handler（避免重复添加）。\n    if name == \"deepinfer\" or name.startswith(\"deepinfer.\"):\n        logger.propagate = True\n    else:\n        logger.propagate = False\n        if _default_handler is not None and _default_handler not in logger.handlers:\n            logger.addHandler(_default_handler)\n    return logger"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-d69c220908cefeeae7f2 | deepinfer/logger.py | lines:75-90 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\ndef _setup_logger() -> None:\n    global _default_handler\n    _root_logger.setLevel(logging.DEBUG)\n    if _default_handler is None:\n        _default_handler = logging.StreamHandler(sys.stdout)\n        _default_handler.flush = sys.stdout.flush\n        _default_handler.setLevel(logging.INFO)\n        _root_logger.addHandler(_default_handler)\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n    _default_handler.setFormatter(fmt)\n    _root_logger.propagate = False"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-8d9367024e9cf0226e42 | deepinfer/environ.py | lines:213-221 | sha256=fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218\ndef rearm(name: str) -> None: