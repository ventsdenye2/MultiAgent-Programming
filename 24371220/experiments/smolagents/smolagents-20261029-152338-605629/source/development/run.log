{"event": "context_selection", "time": 1793258744.6006894, "run_id": "56a703b4138f4a6597079dd300a13299", "seq": 110, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-c8859274b7c70879ff16", "ev-ddb5be78a5cf6218d616", "ev-246c6e73a88cb2c9edc3", "ev-ef45633e339c9e5fd82f", "ev-30754515034e43628968", "ev-51e2fa3b9fc1aebe86f3", "ev-d69c220908cefeeae7f2", "ev-f7b42878a3103140179e"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-c8859274b7c70879ff16", 0, 139], ["ev-ddb5be78a5cf6218d616", 0, 408], ["ev-246c6e73a88cb2c9edc3", 0, 145], ["ev-ef45633e339c9e5fd82f", 0, 147], ["ev-30754515034e43628968", 0, 1369], ["ev-51e2fa3b9fc1aebe86f3", 0, 521], ["ev-d69c220908cefeeae7f2", 0, 534], ["ev-f7b42878a3103140179e", 0, 4142]], "estimated_body_chars": 23997, "course_content_chars": 23739, "budget_parts": {"fixed": 12420, "minimum_frame": 13173, "payload_text": 9009}, "reason": "reserve required evidence before expanding recent feedback"}
