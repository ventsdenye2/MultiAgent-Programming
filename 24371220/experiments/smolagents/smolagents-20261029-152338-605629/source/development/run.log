ort TracebackType\n\n_FORMAT = \"[%(levelname)s %(asctime)s %(filename)s:%(lineno)d] %(message)s\"\n_DATE_FORMAT = \"%m-%d %H:%M:%S\"\n\n# ANSI 颜色（仅在 TTY 输出时使用），按日志级别区分\n_LEVEL_COLORS = {\n    logging.DEBUG: \"\\033[36m\",  # cyan\n    logging.INFO: \"\\033[32m\",  # green\n    logging.WARNING: \"\\033[33m\",  # yellow\n    logging.ERROR: \"\\033[31m\",  # red\n    logging.CRITICAL: \"\\033[1;31m\",  # bold red\n}\n_COLOR_RESET = \"\\033[0m\"\n\n\n"}], "tool_calls": null, "raw": null, "token_usage": null}], "tool_calls": [{"id": "call_19", "type": "function", "function": {"name": "python_interpreter", "arguments": "h = \"5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\"\nr = replace_text(\"deepinfer/logger.py\", \"from types import TracebackType\\n\", \"from types import TracebackType\\n\\nfrom deepinfer.environ import envs\\n\", h)\nprint(\"import:\", r.get('changed')); h = r['file_hash']\n\nold_init = '''    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n'''\nnew_init = '''    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n        *,\n        max_message_chars: int | None = None,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n        if max_message_chars is not None:\n            if isinstance(max_message_chars, bool) or not isinstance(max_message_chars, int):\n                raise ValueError(f\"max_message_chars must be None or an int >= 32, got {max_message_chars!r}\")\n            if max_message_chars < 32:\n                raise ValueError(f\"max_message_chars must be None or an int >= 32, got {ma