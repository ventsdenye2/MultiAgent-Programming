+def _truncate_message(message: str, budget: int) -> str:
+    """Keep the head and tail of ``message`` so total length fits ``budget``."""
+    keep = budget - len(_OMITTED_MARKER)
+    head_len = (keep + 1) // 2
+    tail_len = keep - head_len
+    head = message[:head_len]
+    tail = message[len(message) - tail_len:] if tail_len > 0 else ""
+    return f"{head}{_OMITTED_MARKER}{tail}"
+
