ledger.py', 'file_hash': '39f8dad749e876067b10ae9a9e500c22bfb666000b8fdf0ec54f0603fa7ed07c', 'content': '\"\"\"Aggregate a CSV sales ledger.\"\"\"\\n\\nimport csv\\nimport io\\nimport re\\nfrom decimal import Decimal, ROUND_HALF_EVEN, localcontext\\n\\nREQUIRED_COLUMNS = (\"sku\", \"quantity\", \"unit_price\")\\n\\n_INTEGER = re.compile(r\"[+-]?[0-9]+\\\\Z\")\\n_CENT = Decimal(\"0.01\")\\n_PRECISION = 500\\n\\n\\ndef summarize(text):\\n    \"\"\"Aggregate quantities and exact revenue per sku, in first-seen order.\"\"\"\\n    if not isinstance(text, str):\\n        raise ValueError(\"input must be a string\")\\n    if not text:\\n        raise ValueError(\"empty input\")\\n\\n    try:\\n        rows = list(csv.reader(io.StringIO(text, newline=\"\"), strict=True))\\n    except csv.Error as exc:\\n        raise ValueError(\"invalid CSV: %s\" % exc) from None\\n\\n    position = 0\\n    header = None\\n    while position < len(rows):\\n        row = rows[position]\\n        position += 1\\n        if row:\\n            header = row\\n            break\\n    if header is None:\\n        raise ValueError(\"missing header\")\\n\\n    header = [name.strip() for name in header]\\n    if any(name == \"\" for name in header):\\n        raise ValueError(\"empty header name\")\\n    if len(set(header)) != len(header):\\n        raise ValueError(\"duplicate header name\")\\n\\n    missing = [name for name in REQUIRED_COLUMNS if name not in header]\\n    if missing:\\n        raise ValueError(\"missing required columns: %r\" % (missing,))\\n\\n    indices = {name: header.index(name) for name in REQUIRED_COLUMNS}\\n    width = len(header)\\n    order = []\\n    quantities = {}\\n    revenues = {}\\n\\n    with localcontext() as context:\\n        context.prec = _PRECISION\\n        context.rounding = ROUND_HALF_EVEN\\n\\n        for row in rows[position:]:\\n            if not row:\\n                continue\\n            if len(row) != width:\\n                raise ValueError(\"wrong number of cells in data row\")\\n\\n            sku = row[indices[\"sku\"]].strip()\\n            if not sku:\\n                raise ValueError(\"empty sku\")\\n\\n            quantity_text = row[indices[\"quantity\"]].strip()\\n            if not _INTEGER.match(quantity_text):\\n                raise ValueError(\"invalid quantity: %r\" % (quantity_text,))\\n            quantity = int(quantity_text)\\n\\n            price_text = row[indices[\"unit_price\"]].strip()\\n            try:\\n                price = Decimal(price_text)\\n            except Exception:\\n                raise ValueError(\"invalid unit price: %r\" % (price_text,)) from None\\n            if not price.is_finite() or price < 0:\\n                raise ValueError(\"invalid unit price: %r\" % (price_text,))\\n\\n            revenue = price * quantity\\n            if sku in revenues:\\n                quantities[sku] += quantity\\n                revenues[sku] += revenue\\n            else:\\n                quantities[sku] = quantity\\n                revenues[sku] = revenue\\n                order.append(sku)\\n\\n        summary = []\\n        for sku in order:\\n            total = revenues[sku].quantize(_CENT, rounding=ROUND_HALF_EVEN)\\n            if total == 0:\\n                total = Decimal(\"0.00\")\\n            summary.append({\\n                \"sku\": sku,\\n                \"quantity\": quantities[sku],\\n                \"revenue\": str(total),\\n            })\\n    return summary\\n'}</result>\n```\n\nThought: The file looks syntactically complete and implements the requirements. But I should carefully test edge cases before running pytest. Potential issues:\n\n1. CSV parsing: Using `csv.reader(io.StringIO(text, newline=\"\"), strict=True)`. `io.StringIO(text, newline=\"\")` preserves line endings, good. Blank physical lines ignored by csv, csv.reader yields [] for blank lines. We skip empty rows.\n\n2. Header-only input returns []. Our code: rows = [header], position=