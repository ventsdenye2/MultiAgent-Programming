{"event": "snapshot", "time": 1793339231.0678496, "run_id": "abcb9565a83b40ba8914ce91a44c0073", "seq": 1, "path": "words.py", "content": "import re\n\n\ndef word_counts(text):\n    counts = {}\n    for word in re.findall(r'[a-z]+', text.lower()):\n        counts[word] = counts.get(word, 0) + 1\n    return list(counts.items())\n"}
