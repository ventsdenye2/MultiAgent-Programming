 _COLOR_RESET = "\033[0m"
 
 
+_OMITTED_MARKER = "...<omitted>..."
+
+
+def _truncate_message(message: str, max_chars: int) -> str:
+    """按预算截断消息正文：首尾保留原文，中间用固定标记替换，标记计入预算。"""
+    if len(message) <= max_chars:
+        return message
+    budget = max_chars - len(_OMITTED_MARKER)
+    head_len = (budget + 1) // 2
+    tail_len = budget - head_len
+    head = message[:head_len]
+    tail = message[len(message) - tail_len :] if tail_len > 0 else ""
+    return head + _OMITTED_MARKER + tail
+
+
