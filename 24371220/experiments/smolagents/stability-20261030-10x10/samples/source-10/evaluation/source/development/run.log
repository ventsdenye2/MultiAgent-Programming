ool = False,\n        use_color: bool = False,\n        *,\n        max_message_chars: int | None = None,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        if max_message_chars is not None:\n            if isinstance(max_message_chars, bool) or not isinstance(max_message_chars, int):\n                raise ValueError(f\"max_message_chars must be an int or None, got {max_message_chars!r}\")\n            if max_message_chars < 32:\n                raise\nstats hash 554e54ac42df2277016bff89f7ab3deb6cc62af0dc6a89945312751606af5481 keep idx 3514\n    sum_total: int = 0\n    avg_vlen: float = 0.0\n    avg_err: float = 0.0\n    # load balance\n    moe_lb: float = 0.0\n    # cache / scheduler\n    gpu_cache_usage: float = 0.0\n    gpu_state_usage: float = 0.0\n    num_runnings: int = 0\n    num_pendings: int = 0\n    num_chunked: int = 0\n    num_preempted: int = 0\n    num_aborted: int = 0\n    # latency / lengths\n    max_TTFT: float = 0.0\n    mean_TTFT: float = 0.0\n    avg_prompt_len: float = 0.0\n    avg_completion_len: float = 0.0\n    payload_len: float = 0.0\n\n\nclass Window:\n    \"\"\"Sliding window of ``(timestamp, payload, step)`` tuples.\"\"\"\n\n    __slots__ = (\"entries\",)\n\n    def __init__(self) -> None:\n        self.entries: list[tuple[float, object, int]] = []\n\n    def __len__(self) -> int:\n        return len(self.entries)\n\n    def __bool__(self) -> bool:\n        return bool(self.entries)\n\n    def append(self, now: float, payload: object, step: int) -> None:\n        self.entries.append((now, payload, step))\n\n    def trim(self, step: int, max_age: int) -> None:\n        self.entries = [e for e in self.entries if step - e[2] <= max_age]\n\n    def sum(self, key: Callable[[object], float]) -> float:\n        return sum(key(p) for _, p, _ in self.entries)\n\n\ndef _log_worker(q: queue.SimpleQueue[list[str] | None]) -> None:\n    need_sleep = True\n    for msgs in iter(q.get, None):\n        try:\n            if need_sleep:\n                time.sleep((dist.get_rank() % 8) * 0.005)\n            for m in msgs:\n                logger.info(m, extra={\"keep_full_message\": True})\n            need_sleep = q.empty()  # we skip sleep when q has backlog\n        except Exception:\n            traceback.print_exc()\n\n\nclass StatsLogger:\n    \"\"\"Owns all sliding-window data, timing accumulators and logging state.\n\n    The ``engine`` back-reference is used as follows:\n\n    Read-only:\n      - ``scheduler`` (block counts, preempted/aborted, running/pending/ch\nLast output from code snippet:\nNone", "observations_images": null, "action_output": null, "token_usage": {"input_tokens": 9070, "output_tokens": 167, "total_tokens": 9237}, "is_final_answer": false}}
