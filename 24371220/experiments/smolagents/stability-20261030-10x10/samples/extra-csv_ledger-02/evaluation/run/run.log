nts = _round_div_half_even(coefficient, 10 ** (-shift))\n    return _format_cents(cents)\n\n\ndef summarize(text: str) -> list[dict]:\n    try:\n        stream = io.StringIO(text, newline=\"\")\n        reader = csv.reader(stream, strict=True)\n        header = None\n        sku_index = quantity_index = price_index = None\n        states = {}\n        for row in reader:\n            if not row:\n                continue\n            if header is None:\n                header = [cell.strip() for cell in row]\n                if len(set(header)) != len(header):\n                    raise ValueError(\"duplicate header\")\n                try:\n                    sku_index = header.index(\"sku\")\n                    quantity_index = header.index(\"quantity\")\n                    price_index = header.index(\"unit_price\")\n                except ValueError as exc:\n                    raise ValueError(\"missing required header\") from exc\n                continue\n            if len(row) != len(header):\n                raise ValueError(\"record has wrong number of cells\")\n            sku = row[sku_index].strip()\n            if not sku:\n                raise ValueError(\"empty sku\")\n            quantity_text = row[quantity_index].strip()\n            if _QUANTITY_RE.fullmatch(quantity_text) is None:\n                raise ValueError(\"invalid quantity\")\n            quantity = int(quantity_text)\n            price_coefficient, price_exponent = _parse_price(\n                row[price_index].strip()\n            )\n            state = states.get(sku)\n            if state is None:\n                state = [0, {}]\n                states[sku] = state\n            state[0] += quantity\n            product = quantity * price_coefficient\n            terms = state[1]\n            terms[price_exponent] = terms.get(price_exponent, 0) + product\n        if header is None:\n            raise ValueError(\"empty input\")\n    except csv.Error as exc:\n        raise ValueError(\"invalid CSV\") from exc\n\n    result = []\n    for sku, (quantity, terms) in states.items():\n        result.append({\n            \"sku\": sku,\n            \"quantity\": quantity,\n            \"revenue\": _format_revenue(terms),\n        })\n    return result\n"}], "tool_calls": null, "raw": null, "token_usage": null}], "tool_calls": [{"id": "call_9", "type": "function", "function": {"name": "python_interpreter", "arguments": "final_answer(\"Implemented summarize() in ledger.py: CSV parsing with strict header validation (stripped, unique, required sku/quantity/unit_price in any order, extras ignored), exact Decimal-based revenue accumulation with a single ROUND_HALF_EVEN rounding per sku, negative-zero normalization, and ValueError on all invalid input. Full suite passes: 5 passed.\")"}}], "error": null, "model_output_message": {"role": "assistant", "content": "\n\n```python\nfinal_answer(\"Implemented summarize() in ledger.py: CSV parsing with strict header validation (stripped, unique, required sku/quantity/unit_price in any order, extras ignored), exact Decimal-based revenue accumulation with a single ROUND_HALF_EVEN rounding per sku, negative-zero normalization, and ValueError on all invalid input. Full suite passes: 5 passed.\")\n```", "tool_calls": null, "raw": {"_type": "ChatCompletion", "id": "8f1781c6-6c7f-4f22-a3fe-9ec7b6d4150b", "choices": [{"_type": "Choice", "finish_reason": "stop", "index": 0, "logprobs": null, "message": {"_type": "ChatCompletionMessage", "content": "\n\n```python\nfinal_answer(\"Implemented summarize() in ledger.py: CSV parsing with strict header validation (stripped, unique, required sku/quantity/unit_price in any order, extras ignored), exact Decimal-based revenue accumulation with a single ROUND_HALF_EVEN rounding per sku, negative-zero normalization, and ValueError on all invalid input. Full suite passes: 5 passed.\")\n```", "refusal": null, "role": "assistant", "annotations": null, "audio": null, "function_call": nul