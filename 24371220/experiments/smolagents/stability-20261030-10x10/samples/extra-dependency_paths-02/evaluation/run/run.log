ring\")\n    if not value:\n        raise ValueError(\"path must not be empty\")\n    if value.startswith(\"/\"):\n        raise ValueError(\"path must be relative\")\n    if \"\\\\\\\\\" in value:\n        raise ValueError(\"backslashes are not allowed\")\n    if \":\" in value:\n        raise ValueError(\"colons are not allowed\")\n    if \"\\\\x00\" in value:\n        raise ValueError(\"NUL characters are not allowed\")\n\n    components = []\n    for component in value.split(\"/\"):\n        if component == \"\" or component == \".\":\n            continue\n        if component == \"..\":\n            if not components:\n                raise ValueError(\"path escapes the root\")\n            components.pop()\n        else:\n            components.append(component)\n\n    if not components:\n        raise ValueError(\"path must not be empty\")\n    return \"/\".join(components)\n'''\n\ngraph_source = '''from paths import canonical_path\n\n\ndef build_order(graph):\n    if not isinstance(graph, dict):\n        raise TypeError(\"graph must be a dict\")\n\n    items = list(graph.items())\n    for _, dependencies in items:\n        if not isinstance(dependencies, list):\n            raise TypeError(\"dependencies must be a list\")\n\n    dependency_map = {}\n    for key, dependencies in items:\n        node = canonical_path(key)\n        merged = dependency_map.setdefault(node, set())\n        for dependency in dependencies:\n            merged.add(canonical_path(dependency))\n\n    nodes = set(dependency_map)\n    dependents = {node: [] for node in nodes}\n    indegree = {}\n\n    for node, dependencies in dependency_map.items():\n        for dependency in dependencies:\n            if dependency not in nodes:\n                raise ValueError(\"dependency is not a declared node\")\n        indegree[node] = len(dependencies)\n        for dependency in dependencies:\n            dependents[dependency].append(node)\n\n    ready = [node for node in nodes if indegree[n