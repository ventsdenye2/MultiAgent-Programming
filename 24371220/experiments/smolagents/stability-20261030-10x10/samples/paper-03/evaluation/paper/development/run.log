ueue."}, "logprobs": null, "finish_reason": "stop"}], "usage": {"prompt_tokens": 8302, "completion_tokens": 407, "total_tokens": 8709, "prompt_tokens_details": {"cached_tokens": 4224}, "completion_tokens_details": {"reasoning_tokens": 366}, "prompt_cache_hit_tokens": 4224, "prompt_cache_miss_tokens": 4078}, "system_fingerprint": "bc19ba97cbe016479903222bb1578db6"}, "classification": "ok"}
