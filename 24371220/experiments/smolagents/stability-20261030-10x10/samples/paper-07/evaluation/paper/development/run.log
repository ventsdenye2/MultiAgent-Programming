5 <= len(q) <= 1500:\n                if best is None or len(q) < len(best[1]):\n                    best = (p, q)\n        if best is not None:\n            return best\n    return best\n\ndef pick(options):\n    for kws in options:\n        r = find_quote(kws)\n        if r:\n            return r\n    return (0, \"\")\n\nq_cat = pick([[\"reason\", \"act\", \"interact\"], [\"reasoning\", \"acting\", \"interacting\"]])\nq_srch = pick([[\"snowball\", \"Google Scholar\"], [\"snowball\", \"scholar\"]])\nq_sc = pick([[\"Consistency\", \"majority\"], [\"Consistency\", \"vote\"], [\"Consistency\", \"most consistent\"], [\"Consistency\"]])\nq_tot = pick([[\"breadth-first\", \"depth-first\"]])\nq_tf = pick([[\"A range of tools is tested\", \"calendar\"]])\nq_tb = pick([[\"contains 16,464 APIs\"]])\nq_camel = pick([[\"inception prompting\"]])\nq_gen = pick([[\"evaluators\", \"100\"], [\"human evaluators\"]])\nq_ag = pick([[\"Training Data\", \"Hallucination\", \"Agent Behavior\", \"Self reflection\", \"Safety\"],\n             [\"Training Data\", \"Hallucination\", \"Agent Behavior\", \"Safety\"]])\nq_found = pick([[\"reasoning\", \"self-verification\"]])\n\nfor name, (p, q) in [(\"categories\", q_cat), (\"search\", q_srch), (\"selfcons\", q_sc), (\"tot\", q_tot),\n                     (\"toolformer\", q_tf), (\"toolbench\", q_tb), (\"camel\", q_camel),\n                     (\"genagents\", q_gen), (\"agenda\", q_ag), (\"found\", q_found)]:\n    print(\"==\", name, \"page\", p, \"len\", len(q))\n    print(q[:600])\n```\n\n```python\nreport = {\n  \"overview\": \"这是一篇关于 Agentic LLM 的综述（arXiv:2503.23037v3）。作者把 LLM 的能动性拆成三类能力：reason（推理：分解问题、搜索推理路径、自我反思与验证）、act（行动：调用工具与 API、操作网页与计算机、与机器人和科学实验集成）、interact（交互：角色扮演、多智能体协作、社会仿真与博弈），并按此结构组织第 2～4 节，用分类表、方法比较和基准汇总现有工作。第 5 节把三类能力用于科学发现等应用，第 6 节用 Table 4 给出数据、幻觉、行为、自我反思与安全五个研究议题，结论强调推理与自我验证是共同基础。文献以 Google Scholar 起步并用 snowballing 扩展，因此覆盖面广但受检索起点影响。\",\n  \"sections\": [\n    {\n      \"id\": \"overview\",\n      \"summary\": \"作者把 Agent 能力分为 reason、act、interact 三类，第 2～4 节分别按推理、行动、交互整理方法，每节给出分类表和基准对比，并指出三类能力互相依赖。文献组织是先以 Google Scholar 检索 Agentic LLM 相关论文，再用 snowballing 顺着引用关系扩展到首次检索未覆盖的工作，只保留基于 LLM 的方法。局限在于该策略依赖起始关键词与引用网络，可能低估非英文或较新的工作。\",\n      \"application\": \"上次的 agent 已实现分批读页、版本化证据 ID、主题笔记与 pytest 结构校验，但流程固定为单线程顺序，且不会自动回查引文。可借鉴三类划分，把“推理选步—调用工具—多 agent 分工”做成可插拔模块，并让每个结论绑定页码与引文以便核验。\",\n      \"answers\": {\"categories\": [\"reason\", \"act\", \"interact\"], \"search_methods\": [\"google_scholar\", \"snowballing\"]},\n      \"evidence\": [\n        {\"question\": \"categories\", \"page\": q_cat[0], \"quote\": q_cat[1]},\n        {\"question\": \"search_methods\", \"page\": q_srch[0], \"quote\": q_srch[1]}\n      ]\n    },\n    {\n      \"id\": \"reasoning\",\n      \"summary\": \"第 2 节把推理方法分为提示（CoT）、搜索树、自我反思与神经符号等。CoT 是贪心的：只沿看起来最好的一步前进，丢弃其它可能，因此遇到多分支时难以选择正确路径。Self Consistency 针对这一点采样多条推理路径，再用多数投票选出最一致的答案。Tree of Thoughts 把生成提示、评估提示和外部搜索算法组合起来系统探索推理步骤，回溯后尝试替代路径，论文给出广度优先与深度优先两种控制器。代价是需要多次采样或额外搜索，成本更高。\",\n      \"application\": \"我的 agent 目前按固定页批顺序推进，缺少回溯与自检，已有的证据 ID 可用来复核引文。可借鉴 ToT：为“读哪些页、写哪个主题”建立候选并评估，再用多次采样加多数投票确定最终答案字段，减少单次贪心出错。\",\n      \"answers\": {\"self_consistency_selection\": \"majority_vote_for_the_most_consistent_answer\", \"tot_search\": [\"breadth_first\", \"depth_first\"]},\n      \"evidence\": [\n        {\"question\": \"self_consistency_selection\", \"page\": q_sc[0], \"quote\": q_sc[1]},\n        {\"question\": \"tot_search\", \"page\": q_tot[0], \"quote\": q_tot[1]}\n      ]\n    },\n    {\n      \"id\": \"tool_use\",\n      \"summary\": \"第 3 节强调工具使用是 agent 从语言走向外部行动的关键。Toolformer 让模型自监督地学习何时调用哪个 API、传什么参数、如何把返回结果并入后续 token 预测，测试了计算器、问答、搜索引擎、翻译与日历五种工具。ToolBench 基于 RapidAPI 构建含 16,464 个真实 REST API 的大规模数据集，支持训练与评测。同节还比较 Gorilla/APIBench 的 API 调用生成、ToolAlpaca 的合成指令和 EasyTool 的结构化工具文档。局限是错误工具幻觉、参数与返回格式不匹配，需要执行反馈与验证。\",\n      \"application\": \"已实现的是通过 run_command 调用 read_pdf.py 与 pytest、以及文件读写，工具选择仍由我手工决定，没有学习何时调用。可增加显式工具清单与参数校验，保存每次 command_result，失败时读取错误信息并重试，向 Toolformer 式自