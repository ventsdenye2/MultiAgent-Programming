+def _truncate_message(message: str, max_chars: int) -> str:
+    """保留开头与结尾，中间用固定标记替换，标记计入预算。"""
+    remaining = max_chars - len(_OMIT_MARKER)
+    head = (remaining + 1) // 2
+    tail = remaining - head
+    result = message[:head] + _OMIT_MARKER
+    if tail > 0:
+        result += message[-tail:]
+    return result
+
 
