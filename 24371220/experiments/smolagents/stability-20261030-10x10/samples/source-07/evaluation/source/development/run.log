e_chars: int | None = None,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        if max_message_chars is not None and (\n            isinstance(max_message_chars, bool)\n            or not isinstance(max_message_chars, int)\n            or max_message_chars < 32\n        ):\n            raise ValueError(\n                f\"max_message_chars must be None or an int >= 32, got {max_message_chars!r}\"\n            )\n        self.high_precision = high_precision\n        self.use_color = use_color\n        self.max_message_chars = max_message_chars\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:\n        if not self.high_precision:\n            # 调用 logging.Formatter 默认实现，保持原来的格式\n            return super().formatTime(record, datefmt)\n        # ===== 高精度模式：在普通 datefmt 基础上附加微秒 =====\n        base = time.strftime(datefmt or _DATE_FORMAT, self.converter(record.created))\n        return f\"{base}.{record.msecs * 1000:06.0f}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        max_chars = self.max_message_chars\n        if max_chars is None or getattr(record, \"keep_full_message\", None) is True:\n            return self._format_record(record)\n\n        saved_msg = record.msg\n        saved_args = record.args\n        saved_message = record.__dict__.get(\"message\")\n        try:\n            message = record.getMessage()\n            if len(message) > max_chars:\n                record.msg = _truncate_message(message, max_chars)\n                record.args = None\n                record.__dict__.pop(\"message\", None)\n            return self._format_record(record)\n        finally:\n            record.msg = saved_msg\n            record.args = saved_args\n            if saved_message is None:\n                record.__dict__.pop(\"message\", None)\n            else:\n                record.message = saved_message\n\n    def _format_record(self, record: logging.LogRecord) -> str:\n        msg = super