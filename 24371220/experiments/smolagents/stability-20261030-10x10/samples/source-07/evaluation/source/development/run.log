lor:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg\n", "expected_hash": "867df70ad2da166d469b1af19a9cc330e3770a910e7943f7f2c18e4610d2f901"}, "result": {"path": "deepinfer/logger.py", "file_hash": "995bd4b38ac514572e22b00153d7c3c6add17a9a8ae8f7d8fa7af8f2c7f96b03", "before_hash": "867df70ad2da166d469b1af19a9cc330e3770a910e7943f7f2c18e4610d2f901", "changed": true}}
