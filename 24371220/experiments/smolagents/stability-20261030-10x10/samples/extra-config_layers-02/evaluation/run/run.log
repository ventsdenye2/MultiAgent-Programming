ha256=51f595dddddfcb6adcee46251e3cf1b95b66115c6ff3538b040a948933a8f22d\n\"\"\"Build application configuration from defaults, overrides and environ.\"\"\"\n\nimport re\n\nfrom merge import merge_layers\n\n_TIMEOUT_RE = re.compile(r\"\\+?[0-9]+\")\n\n_TRUE_VALUES = frozenset({\"true\", \"1\"})\n_FALSE_VALUES = frozenset({\"false\", \"0\"})\n\n\ndef _parse_timeout(raw):\n    \"\"\"Return a positive int from a decimal ASCII string, else ValueError.\"\"\"\n    if not isinstance(raw, str):\n        raise ValueError(\"APP_TIMEOUT must be a string, got %r\" % (raw,))\n    text = raw.strip()\n    if _TIMEOUT_RE.fullmatch(text) is None:\n        raise ValueError(\"APP_TIMEOUT is not a decimal integer: %r\" % (raw,))\n    value = int(text, 10)\n    if value <= 0:\n        raise ValueError(\"APP_TIMEOUT must be positive, got %r\" % (raw,))\n    return value\n\n\ndef _parse_bool(raw):\n    \"\"\"Return a bool from true/false/1/0 (case-insensitive), else ValueError.\"\"\"\n    if not isinstance(raw, str):\n        raise ValueError(\"APP_DEBUG must be a string, got %r\" % (raw,))\n    text = raw.strip().lower()\n    if text in _TRUE_VALUES:\n        return True\n    if text in _FALSE_VALUES:\n        return False\n    raise ValueError(\"APP_DEBUG must be true/false/1/0, got %r\" % (raw,))\n\n\ndef build_config(defaults, overrides, environ):\n    \"\"\"Merge ``defaults`` and ``overrides``, then apply environment keys.\"\"\"\n    result = merge_layers(defaults, overrides)\n\n    timeout = None\n    if \"APP_TIMEOUT\" in environ:\n        timeout = _parse_timeout(environ[\"APP_TIMEOUT\"])\n\n    debug = None\n    if \"APP_DEBUG\" in environ:\n        debug = _parse_bool(environ[\"APP_DEBUG\"])\n\n    if timeout is not None:\n        network = result.get(\"network\")\n        if network is None:\n            network = {}\n            result[\"network\"] = network\n        elif not isinstance(network, dict):\n            raise ValueError(\n                \"cannot apply APP_TIMEOUT: network is not a dictionary\"\n            )\n        network[\"timeout\"] = timeout\n\n    if debug is not None:\n        result[\"debug\"] = debug\n\n    return result\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-601ccb34a6ac024e9e8f | test_config.py | lines:1-23 | sha256=5e9d84733bc29281268857907e5ffaa7b85e2e8e25249b5d3aeab2d92f535677\nimport pytest\nfrom merge import merge_layers\nfrom settings import build_config\n\n\ndef test_nested_merge_and_independent_tree():\n    first = {'network': {'timeout': 3, 'hosts': ['a']}}\n    result = merge_layers(first, {'network': {'timeout': 5}})\n    assert result == {'network': {'timeout': 5, 'hosts': ['a']}}\n    result['network']['hosts'].append('b')\n    assert first['network']['hosts'] == ['a']\n\n\ndef test_environment_is_last_layer():\n    assert build_config({'network': {'timeout': 2}}, {},\n                        {'APP_TIMEOUT': ' +12 ', 'APP_DEBUG': 'FALSE'}) == {\n                            'network': {'timeout': 12}, 'debug': False}\n\n\n@pytest.mark.parametrize('value', ['0', '-2', '1.2', 'no'])\ndef test_bad_timeout(value):\n    with pytest.raises(ValueError):\n        build_config({}, {}, {'APP_TIMEOUT': value})\n"}], "tool_calls": null, "raw": null, "token_usage": null}], "tool_calls": [{"id": "call_10", "type": "function", "function": {"name": "python_interpreter", "arguments": "old_block = '''    if timeout is not None:\n        network = result.get(\"network\")\n        if network is None:\n            network = {}\n            result[\"network\"] = network\n        elif not isinstance(network, dict):\n            raise ValueError(\n                \"cannot apply APP_TIMEOUT: network is not a dictionary\"\n            )\n        network[\"timeout\"] = timeout'''\n\nnew_block = '''    if timeout is not None:\n        if \"network\" not in result:\n            result[\"network\"] = {}\n        network = result[\"network\"]\n   