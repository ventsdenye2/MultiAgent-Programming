ctionary layers left to right.\\n\\n    Later values win; dictionaries are merged recursively, while lists and\\n    every other value (including ``None``) replace the earlier value.  The\\n    result is a fresh tree that shares no mutable dictionaries or lists with\\n    the inputs, and the inputs are never modified.\\n    \"\"\"\\n    result = {}\\n    for layer in layers:\\n        if not isinstance(layer, dict):\\n            raise TypeError(\\n                \"merge_layers() layers must be dicts, got %s\" % type(layer).__name__\\n            )\\n        _merge_into(result, layer)\\n    return result\\n', 'file_hash': '3c3a1b124cd3f7012fc98dbd654ebf4cee49085c951b5fa7406d96f52efbe1eb', 'evidence_ids': ['ev-9cdd24477bb30af807ea'], 'delivery': 'Originals queued for the next model request; large batches may span requests.'}\n{'path': 'settings.py', 'content': '\"\"\"Build application configuration from defaults, overrides and environ.\"\"\"\\n\\nimport re\\n\\nfrom merge import merge_layers\\n\\n_TIMEOUT_RE = re.compile(r\"\\\\+?[0-9]+\")\\n\\n_TRUE_VALUES = frozenset({\"true\", \"1\"})\\n_FALSE_VALUES = frozenset({\"false\", \"0\"})\\n\\n\\ndef _parse_timeout(raw):\\n    \"\"\"Return a positive int from a decimal ASCII string, else ValueError.\"\"\"\\n    if not isinstance(raw, str):\\n        raise ValueError(\"APP_TIMEOUT must be a string, got %r\" % (raw,))\\n    text = raw.strip()\\n    if _TIMEOUT_RE.fullmatch(text) is None:\\n        raise ValueError(\"APP_TIMEOUT is not a decimal integer: %r\" % (raw,))\\n    value = int(text, 10)\\n    if value <= 0:\\n        raise ValueError(\"APP_TIMEOUT must be positive, got %r\" % (raw,))\\n    return value\\n\\n\\ndef _parse_bool(raw):\\n    \"\"\"Return a bool from true/false/1/0 (case-insensitive), else ValueError.\"\"\"\\n    if not isinstance(raw, str):\\n        raise ValueError(\"APP_DEBUG must be a string, got %r\" % (raw,))\\n    text = raw.strip().lower()\\n    if text in _TRUE_VALUES:\\n        return True\\n    if text in _FALSE_VALUES:\\n        return False\\n    raise ValueError(\"APP_DEBUG must be true/false/1/0, got %r\" % (raw,))\\n\\n\\ndef build_config(defaults, overrides, environ):\\n    \"\"\"Merge ``defaults`` and ``overrides``, then apply environment keys.\"\"\"\\n    result = merge_layers(defaults, overrides)\\n\\n    timeout = None\\n    if \"APP_TIMEOUT\" in environ:\\n        timeout = _parse_timeout(environ[\"APP_TIMEOUT\"])\\n\\n    debug = None\\n    if \"APP_DEBUG\" in environ:\\n        debug = _parse_bool(environ[\"APP_DEBUG\"])\\n\\n    if timeout is not None:\\n        network = result.get(\"network\")\\n        if network is None:\\n            network = {}\\n            result[\"network\"] = network\\n        elif not isinstance(network, dict):\\n            raise ValueError(\\n                \"cannot apply APP_TIMEOUT: network is not a dictionary\"\\n            )\\n        network[\"timeout\"] = timeout\\n\\n    if debug is not None:\\n        result[\"debug\"] = debug\\n\\n    return result\\n', 'file_hash': '51f595dddddfcb6adcee46251e3cf1b95b66115c6ff3538b040a948933a8f22d', 'evidence_ids': ['ev-6baa46952f2c0a93f6f2'], 'delivery': 'Originals queued for the next model request; large batches may span requests.'}\nLast output from code snippet:\nNone", "observations_images": null, "action_output": null, "token_usage": {"input_tokens": 4147, "output_tokens": 283, "total_tokens": 4430}, "is_final_answer": false}}
