ork\"] = network\n        elif not isinstance(network, dict):\n            raise ValueError(\n                \"cannot apply APP_TIMEOUT: network is not a dictionary\"\n            )\n        network[\"timeout\"] = timeout\n\n    if debug is not None:\n        result[\"debug\"] = debug\n\n    return result\n", "file_hash": "51f595dddddfcb6adcee46251e3cf1b95b66115c6ff3538b040a948933a8f22d", "evidence_ids": ["ev-6baa46952f2c0a93f6f2"], "delivery": "Originals queued for the next model request; large batches may span requests."}}
