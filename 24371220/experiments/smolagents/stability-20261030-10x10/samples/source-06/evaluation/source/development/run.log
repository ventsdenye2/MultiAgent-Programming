{"event": "file_read", "time": 1793333480.8365612, "run_id": "4630e9df7ebd4641918f14d18b2fa3a0", "seq": 205, "path": "deepinfer/logger.py", "content": "\n\ndef _print_error_line(message: str) -> None:\n    now = datetime.datetime.now().strftime(f\"{_DATE_FORMAT}.%f\")\n    print(f\"[ERROR {now}] {message}\", file=sys.stderr, flush=True)\n\n\ndef print_crash_header() -> None:\n    process_name = multiprocessing.current_process().name\n    thread_name = threading.current_thread().name\n    _print_error_line(f\"Uncaught exception in process {process_name} thread {thread_name} (pid {os.getpid()}):\")\n\n\ndef install_excepthook(exit_on_thread_exception: bool = False) -> None:\n    \"\"\"Print error timestamp, traceback, and process/thread info when an uncaught exception occurs.\n\n    Args:\n        exit_on_thread_exception (bool): If True, the process will exit when an uncaught exception occurs in a thread.\n    \"\"\"\n\n    def _excepthook(\n        exc_type: type[BaseException],\n        exc_value: BaseException,\n        exc_tb: TracebackType | None,\n    ) -> None:\n        print_crash_header()\n        sys.__excepthook__(exc_type, exc_value, exc_tb)\n\n    def _thread_excepthook(args: threading.ExceptHookArgs) -> None:\n        print_crash_header()\n        threading.__excepthook__(args)\n        if exit_on_thread_exception:\n            _print_error_line(f\"Aborting process due to uncaught exception in thread {args.thread.name}: {args.exc_value}\")\n            sys.stdout.flush()\n            sys.stderr.flush()\n            os._exit(1)\n\n    sys.excepthook = _excepthook\n    threading.excepthook = _thread_excepthook\n\n\nclass _CrashHeaderProcessMixin(BaseProcess):\n    \"\"\"给子进程崩溃打印头信息，每条路径恰好一次：\n\n    - 主线程崩溃：BaseProcess._bootstrap 用裸 except 拦截 run() 抛出的异常后直接退出，\n      sys.excepthook 不会触发，头信息仅由下面的 except 分支打印；\n    - 子线程崩溃：异常不会传播到 run()，头信息仅由 install_excepthook\n      安装的 threading.excepthook 打印。\n    \"\"\"\n\n    def run(self) -> None:\n        install_excepthook()\n        try:\n            super().run()\n        except SystemExit:\n            raise\n        except BaseException:\n            print_crash_header()\n            raise\n\n\nclass SpawnProcessWithCrashHeader(_CrashHeaderProcessMixin, SpawnProcess):\n    pass\n\n\nclass ForkProcessWithCrashHeader(_CrashHeaderProcessMixin, ForkProcess):\n    pass\n", "start_line": 108, "end_line": 174}
{"event": "evidence", "time": 1793333480.8367376, "run_id": "4630e9df7ebd4641918f14d18b2fa3a0", "seq": 206, "id": "ev-855ff2d44d37c875fbb2", "source": "deepinfer/logger.py", "version": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8", "locator": "lines:108-174", "text": "\n\ndef _print_error_line(message: str) -> None:\n    now = datetime.datetime.now().strftime(f\"{_DATE_FORMAT}.%f\")\n    print(f\"[ERROR {now}] {message}\", file=sys.stderr, flush=True)\n\n\ndef print_crash_header() -> None:\n    process_name = multiprocessing.current_process().name\n    thread_name = threading.current_thread().name\n    _print_error_line(f\"Uncaught exception in process {process_name} thread {thread_name} (pid {os.getpid()}):\")\n\n\ndef install_excepthook(exit_on_thread_exception: bool = False) -> None:\n    \"\"\"Print error timestamp, traceback, and process/thread info when an uncaught exception occurs.\n\n    Args:\n        exit_on_thread_exception (bool): If True, the process will exit when an uncaught exception occurs in a thread.\n    \"\"\"\n\n    def _excepthook(\n        exc_type: type[BaseException],\n        exc_value: BaseException,\n        exc_tb: TracebackType | None,\n    ) -> None:\n        print_crash_header()\n        sys.__excepthook__(exc_type, exc_value, exc_tb)\n\n    def _thread_excepthook(args: threading.ExceptHookArgs) -> None:\n        print_crash_header()\n        threading.__excepthook__(args)\n        if exit_on_thread_exception:\n            _print_error_line(f\"Aborting process due to uncaught exception in thread {args.thread.name}: {args.exc_value}\")\n            sys.stdout.flush()\n            sys.stderr.flush()\n            os._exit(1)\n\n    sys.excepthook = _excepthook\n    threading.excepthook = _thread_excepthook\n\n\nclass _CrashHeaderProcessMixin(BaseProcess):\n    \"\"\"给子进程崩溃打印头信息，每条路径恰好一次：\n\n    - 主线程崩溃：BaseProcess._bootstrap 用裸 except 拦截 run() 抛出的异常后直接退出，\n      sys.excepthook 不会触发，头信息仅由下面的 except 分支打印；\n    - 子线程崩溃：异常不会传播到 run()，头信息仅由 install_excepthook\n      安装的 threading.excepthook 打印。\n    \"\"\"\n\n    def run(self) -> None:\n        install_excepthook()\n        try:\n            super().run()\n        except SystemExit:\n            raise\n        except BaseException:\n            print_crash_header()\n            raise\n\n\nclass SpawnProcessWithCrashHeader(_CrashHeaderProcessMixin, SpawnProcess):\n    pass\n\n\nclass ForkProcessWithCrashHeader(_CrashHeaderProcessMixin, ForkProcess):\n    pass\n", "required": false, "page": null, "valid": true, "atomic": true}
{"event": "tool_result", "time": 1793333480.8368459, "run_id": "4630e9df7ebd4641918f14d18b2fa3a0", "seq": 207, "action": {"tool": "read_range", "path": "deepinfer/logger.py", "start_line": 108, "end_line": 180}, "result": {"path": "deepinfer/logger.py", "content": "\n\ndef _print_error_line(message: str) -> None:\n    now = datetime.datetime.now().strftime(f\"{_DATE_FORMAT}.%f\")\n    print(f\"[ERROR {now}] {message}\", file=sys.stderr, flush=True)\n\n\ndef print_crash_header() -> None:\n    process_name = multiprocessing.current_process().name\n    thread_name = threading.current_thread().name\n    _print_error_line(f\"Uncaught exception in process {process_name} thread {thread_name} (pid {os.getpid()}):\")\n\n\ndef install_excepthook(exit_on_thread_exception: bool = False) -> None:\n    \"\"\"Print error timestamp, traceback, and process/thread info when an uncaught exception occurs.\n\n    Args:\n        exit_on_thread_exception (bool): If True, the process will exit when an uncaught exception occurs in a thread.\n    \"\"\"\n\n    def _excepthook(\n        exc_type: type[BaseException],\n        exc_value: BaseException,\n        exc_tb: TracebackType | None,\n    ) -> None:\n        print_crash_header()\n        sys.__excepthook__(exc_type, exc_value, exc_tb)\n\n    def _thread_excepthook(args: threading.ExceptHookArgs) -> None:\n        print_crash_header()\n        threading.__excepthook__(args)\n        if exit_on_thread_exception:\n            _print_error_line(f\"Aborting process due to uncaught exception in thread {args.thread.name}: {args.exc_value}\")\n            sys.stdout.flush()\n            sys.stderr.flush()\n            os._exit(1)\n\n    sys.excepthook = _excepthook\n    threading.excepthook = _thread_excepthook\n\n\nclass _CrashHeaderProcessMixin(BaseProcess):\n    \"\"\"给子进程崩溃打印头信息，每条路径恰好一次：\n\n    - 主线程崩溃：BaseProcess._bootstrap 用裸 except 拦截 run() 抛出的异常后直接退出，\n      sys.excepthook 不会触发，头信息仅由下面的 except 分支打印；\n    - 子线程崩溃：异常不会传播到 run()，头信息仅由 install_excepthook\n      安装的 threading.excepthook 打印。\n    \"\"\"\n\n    def run(self) -> None:\n        install_excepthook()\n        try:\n            super().run()\n        except SystemExit:\n            raise\n        except BaseException:\n            print_crash_header()\n            raise\n\n\nclass SpawnProcessWithCrashHeader(_CrashHeaderProcessMixin, SpawnProcess):\n    pass\n\n\nclass ForkProcessWithCrashHeader(_CrashHeaderProcessMixin, ForkProcess):\n    pass\n", "file_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8", "start_line": 108, "end_line": 174, "evidence_ids": ["ev-855ff2d44d37c875fbb2"], "delivery": "Originals queued for the next model request; large batches may span requests."}}
