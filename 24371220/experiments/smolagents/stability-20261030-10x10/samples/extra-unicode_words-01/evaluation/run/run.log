ord_counts() expects a str, got %r\" % (type(text).__name__,))\n\n    counts: dict[str, int] = {}\n    current: list[str] = []\n\n    def flush() -> None:\n        if current:\n            key = _normalize(\"\".join(current))\n            counts[key] = counts.get(key, 0) + 1\n            del current[:]\n\n    for char in text:\n        category = unicodedata.category(char)\n        major = category[0]\n        if major == \"L\" or major == \"N\":\n            current.append(char)\n        elif major == \"M\":\n            if current:\n                current.append(char)\n            # A mark without an active word is ignored.\n        else:\n            flush()\n\n    flush()\n    return list(counts.items())\n"}]}], "model": "deepseek-flash", "max_tokens": 16384, "reasoning_effort": "high", "stop": ["Observation:", "Calling tools:"], "thinking": {"type": "enabled"}}, "chars": 18704, "content_chars": 17618, "course_content_chars": 18446}
