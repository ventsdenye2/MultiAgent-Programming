{"event": "snapshot", "time": 1793338697.4493895, "run_id": "80c0c4ef6c4e403e96de1f40a4d05a15", "seq": 1, "path": "words.py", "content": "import re\n\n\ndef word_counts(text):\n    counts = {}\n    for word in re.findall(r'[a-z]+', text.lower()):\n        counts[word] = counts.get(word, 0) + 1\n    return list(counts.items())\n"}
