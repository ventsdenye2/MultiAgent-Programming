{"event": "snapshot", "time": 1793338876.889928, "run_id": "84921f509c3141279fa842f364af84bf", "seq": 1, "path": "cache.py", "content": "class TTLCache:\n    def __init__(self, clock):\n        self.clock = clock\n        self.values = {}\n\n    def get(self, key, loader, ttl):\n        if key not in self.values:\n            self.values[key] = loader()\n        return self.values[key]\n\n    def invalidate(self, key):\n        pass\n\n    def clear(self):\n        self.values.clear()\n"}
