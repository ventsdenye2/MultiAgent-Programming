{"event": "model_response", "time": 1793338967.7566407, "run_id": "84921f509c3141279fa842f364af84bf", "seq": 106, "number": 11, "response": {"id": "c63e477b-cca8-44a8-8fdb-9ef5c5568bc8", "object": "chat.completion", "created": 1793338942, "model": "deepseek-flash", "choices": [{"index": 0, "message": {"role": "assistant", "content": "I'll implement the cache with per-key running guards and cancellation tracking for invalidation during loads.\n\n```python\nimport math\n\n\nclass TTLCache:\n    def __init__(self, clock):\n        self.clock = clock\n        self._entries = {}\n        self._running = {}\n\n    @staticmethod\n    def _validate_ttl(ttl):\n        if isinstance(ttl, bool) or not isinstance(ttl, (int, float)):\n            raise ValueError(\"ttl must be a finite nonnegative int or float\")\n        if isinstance(ttl, float) and not math.isfinite(ttl):\n            raise ValueError(\"ttl must be finite\")\n        if ttl < 0:\n            raise ValueError(\"ttl must be nonnegative\")\n        return ttl\n\n    def get(self, key, loader, ttl):\n        self._validate_ttl(ttl)\n\n        if key in self._running:\n            raise RuntimeError(\"recursive get for a key whose loader is running\")\n\n        if ttl > 0 and key in self._entries:\n            value, expires_at = self._entries[key]\n            if self.clock() < expires_at:\n                return value\n\n        load_state = {\"cancelled\": False}\n        self._running[key] = load_state\n        try:\n            value = loader()\n\n            if ttl > 0:\n                expires_at = self.clock() + ttl\n                if not load_state[\"cancelled\"]:\n                    self._entries[key] = (value, expires_at)\n\n            return value\n        finally:\n            del self._running[key]\n\n    def invalidate(self, key):\n        self._entries.pop(key, None)\n        load_state = self._running.get(key)\n        if load_state is not None:\n            load_state[\"cancelled\"] = True\n\