    super().__init__(fmt, datefmt)\n        if max_message_chars is not None and (\n            isinstance(max_message_chars, bool) or not isinstance(max_message_chars, int)\n        ):\n            raise ValueError(f\"max_message_chars must be an int >= 32, got {max_message_chars!r}\")\n        if max_message_chars is not None and max_message_chars < 32:\n            raise ValueError(f\"max_message_chars must be >= 32, got {max_message_chars}\")\n        self.high_precision = high_precision\n        self.use_color = use_color\n        self.max_message_chars = max_message_chars\n'''\nassert lc.count(old_init) == 1\nr = replace_text(\"deepinfer/logger.py\", old_init, new_init, lh)\nprint(\"logger init:\", r); lh = r[\"file_hash\"]\n\nold_fmt = '''    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n'''\nnew_fmt = '''    def _truncate_message(self, message: str) -> str:\n        budget = self.max_message_chars\n        if budget is None or len(message) <= budget:\n            return message\n        marker = self._OMITTED_MARKER\n        remaining = budget - len(marker)\n        if remaining <= 0:\n            return message[:budget]\n        head = (remaining + 1) // 2\n        tail = remaining - head\n        suffix = message[len(message) - tail :] if tail > 0 else \"\"\n        return f\"{message[:head]}{marker}{suffix}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        budget = self.max_message_chars\n        if budget is not None and getattr(record, \"keep_full_message\", None) is not True:\n            message = record.getMessage()\n            if len(message) > budget:\n                # 复制一份记录再截断，绝不改写共享原记录的 msg/args/exc_info/stack_info\n                clone = logging.makeLogRecord(record.__dict__)\n                clone.msg = self._truncate_message(message)\n                clone.args = ()\n                return self._format_record(clone)\n        return self._format_record(record)\n\n    def _format_record(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n'''\nassert lc.count(old_fmt) == 1\nr = replace_text(\"deepinfer/logger.py\", old_fmt, new_fmt, lh)\nprint(\"logger format:\", r); lh = r[\"file_hash\"]\n\nold_setup = '''    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n'''\nnew_setup = '''    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n        max_message_chars=envs.DEEPINFER_LOG_MAX_MESSAGE_CHARS,\n    )\n'''\nassert lc.count(old_setup) == 1\nr = replace_text(\"deepinfer/logger.py\", old_setup, new_setup, lh)\nprint(\"logger setup:\", r); lh = r[\"file_hash\"]\n\n# ---------- stats_logger.py ----------\nsl = read_file(\"deepinfer/engine/stats_logger.py\")\nsc = sl[\"content\"]; sh = sl[\"file_hash\"]\nold_call = '''            for m in msgs:\n                logger.info(m)\n'''\nnew_call = '''            for m in msgs:\n                logger.info(m, extra={\"keep_full_message\": True})\n'''\nassert sc.count(old_call) == 1\nr = replace_text(\"deepinfer/engine/stats_logger.py\", old_call, new_call, sh)\nprint(\"stats edit:\", r); sh = r[\"file_hash\"]\n\n# ---------- verify ----------\nres = run_command([\"python\", \"-m\", \"pytest\", \"-q\"], \".\")\nprint(\"RC:\", res[\"rc\"])\nprint(res[\"stdout\"][-3000:])\nprint(res[\"stderr\"][-2000:])\n```","reasoning_content":"I need to continue. Request budget: only 1 request left after this. I must complete all remaining work in this single action: environ.py is already changed. Need to check the current state of environ.py change, then implement logger.py and stats_logger.py, then run pytest and produce patch/logs.\n\nLet me act efficiently: read the current logger.py fully (again? needed for edit correctness) and stats_logger relevant parts, then write files.\n\nActually the plan says remaining source changes: stats_logger.py, logger.py.