{"event": "context_selection", "time": 1793336546.0995126, "run_id": "778661d3c03543d5abfb23a984b80411", "seq": 199, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-c8859274b7c70879ff16", "ev-ddb5be78a5cf6218d616", "ev-8554ade850ecb397d235", "ev-30754515034e43628968", "ev-a38da4e8688614ec3bcc", "ev-68c0aee2879a48f050cf", "ev-be9f9226635a2df0afc7"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-c8859274b7c70879ff16", 0, 139], ["ev-ddb5be78a5cf6218d616", 0, 408], ["ev-8554ade850ecb397d235", 0, 2072], ["ev-30754515034e43628968", 0, 1369], ["ev-a38da4e8688614ec3bcc", 0, 1137], ["ev-68c0aee2879a48f050cf", 0, 5537], ["ev-be9f9226635a2df0afc7", 0, 2970]], "estimated_body_chars": 30956, "course_content_chars": 30698, "budget_parts": {"fixed": 12782, "minimum_frame": 15340, "payload_text": 15084}, "reason": "reserve required evidence before expanding recent feedback"}
