{"event": "context_selection", "time": 1793336562.4618363, "run_id": "778661d3c03543d5abfb23a984b80411", "seq": 238, "evidence_ids": ["ev-c8859274b7c70879ff16", "ev-ddb5be78a5cf6218d616", "ev-287e8f4d6879ef8cd691", "ev-77ee66e1e43db77e1554", "ev-c4e854ac8709a6d7e134", "ev-30754515034e43628968", "ev-a38da4e8688614ec3bcc", "ev-be9f9226635a2df0afc7", "ev-aa31811a8ad5ebea31bb"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-c8859274b7c70879ff16", 0, 139], ["ev-ddb5be78a5cf6218d616", 0, 408], ["ev-287e8f4d6879ef8cd691", 0, 145], ["ev-77ee66e1e43db77e1554", 0, 2656], ["ev-c4e854ac8709a6d7e134", 0, 147], ["ev-30754515034e43628968", 0, 1369], ["ev-a38da4e8688614ec3bcc", 0, 1137], ["ev-be9f9226635a2df0afc7", 0, 2970], ["ev-aa31811a8ad5ebea31bb", 0, 1061]], "estimated_body_chars": 27234, "course_content_chars": 26976, "budget_parts": {"fixed": 12782, "minimum_frame": 15390, "payload_text": 11405}, "reason": "reserve required evidence before expanding recent feedback"}
