      return None\n92             try:\n93                 value = int(v)\n94             except (TypeError, ValueError) as e:\n95                 raise ValueError(f\"must be an integer >= {minimum}, got {v!r}\") from e\n96             if value < minimum:\n97                 raise ValueError(f\"must be >= {minimum}, got {value}\")\n98             return value\n99 \n100         return EnvVar(_init)\n101 \n102     @staticmethod\n103     def choice(*, default: str | None = None, choices: tuple[str, ...]) -> EnvVar[str | None]:\n104         def _init(v: str | None) -> str | None:\n105             if v is None:\n106                 return default\n107             if v not in choices:\n108                 raise ValueError(f\"{v!r}, must be one of {choices}\")\n109             return v\n110 \n111         return EnvVar(_init)\n112 \n113 \n114 class envs:\n115     \"环境变量的集中定义模块\"\n116 \n117     # -- Platform --\n118     DEEPINFER_ACCELERATOR = EnvVar.str(default=\"nvidia\")\n119 \n120     # -- Runtime --\n121     DEEPINFER_COMPUTE_SUM_SMALLER_PROBS = EnvVar.bool()\n122     DEEPINFER_JIT_CACHE_DIR = EnvVar.str_or_none()\n123 \n124     # -- Distributed Communication --\n125     DEEPINFER_NCCL_NUM_SMS = EnvVar.int(default=32)\n126     DEEPINFER_USERBUFFER_COMM_SMS = EnvVar.int()\n127     DEEPINFER_GLOO_TIMEOUT = EnvVar(lambda v: timedelta(seconds=_float(v, 14400)))\n128     DEEPINFER_REARRANGE_P2P_GROUPS = EnvVar.int(default=1)\n129 \n130     # -- MoE & Expert Parallelism --\n131     DEEPINFER_OVERRIDE_NUM_EXTRA_EXPERTS = EnvVar.int()\n132     DEEPINFER_EXPERT_COUNT_WINDOW_SIZE = EnvVar.int(default=100)\n133     DEEPINFER_EXPERT_REARRANGEMENT_STEP_INTERVAL = EnvVar.int()\n134     DEEPINFER_REARRANGE_AFTER_PREFILL_IN_NORMAL_ENGINE = EnvVar.bool()\n135     DEEPINFER_MOE_LB_STAT_INTERVAL = EnvVar.int(default=128)\n136     DEEPINFER_FORCE_IMBALANCE_RATIO = EnvVar.float()\n137     DEEPINFER_FORCE_LOAD_BALANCE = EnvVar.bool()\n138     DEEPINFER_SHOW_EPLB_DETAIL = EnvVar.bool()\n139 \n140     # -- Attention --\n141     DEEPINFER_PREFILL_MAX_SUM_SEQLEN_K = EnvVar.int_or_none()\n142     \"未设置表示不限制 sum-K；传给 C++ Scheduler 时以 DEFAULT_PREFILL_MAX_SUM_SEQLEN_K 作为等效不限制的封顶值。\"\n143     DEEPINFER_INDEX_ATTN_MEMORY_LIMIT = EnvVar.int(default=10 * 2**30)\n144 \n145     # -- MTP --\n146     DEEPINFER_USE_NEXTN_DECODE = EnvVar.int(default=5)\n147     \"最大支持投机几个；默认 5，显式设为 0 可关闭投机解码\"\n148     DEEPINFER_ENABLE_MTP_VARLEN = EnvVar.bool()\n149     DEEPINFER_MAX_BACKTRACKING_TOKENS = EnvVar(lambda v: max(_int(v), envs.DEEPINFER_USE_NEXTN_DECODE + 1))\n150 \n151     @EnvVar\n152     def DEEPINFER_DFLASH_CONFIDENCE_HEAD_TEMPERATURE(v: str | None) -> float | tuple[float, ...]:\n153         raw = v if v is not None else \"1.0\"\n154         if \",\" in raw:\n155             parts = [float(x.strip()) for x in raw.split(\",\")]\n156             nextn = envs.DEEPINFER_USE_NEXTN_DECODE\n157             if len(parts) != nextn:\n158                 raise ValueError(f\"has {len(parts)} elements ('{raw}') but DEEPINFER_USE_NEXTN_DECODE={nextn}\")\n159             return tuple(parts)\n160         return float(raw)\n161 \n162     # -- Model Loading --\n163     DEEPINFER_ENGRAM_PAD_TOKEN = EnvVar.int(default=2)\n164     DEEPINFER_ENGRAM_FORCE_GPU_STORAGE = EnvVar(lambda v: _bool(v) or envs.DEEPINFER_ACCELERATOR == \"ascend\")\n165 \n166     # -- Sampling --\n167     DEEPINFER_SAMPLER_FORCE_TOPK = EnvVar.int()\n168     DEEPINFER_DECODE_TOKEN_BLACKLIST = EnvVar.str()\n169 \n170     # -- CUDA Graph --\n171     DEEPINFER_ENFORCE_EAGER = EnvVar.bool()\n172     DEEPINFER_CUDAGRAPH_BATCH_SIZE_INTERVAL = EnvVar.int(default=8)\n173     DEEPINFER_DFLASH_ENFORCE_EAGER = EnvVar.bool()\n174     DEEPINFER_DFLASH_CUDAGRAPH_BATCH_SIZE_INTERVAL = EnvVar.int(default=8)\n175     DEEPINFER_DECODE_PERF_CACHE_DIR = EnvVar.str_or_none()\n176     DEEPINFER_DECODE_PERF_CACHE_TTL_SEC = EnvVar.int(default=60 * 60)\n177 \n178     # -- KV Cache Store --\n179     DEEPINFER_NUM_STATE_SLOTS_RATIO = EnvVar.float(default=1.2)\n180     DEEPINFER_PREFILL_STORE_EXTRA_STATE = EnvVar.bool()\n181     DEEPINFER_PREFILL_STORE_EXTRA_SIZE = EnvVar.int(default=128)\n182 \n183     # -- Structured Output --\n184     DEEPINFER_XGRAMMAR_DEBUG = EnvVar.bool()\n185     DEEPINFER_XGRAMMAR_TIMEOUT = EnvVar.int(default=20)\n186     DEEPINFER_XGRAMMAR_DISABLE_CACHE = EnvVar.bool(default=False)\n187     DEEPINFER_XGRAMMAR_CACHE_LIMIT_BYTES = EnvVar.int(default=10 * 1024 * 1024 * 1024)\n188     DEEPINFER_SO_BUILDER_CPUS = EnvVar.int(default=4)\n189 \n190     # -- Scheduling --\n191     DEEPINFER_PREFILL_ATTEMPT_INTERVAL = EnvVar.int(default=70)\n192     \"\"\"NORMAL 引擎 prefill 尝试间隔（ALL 点：全员有活才做，逻辑见 scheduler.hpp _schedule）。\n193     各 rank 在集体 prefill 前累积待处理的 prompt。\"\"\"\n194     DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL = EnvVar.int(default=100)\n195     \"ANY 保底间隔：任一 rank 有活就集体 prefill，孤立 rank 最多等这么多个 decode step\"\n196     DEEPINFER_ZERO_OVERHEAD_SCHEDULING = EnvVar.bool()\n197 \n198     # -- Logging --\n199     DEEPINFER_LOGGING_INTERVAL_STEP = EnvVar.int(default=100)\n200     DEEPINFER_NCCL_MEMORY_SAMPLE_INTERVAL_STEPS = EnvVar.int(default=1000)\n201     DEEPINFER_RINGBUFFER_WARNING_INTERVAL = EnvVar.int(default=60)\n202     DEEPINFER_GC_INTERVAL_STEP = EnvVar.int(default=1000)\n203 \n204     # -- YoCo --\n205     DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE = EnvVar.choice(default=\"off\", choices=(\"off\", \"mask\", \"compact\"))\n206     \"\"\"YoCo consumer prefill 截断模式：off 表示关闭；mask 保留全部 query，仅收窄 SWA\n207     可见域；compact 真正移除截断区 query，以减少 consumer 层计算。\"\"\"\n208     DEEPINFER_YOCO_PREFILL_KEEP_TOKENS = EnvVar.int()\n209     \"\"\"YoCo consumer prefill 截断开启时保留的末尾 query token 数。mask 与 compact 的\n210     SWA 可见域均为原始滑窗和末尾 KEEP_TOKENS 矩形的交集。必须满足 KEEP_TOKENS >=\n211     window_size + DEEPINFER_MAX_BACKTRACKING_TOKENS；默认 0，启用截断时必须显式设置。\"\"\"\n212 \n213     # -- Profiling & Debug --\n214     DEEPINFER_BATCH_INVARIANT = EnvVar.bool()\n215     DEEPINFER_DISABLE_SYNC_GUARD = EnvVar.bool()\n216     \"debug 用：关闭 forbid_cuda_sync 守卫（model forward/sampling launch 期的 CPU-GPU 同步检查）\"\n217     DEEPINFER_PROFILE_TORCH_CUDA_MEMORY = EnvVar.str_or_none()\n218     DEEPINFER_ENABLE_MEMORY_TRACING = EnvVar.bool()\n219     DEEPINFER_PROFILE_HTTP_ENABLE = EnvVar.bool()\n220     DEEPINFER_PROFILE_HTTP_PORT_BASE = EnvVar.int(default=6070)\n221     DEEPINFER_TORCH_PROFILER_DIR = EnvVar.str(default=\"/tmp\")\n222 \n223     # -- Multi-Modal --\n224     DEEPINFER_USE_MULTIMODAL_POOL = EnvVar.bool()\n225     DEEPINFER_MULTIMODAL_POOL_SIZE_GB = EnvVar.int(default=8)\n226     DEEPINFER_MULTI_MODAL_BUFFER_SIZE = EnvVar.int(default=512)\n227     DEEPINFER_MULTI_MODAL_WORKER_TIMEOUT = EnvVar.float(default=1800.0)\n228 \n229 \n230 def rearm(name: str) -> None:\nLast output from code snippet:\nNone", "observations_images": null, "action_output": null, "token_usage": {"input_tokens": 8412, "output_tokens": 206, "total_tokens": 8618}, "is_final_answer": false}}
