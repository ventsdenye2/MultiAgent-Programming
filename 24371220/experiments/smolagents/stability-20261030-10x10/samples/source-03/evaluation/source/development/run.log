{"event": "context_selection", "time": 1793331448.6648512, "run_id": "03fefcc534e844418bad4473b8b79ba9", "seq": 262, "evidence_ids": ["ev-c8859274b7c70879ff16", "ev-b7486e9eebff3503f5ef", "ev-edca04a1acdcf4dd50b9", "ev-d07bedf2ef7ef1847f69", "ev-be34fc081bf8f2be5fed", "ev-7b02902ae721411190da", "ev-83d98e61d75a33a0e94d", "ev-69c43e919e02dd388802", "ev-bae57eeee18761001e03"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-c8859274b7c70879ff16", 0, 139], ["ev-b7486e9eebff3503f5ef", 0, 2072], ["ev-edca04a1acdcf4dd50b9", 0, 3851], ["ev-d07bedf2ef7ef1847f69", 0, 1146], ["ev-be34fc081bf8f2be5fed", 0, 858], ["ev-7b02902ae721411190da", 0, 753], ["ev-83d98e61d75a33a0e94d", 0, 2568], ["ev-69c43e919e02dd388802", 0, 2140], ["ev-bae57eeee18761001e03", 0, 891]], "estimated_body_chars": 31757, "course_content_chars": 31499, "budget_parts": {"fixed": 12654, "minimum_frame": 15356, "payload_text": 15790}, "reason": "reserve required evidence before expanding recent feedback"}
