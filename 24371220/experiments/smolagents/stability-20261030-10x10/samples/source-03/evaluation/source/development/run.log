logger.py\", 33, 110)[\"content\"])\nprint(\"=== stats 108-130 ===\")\nprint(read_range(\"deepinfer/engine/stats_logger.py\", 108, 130)[\"content\"])", "observations": "Execution logs:\nfrom __future__ import annotations\n\nimport os\nimport threading\nfrom collections.abc import Callable\nfrom datetime import timedelta\nfrom typing import Any\n\nDEFAULT_PREFILL_MAX_SUM_SEQLEN_K = 2**30\n\n\ndef _bool(v: str | None, default: str = \"0\") -> bool:\n    return (v if v is not None else default) not in (\"0\", \"\", \"false\", \"False\")\n\n\ndef _int(v: str | None, default: int = 0) -> int:\n    return int(v if v is not None else str(default))\n\n\ndef _float(v: str | None, default: float = 0.0) -> float:\n    return float(v if v is not None else str(default))\n\n\ndef _str(v: str | None, default: str = \"\") -> str:\n    return v if v is not None else default\n\n\n_descriptors: dict[str, EnvVar[Any]] = {}\n\n\n\n=== logger 66-100 ===\nclass NewLineFormatter(logging.Formatter):\n    \"\"\"Adds logging prefix to newlines to align multi-line messages, optionally with microsecond precision.\n\n    若 use_color=True 且输出为 TTY，会给日志级别染色（不影响写入文件的纯净度）。\n    \"\"\"\n\n    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:\n        if not self.high_precision:\n            # 调用 logging.Formatter 默认实现，保持原来的格式\n            return super().formatTime(record, datefmt)\n        # ===== 高精度模式：在普通 datefmt 基础上附加微秒 =====\n        base = time.strftime(datefmt or _DATE_FORMAT, self.converter(record.created))\n        return f\"{base}.{record.msecs * 1000:06.0f}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg\n\n\n_root_logger = logging.getLogger(\"deepinfer\")\n_default_handler = None\n\n\ndef _setup_logger() -> None:\n    global _default_handler\n    _root_logger.setLevel(logging.DEBUG)\n    if _default_handler is None:\n        _default_handler = logging.StreamHandler(sys.stdout)\n        _default_handler.flush = sys.stdout.flush\n        _default_handler.setLevel(logging.INFO)\n        _root_logger.addHandler(_default_handler)\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n    _default_handler.setFormatter(fmt)\n    _root_logger.propagate = False\n\n\n_setup_logger()\n\n\ndef init_logger(name: str) -> logging.Logger:\n    logger = logging.getLogger(name)\n    logger.setLevel(logging.DEBUG)\n    # name 在 \"deepinfer\" 层级下时，通过 propagate 冒泡复用 root logger 的 handler，\n    # 无需自己挂 handler。否则回退到直接挂 handler（避免重复添加）。\n    if name == \"deepinfer\" or name.startswith(\"deepinfer.\"):\n        logger.propagate = True\n    else:\n        logger.propagate = False\n        if _default_handler is not None and _default_handler not in logger.handlers:\n            logger.addHandler(_default_handler)\n    return logger\n\n\ndef _print_error_line(message: str) -> None:\n\n=== stats 108-130 ===\n\n    def trim(self, step: int, max_age: int) -> None:\n        self.entries = [e for e in self.entries if step - e[2] <= max_age]\n\n    def sum(self, key: Callable[[object], float]) -> float:\n        return sum(key(p) for _, p, _ in self.entries)\n\n\ndef _log_worker(q: queue.SimpleQueue[list[str] | None]) -> None:\n    need_sleep = True\n    for msgs in iter(q.get, None):\n        try:\n            if need_sleep:\n                time.sleep((dist.get_rank() % 8) * 0.005)\n            for m in msgs:\n                logger.info(m)\n            need_sleep = q.empty()  # we skip sleep when q has backlog\n        except Exception:\n            traceback.print_exc()\n\n\nclass StatsLogger:\n    \"\"\"Owns all sliding-window data, timing accumulators and logging state.\n\nLast output from code snippet:\nNone", "observations_images": null, "action_output": null, "token_usage": {"input_tokens": 10108, "output_tokens": 3993, "total_tokens": 14101}, "is_final_answer": false}}
