{"event": "context_selection", "time": 1793331434.6067703, "run_id": "03fefcc534e844418bad4473b8b79ba9", "seq": 207, "evidence_ids": ["ev-c8859274b7c70879ff16", "ev-b361e2196f3c4144e055", "ev-b7486e9eebff3503f5ef", "ev-c2ecdf47f0bdb02fdf2a", "ev-be34fc081bf8f2be5fed", "ev-7b02902ae721411190da", "ev-83d98e61d75a33a0e94d", "ev-69c43e919e02dd388802", "ev-bae57eeee18761001e03"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-c8859274b7c70879ff16", 0, 139], ["ev-b361e2196f3c4144e055", 0, 147], ["ev-b7486e9eebff3503f5ef", 0, 2072], ["ev-c2ecdf47f0bdb02fdf2a", 0, 145], ["ev-be34fc081bf8f2be5fed", 0, 858], ["ev-7b02902ae721411190da", 0, 753], ["ev-83d98e61d75a33a0e94d", 0, 2568], ["ev-69c43e919e02dd388802", 0, 2140], ["ev-bae57eeee18761001e03", 0, 891]], "estimated_body_chars": 27581, "course_content_chars": 27323, "budget_parts": {"fixed": 12654, "minimum_frame": 15477, "payload_text": 11088}, "reason": "reserve required evidence before expanding recent feedback"}
