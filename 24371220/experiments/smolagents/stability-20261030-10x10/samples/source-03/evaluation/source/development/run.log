 "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-5a3c8c1ca1246b61b813 | deepinfer/engine/stats_logger.py | lines:20-20 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\nfrom deepinfer.logger import init_logger"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-5abfdabfb975754c6683 | deepinfer/engine/stats_logger.py | lines:29-29 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\nlogger = init_logger(__name__)"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-c8859274b7c70879ff16 | deepinfer/engine/stats_logger.py | lines:342-344 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\ndef _emit_logs(self, msgs: list[str]) -> None:\n        \"\"\"投递日志到固定 worker 线程，主线程不触碰 logger 的 handler 锁。\"\"\"\n        self._log_queue.put(msgs)"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-8554ade850ecb397d235 | deepinfer/environ.py | lines:31-94 | sha256=fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218\nclass EnvVar[T]:\n    \"\"\"Non-data descriptor, resolved on first access\"\"\"\n\n    __slots__ = (\"name\", \"init\", \"lock\")\n\n    def __init__(self, init: Callable[[str | None], T]) -> None:\n        self.init = init\n        self.lock = threading.Lock()\n\n    def __set_name__(self, owner: type[envs], name: str) -> None:\n        self.name = name\n        _descriptors[name] = self\n\n    def __get__(self, instance: envs | None, owner: type[envs]) -> T:\n        with self.lock:\n            cached = owner.__dict__.get(self.name, self)\n            if cached is not self:\n                return cached\n            try:\n                value = self.init(os.getenv(self.name))\n            except Exception as e:  # noqa: BLE001\n                try:\n                    raise type(e)(f\"{self.name}: {e}\") from e\n                except TypeError:\n                    raise e from None\n            setattr(owner, self.name, value)\n            return value\n\n    # -- Factory Methods --\n\n    @staticmethod\n    def int(*, default: int = 0) -> EnvVar[int]:\n        return EnvVar(lambda v: _int(v, default))\n\n    @staticmethod\n    def float(*, default: float = 0.0) -> EnvVar[float]:\n        return EnvVar(lambda v: _float(v, default))\n\n    @staticmethod\n    def bool(*, default: bool = False) -> EnvVar[bool]:\n        return EnvVar(lambda v: _bool(v, \"1\" if default else \"0\"))\n\n    @staticmethod\n    def str(*, default: str = \"\") -> EnvVar[str]:\n        return EnvVar(lambda v: _str(v, default))\n\n    @staticmethod\n    def str_or_none() -> EnvVar[str | None]:\n        return EnvVar(lambda v: v)\n\n    @staticmethod\n    def int_or_none() -> EnvVar[int | None]:\n        return EnvVar(lambda v: int(v) if v is not None else None)\n\n    @staticmethod\n    def choice(*, default: str | None = None, choices: tuple[str, ...]) -> EnvVar[str | None]:\n        def _init(v: str | None) -> str | None:\n            if v is None:\n                return default\n            if v not in choices:\n                raise ValueError(f\"{v!r}, must be one of {choices}\")\n            return v\n\n        return EnvVar(_init)"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-ed2914917db6a069f2c0 | deepinfer/environ.py | lines:1-30 | sha256=fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218\nfrom __future__ import annotations\n\nimport os\nimport threading\nfrom collections.abc import Callable\nfrom datetime import timedelta\nfrom typing import Any\n\nDEFAULT_PREFILL_MAX_SUM_SEQLEN_K = 2**30\n\n\ndef _bool(v: str | None, default: str = \"0\") -> bool:\n    return (v if v is not None else default) not in (\"0\", \"\", \"false\", \"False\")\n\n\ndef _int(v: str | None, default: int = 0) -> int:\n    return int(v if v is not None else str(default))\n\n\ndef _float(v: str | None, default: float = 0.0) -> float:\n    return float(v if v is not None else str(default))\n\n\ndef _str(v: str | None, default: str = \"\") -> str:\n    return v if v is not None else default\n\n\n_descriptors: dict[str, EnvVar[Any]] = {}\n\n\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-83d98e61d75a33a0e94d | deepinfer/logger.py | lines:33-110 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\nclass NewLineFormatter(logging.Formatter):\n    \"\"\"Adds logging prefix to newlines to align multi-line messages, optionally with microsecond precision.\n\n    若 use_color=True 且输出为 TTY，会给日志级别染色（不影响写入文件的纯净度）。\n    \"\"\"\n\n    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:\n        if not self.high_precision:\n            # 调用 logging.Formatter 默认实现，保持原来的格式\n            return super().formatTime(record, datefmt)\n        # ===== 高精度模式：在普通 datefmt 基础上附加微秒 =====\n        base = time.strftime(datefmt or _DATE_FORMAT, self.converter(record.created))\n        return f\"{base}.{record.msecs * 1000:06.0f}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg\n\n\n_root_logger = logging.getLogger(\"deepinfer\")\n_default_handler = None\n\n\ndef _setup_logger() -> None:\n    global _default_handler\n    _root_logger.setLevel(logging.DEBUG)\n    if _default_handler is None:\n        _default_handler = logging.StreamHandler(sys.stdout)\n        _default_handler.flush = sys.stdout.flush\n        _default_handler.setLevel(logging.INFO)\n        _root_logger.addHandler(_default_handler)\n\n    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )\n    _default_handler.setFormatter(fmt)\n    _root_logger.propagate = False\n\n\n_setup_logger()\n\n\ndef init_logger(name: str) -> logging.Logger:\n    logger = logging.getLogger(name)\n    logger.setLevel(logging.DEBUG)\n    # name 在 \"deepinfer\" 层级下时，通过 propagate 冒泡复用 root logger 的 handler，\n    # 无需自己挂 handler。否则回退到直接挂 handler（避免重复添加）。\n    if name == \"deepinfer\" or name.startswith(\"deepinfer.\"):\n        logger.propagate = True\n    else:\n        logger.propagate = False\n        if _default_handler is not None and _default_handler not in logger.handlers:\n            logger.addHandler(_default_handler)\n    return logger\n\n\ndef _print_error_line(message: str) -> None:\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-7b02902ae721411190da | deepinfer/engine/stats_logger.py | lines:108-130 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\n\n    def trim(self, step: int, max_age: int) -> None:\n        self.entries = [e for e in self.entries if step - e[2] <= max_age]\n\n    def sum(self, key: Callable[[object], float]) -> float:\n        return sum(key(p) for _, p, _ in self.entries)\n\n\ndef _log_worker(q: queue.SimpleQueue[list[str] | None]) -> None:\n    need_sleep = True\n    for msgs in iter(q.get, None):\n        try:\n            if need_sleep:\n                time.sleep((dist.get_rank() % 8) * 0.005)\n            for m in msgs:\n                logger.info(m)\n            need_sleep = q.empty()  # we skip sleep when q has backlog\n        except Exception:\n            traceback.print_exc()\n\n\nclass StatsLogger:\n    \"\"\"Owns all sliding-window data, timing accumulators and logging state.\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-ee93143c1ece34eea664 | deepinfer/environ.py | lines:94-221 | sha256=fe2c531989c419f0b51b169a07f5ed826dcec7f95c0c5bc3a351805923c4f218\n        return EnvVar(_init)\n\n\nclass envs:\n    \"环境变量的集中定义模块\"\n\n    # -- Platform --\n    DEEPINFER_ACCELERATOR = EnvVar.str(default=\"nvidia\")\n\n    # -- Runtime --\n    DEEPINFER_COMPUTE_SUM_SMALLER_PROBS = EnvVar.bool()\n    DEEPINFER_JIT_CACHE_DIR = EnvVar.str_or_none()\n\n    # -- Distributed Communication --\n    DEEPINFER_NCCL_NUM_SMS = EnvVar.int(default=32)\n    DEEPINFER_USERBUFFER_COMM_SMS = EnvVar.int()\n    DEEPINFER_GLOO_TIMEOUT = EnvVar(lambda v: timedelta(seconds=_float(v, 14400)))\n    DEEPINFER_REARRANGE_P2P_GROUPS = EnvVar.int(default=1)\n\n    # -- MoE & Expert Parallelism --\n    DEEPINFER_OVERRIDE_NUM_EXTRA_EXPERTS = EnvVar.int()\n    DEEPINFER_EXPERT_COUNT_WINDOW_SIZE = EnvVar.int(default=100)\n    DEEPINFER_EXPERT_REARRANGEMENT_STEP_INTERVAL = EnvVar.int()\n    DEEPINFER_REARRANGE_AFTER_PREFILL_IN_NORMAL_ENGINE = EnvVar.bool()\n    DEEPINFER_MOE_LB_STAT_INTERVAL = EnvVar.int(default=128)\n    DEEPINFER_FORCE_IMBALANCE_RATIO = EnvVar.float()\n    DEEPINFER_FORCE_LOAD_BALANCE = EnvVar.bool()\n    DEEPINFER_SHOW_EPLB_DETAIL = EnvVar.bool()\n\n    # -- Attention --\n    DEEPINFER_PREFILL_MAX_SUM_SEQLEN_K = EnvVar.int_or_none()\n    \"未设置表示不限制 sum-K；传给 C++ Scheduler 时以 DEFAULT_PREFILL_MAX_SUM_SEQLEN_K 作为等效不限制的封顶值。\"\n    DEEPINFER_INDEX_ATTN_MEMORY_LIMIT = EnvVar.int(default=10 * 2**30)\n\n    # -- MTP --\n    DEEPINFER_USE_NEXTN_DECODE = EnvVar.int(default=5)\n    \"最大支持投机几个；默认 5，显式设为 0 可关闭投机解码\"\n    DEEPINFER_ENABLE_MTP_VARLEN = EnvVar.bool()\n    DEEPINFER_MAX_BACKTRACKING_TOKENS = EnvVar(lambda v: max(_int(v), envs.DEEPINFER_USE_NEXTN_DECODE + 1))\n\n    @EnvVar\n    def DEEPINFER_DFLASH_CONFIDENCE_HEAD_TEMPERATURE(v: str | None) -> float | tuple[float, ...]:\n        raw = v if v is not None else \"1.0\"\n        if \",\" in raw:\n            parts = [float(x.strip()) for x in raw.split(\",\")]\n            nextn = envs.DEEPINFER_USE_NEXTN_DECODE\n            if len(parts) != nextn:\n                raise ValueError(f\"has {len(parts)} elements ('{raw}') but DEEPINFER_USE_NEXTN_DECODE={nextn}\")\n            return tuple(parts)\n        return float(raw)\n\n    # -- Model Loading --\n    DEEPINFER_ENGRAM_PAD_TOKEN = EnvVar.int(default=2)\n    DEEPINFER_ENGRAM_FORCE_GPU_STORAGE = EnvVar(lambda v: _bool(v) or envs.DEEPINFER_ACCELERATOR == \"ascend\")\n\n    # -- Sampling --\n    DEEPINFER_SAMPLER_FORCE_TOPK = EnvVar.int()\n    DEEPINFER_DECODE_TOKEN_BLACKLIST = EnvVar.str()\n\n    # -- CUDA Graph --\n    DEEPINFER_ENFORCE_EAGER = EnvVar.bool()\n    DEEPINFER_CUDAGRAPH_BATCH_SIZE_INTERVAL = EnvVar.int(default=8)\n    DEEPINFER_DFLASH_ENFORCE_EAGER = EnvVar.bool()\n    DEEPINFER_DFLASH_CUDAGRAPH_BATCH_SIZE_INTERVAL = EnvVar.int(default=8)\n    DEEPINFER_DECODE_PERF_CACHE_DIR = EnvVar.str_or_none()\n    DEEPINFER_DECODE_PERF_CACHE_TTL_SEC = EnvVar.int(default=60 * 60)\n\n    # -- KV Cache Store --\n    DEEPINFER_NUM_STATE_SLOTS_RATIO = EnvVar.float(default=1.2)\n    DEEPINFER_PREFILL_STORE_EXTRA_STATE = EnvVar.bool()\n    DEEPINFER_PREFILL_STORE_EXTRA_SIZE = EnvVar.int(default=128)\n\n    # -- Structured Output --\n    DEEPINFER_XGRAMMAR_DEBUG = EnvVar.bool()\n    DEEPINFER_XGRAMMAR_TIMEOUT = EnvVar.int(default=20)\n    DEEPINFER_XGRAMMAR_DISABLE_CACHE = EnvVar.bool(default=False)\n    DEEPINFER_XGRAMMAR_CACHE_LIMIT_BYTES = EnvVar.int(default=10 * 1024 * 1024 * 1024)\n    DEEPINFER_SO_BUILDER_CPUS = EnvVar.int(default=4)\n\n    # -- Scheduling --\n    DEEPINFER_PREFILL_ATTEMPT_INTERVAL = EnvVar.int(default=70)\n    \"\"\"NORMAL 引擎 prefill 尝试间隔（ALL 点：全员有活才做，逻辑见 scheduler.hpp _schedule）。\n    各 rank 在集体 prefill 前累积待处理的 prompt。\"\"\"\n    DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL = EnvVar.int(default=100)\n    \"ANY 保底间隔：任一 rank 有活就集体 prefill，孤立 rank 最多等这么多个 decode step\"\n    DEEPINFER_ZERO_OVERHEAD_SCHEDULING = EnvVar.bool()\n\n    # -- Logging --\n    DEEPINFER_LOGGING_INTERVAL_STEP = EnvVar.int(default=100)\n    DEEPINFER_NCCL_MEMORY_SAMPLE_INTERVAL_STEPS = EnvVar.int(default=1000)\n    DEEPINFER_RINGBUFFER_WARNING_INTERVAL = EnvVar.int(default=60)\n    DEEPINFER_GC_INTERVAL_STEP = EnvVar.int(default=1000)\n\n    # -- YoCo --\n    DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE = EnvVar.choice(default=\"off\", choices=(\"off\", \"mask\", \"compact\"))\n    \"\"\"YoCo consumer prefill 截断模式：off 表示关闭；mask 保留全部 query，仅收窄 SWA\n    可见域；compact 真正移除截断区 query，以减少 consumer 层计算。\"\"\"\n    DEEPINFER_YOCO_PREFILL_KEEP_TOKENS = EnvVar.int()\n    \"\"\"YoCo consumer prefill 截断开启时保留的末尾 query token 数。mask 与 compact 的\n    SWA 可见域均为原始滑窗和末尾 KEEP_TOKENS 矩形的交集。必须满足 KEEP_TOKENS >=\n    window_size + DEEPINFER_MAX_BACKTRACKING_TOKENS；默认 0，启用截断时必须显式设置。\"\"\"\n\n    # -- Profiling & Debug --\n    DEEPINFER_BATCH_INVARIANT = EnvVar.bool()\n    DEEPINFER_DISABLE_SYNC_GUARD = EnvVar.bool()\n    \"debug 用：关闭 forbid_cuda_sync 守卫（model forward/sampling launch 期的 CPU-GPU 同步检查）\"\n    DEEPINFER_PROFILE_TORCH_CUDA_MEMORY = EnvVar.str_or_none()\n    DEEPINFER_ENABLE_MEMORY_TRACING = EnvVar.bool()\n    DEEPINFER_PROFILE_HTTP_ENABLE = EnvVar.bool()\n    DEEPINFER_PROFILE_HTTP_PORT_BASE = EnvVar.int(default=6070)\n    DEEPINFER_TORCH_PROFILER_DIR = EnvVar.str(default=\"/tmp\")\n\n    # -- Multi-Modal --\n    DEEPINFER_USE_MULTIMODAL_POOL = EnvVar.bool()\n    DEEPINFER_MULTIMODAL_POOL_SIZE_GB = EnvVar.int(default=8)\n    DEEPINFER_MULTI_MODAL_BUFFER_SIZE = EnvVar.int(default=512)\n    DEEPINFER_MULTI_MODAL_WORKER_TIMEOUT = EnvVar.float(default=1800.0)\n\n\ndef rearm(name: str) -> None:\n    \"\"\"Rearm specific descriptor, will resolve again on next access.\"\"\"\n    setattr(envs, name, _descriptors[name])\n\n\ndef rearm_all() -> None:\n    \"\"\"Rearm all descriptors.\"\"\"\n    for name, descriptor in _descriptors.items():\n        setattr(envs, name, descriptor)\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-69c43e919e02dd388802 | deepinfer/logger.py | lines:107-174 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\n    return logger\n\n\ndef _print_error_line(message: str) -> None:\n    now = datetime.datetime.now().strftime(f\"{_DATE_FORMAT}.%f\")\n    print(f\"[ERROR {now}] {message}\", file=sys.stderr, flush=True)\n\n\ndef print_crash_header() -> None:\n    process_name = multiprocessing.current_process().name\n    thread_name = threading.current_thread().name\n    _print_error_line(f\"Uncaught exception in process {process_name} thread {thread_name} (pid {os.getpid()}):\")\n\n\ndef install_excepthook(exit_on_thread_exception: bool = False) -> None:\n    \"\"\"Print error timestamp, traceback, and process/thread info when an uncaught exception occurs.\n\n    Args:\n        exit_on_thread_exception (bool): If True, the process will exit when an uncaught exception occurs in a thread.\n    \"\"\"\n\n    def _excepthook(\n        exc_type: type[BaseException],\n        exc_value: BaseException,\n        exc_tb: TracebackType | None,\n    ) -> None:\n        print_crash_header()\n        sys.__excepthook__(exc_type, exc_value, exc_tb)\n\n    def _thread_excepthook(args: threading.ExceptHookArgs) -> None:\n        print_crash_header()\n        threading.__excepthook__(args)\n        if exit_on_thread_exception:\n            _print_error_line(f\"Aborting process due to uncaught exception in thread {args.thread.name}: {args.exc_value}\")\n            sys.stdout.flush()\n            sys.stderr.flush()\n            os._exit(1)\n\n    sys.excepthook = _excepthook\n    threading.excepthook = _thread_excepthook\n\n\nclass _CrashHeaderProcessMixin(BaseProcess):\n    \"\"\"给子进程崩溃打印头信息，每条路径恰好一次：\n\n    - 主线程崩溃：BaseProcess._bootstrap 用裸 except 拦截 run() 抛出的异常后直接退出，\n      sys.excepthook 不会触发，头信息仅由下面的 except 分支打印；\n    - 子线程崩溃：异常不会传播到 run()，头信息仅由 install_excepthook\n      安装的 threading.excepthook 打印。\n    \"\"\"\n\n    def run(self) -> None:\n        install_excepthook()\n        try:\n            super().run()\n        except SystemExit:\n            raise\n        except BaseException:\n            print_crash_header()\n            raise\n\n\nclass SpawnProcessWithCrashHeader(_CrashHeaderProcessMixin, SpawnProcess):\n    pass\n\n\nclass ForkProcessWithCrashHeader(_CrashHeaderProcessMixin, ForkProcess):\n    pass\n"}], "tool_calls": null, "raw": null, "token_usage": null}], "tool_calls": [{"id": "call_9", "type": "function", "function": {"name": "python_interpreter", "arguments": "print(read_file(\"deepinfer/logger.py\")[\"content\"][:1200])"}}], "error": null, "model_output_message": {"role": "assistant", "content": "Implementing. First checking logger.py imports.\n\n```python\nprint(read_file(\"deepinfer/logger.py\")[\"content\"][:1200])\n```", "tool_calls": null, "raw": {"_type": "ChatCompletion", "id": "f84bf537-6ed0-4a3f-bf8c-9c151cadb5ec", "choices": [{"_type": "Choice", "finish_reason": "stop", "index": 0, "logprobs": null, "message": {"_type": "ChatCompletionMessage", "content": "Implementing. First checking logger.py imports.\n\n```python\nprint(read_file(\"deepinfer/logger.py\")[\"content\"][:1200])\n```", "refusal": null, "role": "assistant", "annotations": null, "audio": null, "function_call": null, "tool_calls": null}}], "created": 1793331394, "model": "deepseek-flash", "object": "chat.completion", "moderation": null, "service_tier": null, "system_fingerprint": "bc1