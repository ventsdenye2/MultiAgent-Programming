 'locator': 'page:46'}, {'id': 'ev-f03e4b7f1b7fc6e66886', 'source': 'paper.pdf', 'locator': 'page:47'}, {'id': 'ev-aa9b9dbdfec8c640b495', 'source': 'paper.pdf', 'locator': 'page:48'}, {'id': 'ev-6e64db9ec6bfa8f9417f', 'source': 'paper.pdf', 'locator': 'page:49'}, {'id': 'ev-42cada09d7411017eb46', 'source': 'paper.pdf', 'locator': 'page:50'}, {'id': 'ev-99f0f0a37d328bfed1a9', 'source': 'paper.pdf', 'locator': 'page:51'}, {'id': 'ev-01ce8948bcc88d235ea3', 'source': 'paper.pdf', 'locator': 'page:52'}], 'queued': [{'id': 'ev-fdbf1c532c2133190b0f', 'source': 'paper.pdf', 'locator': 'page:45'}, {'id': 'ev-75546d247dedb90561b5', 'source': 'paper.pdf', 'locator': 'page:46'}, {'id': 'ev-f03e4b7f1b7fc6e66886', 'source': 'paper.pdf', 'locator': 'page:47'}, {'id': 'ev-aa9b9dbdfec8c640b495', 'source': 'paper.pdf', 'locator': 'page:48'}, {'id': 'ev-6e64db9ec6bfa8f9417f', 'source': 'paper.pdf', 'locator': 'page:49'}, {'id': 'ev-42cada09d7411017eb46', 'source': 'paper.pdf', 'locator': 'page:50'}, {'id': 'ev-99f0f0a37d328bfed1a9', 'source': 'paper.pdf', 'locator': 'page:51'}, {'id': 'ev-01ce8948bcc88d235ea3', 'source': 'paper.pdf', 'locator': 'page:52'}], 'requested_count': 8, 'queued_count': 8, 'message': 'Queued, not delivered; the selector chooses the actual next batch.'}", "observations_images": null, "action_output": {"requested": [{"id": "ev-fdbf1c532c2133190b0f", "source": "paper.pdf", "locator": "page:45"}, {"id": "ev-75546d247dedb90561b5", "source": "paper.pdf", "locator": "page:46"}, {"id": "ev-f03e4b7f1b7fc6e66886", "source": "paper.pdf", "locator": "page:47"}, {"id": "ev-aa9b9dbdfec8c640b495", "source": "paper.pdf", "locator": "page:48"}, {"id": "ev-6e64db9ec6bfa8f9417f", "source": "paper.pdf", "locator": "page:49"}, {"id": "ev-42cada09d7411017eb46", "source": "paper.pdf", "locator": "page:50"}, {"id": "ev-99f0f0a37d328bfed1a9", "source": "paper.pdf", "locator": "page:51"}, {"id": "ev-01ce8948bcc88d235ea3", "source": "paper.pdf", "locator": "page:52"}], "queued": [{"id":