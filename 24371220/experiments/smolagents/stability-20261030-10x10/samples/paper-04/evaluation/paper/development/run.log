rue, 'atomic': True, 'chars': 1572, 'exposed': True}, {'id': 'ev-731fa63b8d34dde45e62', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:23', 'required': True, 'page': 23, 'valid': True, 'atomic': True, 'chars': 2663, 'exposed': True}, {'id': 'ev-4e747765f5046c8ad8b1', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:24', 'required': True, 'page': 24, 'valid': True, 'atomic': True, 'chars': 4810, 'exposed': True}, {'id': 'ev-daeb56e673fc61cae0ef', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:25', 'required': True, 'page': 25, 'valid': True, 'atomic': True, 'chars': 2858, 'exposed': True}, {'id': 'ev-a30e6edea79391cf315d', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:26', 'required': True, 'page': 26, 'valid': True, 'atomic': True, 'chars': 828, 'exposed': True}, {'id': 'ev-1e23be7c32e2bf283689', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:27', 'required': True, 'page': 27, 'valid': True, 'atomic': True, 'chars': 4748, 'exposed': True}, {'id': 'ev-eb42e63472799e638c3f', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:28', 'required': True, 'page': 28, 'valid': True, 'atomic': True, 'chars': 2758, 'exposed': True}, {'id': 'ev-81117fe71aa5d10b548d', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:29', 'required': True, 'page': 29, 'valid': True, 'atomic': True, 'chars': 3867, 'exposed': True}, {'id': 'ev-97c7764bd93b97111551', 'source': 'paper.pdf', 'version': 'b4767423c79db69ae7138f4c0aed7733af6385e0a370da21ad7d6fe029d7fb8c', 'locator': 'page:30', 'required': True, 'page':