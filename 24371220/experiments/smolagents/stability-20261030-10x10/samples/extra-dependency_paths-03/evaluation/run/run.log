e a dict\")\n\n    dependencies = {}\n    for key, value in graph.items():\n        if not isinstance(value, list):\n            raise TypeError(\"each dependency collection must be a list\")\n        node = canonical_path(key)\n        bucket = dependencies.setdefault(node, set())\n        for dependency in value:\n            bucket.add(canonical_path(dependency))\n\n    for node, required in dependencies.items():\n        for dependency in required:\n            if dependency not in dependencies:\n                raise ValueError(\n                    \"undeclared dependency: {0!r}\".format(dependency)\n                )\n\n    dependents = {}\n    for node in dependencies:\n        dependents[node] = []\n    indegree = {}\n    for node, required in dependencies.items():\n        indegree[node] = len(required)\n        for dependency in required:\n            dependents[dependency].append(node)\n\n    ready = [node for node, count in indegree.items() if count == 0]\n    heapq.heapify(ready)\n\n    order = []\n    while ready:\n        node = heapq.heappop(ready)\n        order.append(node)\n        for dependent in dependents[node]:\n            indegree[dependent] -= 1\n            if indegree[dependent] == 0:\n                heapq.heappush(ready, dependent)\n\n    if len(order) != len(dependencies):\n        raise ValueError(\"cycle detected\")\n\n    return order\n'''\n\nr1 = write_file(path=\"paths.py\", content=paths_src, expected_hash=\"eb9204eaa94220a8136e3c761a8ba290663c147217e89b9e43ac6d2f578a9c47\")\nprint(r1)\nr2 = write_file(path=\"graph.py\", content=graph_src, expected_hash=\"f358f5af1b8edb3869452a86f70fee9485fd94737253e6d6f2c1b735037bc5d1\")\nprint(r2)\n```", "reasoning_content": "Now implement. Update plan, write files.\n\nLet me write paths.py:\n\n```python\ndef canonical_path(value):\n    if not isinstance(value, str):\n        raise TypeError(\"path must be a str\")\n    if value.startswith(\"/\"):\n        raise ValueError(\"path must be rela