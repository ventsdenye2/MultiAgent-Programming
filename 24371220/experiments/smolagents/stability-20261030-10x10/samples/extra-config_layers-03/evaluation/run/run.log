r key, value in base.items()}\n    for key, value in override.items():\n        current = result.get(key)\n        if isinstance(current, dict) and isinstance(value, dict):\n            result[key] = _merge(current, value)\n        else:\n            result[key] = _clone(value)\n    return result\n\n\ndef merge_layers(*layers):\n    \"\"\"Merge dictionary layers from left to right.\n\n    Later values win. Nested dictionaries are merged recursively; lists and\n    every other value (including ``None``) replace the earlier value. The\n    result is an independent tree that shares no mutable containers with the\n    inputs, and the inputs are never modified.\n    \"\"\"\n    result = {}\n    for layer in layers:\n        if not isinstance(layer, dict):\n            raise TypeError(\"every layer must be a dictionary\")\n        result = _merge(result, layer)\n    return result\n'''\n\nwritten_merge = write_file(\n    path=\"merge.py\",\n    content=merge_src,\n    expected_hash=\"3eaf4562abd3d733d69869cdb62d8fcef38def318668bd59672c058d930d026c\",\n)\nprint(written_merge)\nLatest execution feedback:\nExecutor output:\nExecution logs:\n{'path': 'merge.py', 'file_hash': '425a38637179c7643581b962bd799f858423f068ab04903cff7f2a8105a26fee', 'before_hash': '3eaf4562abd3d733d69869cdb62d8fcef38def318668bd59672c058d930d026c', 'changed': True}\nLast output from code snippet:\nNone\nRecent project tool results:\n[{\"tool\":\"read_file\",\"arguments\":{},\"result\":{\"path\":\"test_config.py\",\"file_hash\":\"5e9d84733bc29281268857907e5ffaa7b85e2e8e25249b5d3aeab2d92f535677\"}},{\"tool\":\"run_command\",\"arguments\":{\"argv\":[\"python\",\"-m\",\"pytest\",\"-q\"]},\"result\":{\"rc\":1,\"stderr\":\"\",\"timed_out\":false,\"stdout\":\"_is_last_layer():\\n>       assert build_config({'network': {'timeout': 2}}, {},\\n                            {'APP_TIMEOUT'\\n[full record remains in run.log]\\nOT RAISE <class '...\\nFAILED test_config.py::test_bad_timeout[no] - Failed: DID NOT RAISE 