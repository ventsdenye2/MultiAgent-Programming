+def _int_or_none_min(v: str | None, minimum: int = 32) -> int | None:
+    """Parse an optional int; unset means no limit, otherwise must be >= minimum."""
+    if v is None:
+        return None
+    value = int(v)
+    if value < minimum:
+        raise ValueError(f"{v!r} must be >= {minimum}")
+    return value
 
 
