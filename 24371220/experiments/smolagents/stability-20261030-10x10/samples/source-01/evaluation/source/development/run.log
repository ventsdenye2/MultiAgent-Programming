{"event": "context_selection", "time": 1793329817.4385629, "run_id": "75b3eed396254017a87ede232ab8cd12", "seq": 200, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-c8859274b7c70879ff16", "ev-ddb5be78a5cf6218d616", "ev-068ac042996b3fc6caf1", "ev-2d4ebf1771f8484561b4", "ev-45e7e0c704bf260cd285", "ev-fde3b483c2244100a65a", "ev-6fa4df9bb8cead7d9f20", "ev-a736c9c04cfcb604e1e4"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-c8859274b7c70879ff16", 0, 139], ["ev-ddb5be78a5cf6218d616", 0, 408], ["ev-068ac042996b3fc6caf1", 0, 2072], ["ev-2d4ebf1771f8484561b4", 0, 145], ["ev-45e7e0c704bf260cd285", 0, 147], ["ev-fde3b483c2244100a65a", 0, 437], ["ev-6fa4df9bb8cead7d9f20", 0, 607], ["ev-a736c9c04cfcb604e1e4", 0, 568]], "estimated_body_chars": 21960, "course_content_chars": 21702, "budget_parts": {"fixed": 12820, "minimum_frame": 15490, "payload_text": 6131}, "reason": "reserve required evidence before expanding recent feedback"}
