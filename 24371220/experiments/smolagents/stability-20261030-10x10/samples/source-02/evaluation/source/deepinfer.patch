 _COLOR_RESET = "\033[0m"
 
+# 超长诊断消息的中间省略标记（计入预算）
+_TRUNCATION_MARKER = "...<omitted>..."
+_MIN_MAX_MESSAGE_CHARS = 32
+
+
+def _truncate_message(message: str, budget: int) -> str:
+    """保留开头（向上取整的一半）与末尾，中间用固定标记替换。"""
+    remaining = budget - len(_TRUNCATION_MARKER)
+    head = (remaining + 1) // 2
+    tail = remaining - head
+    truncated = message[:head] + _TRUNCATION_MARKER
+    if tail > 0:
+        truncated += message[len(message) - tail :]
+    return truncated
+
 
