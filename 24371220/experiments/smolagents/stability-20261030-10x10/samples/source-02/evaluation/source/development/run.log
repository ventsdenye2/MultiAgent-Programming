{"event": "context_selection", "time": 1793330554.7357113, "run_id": "caa688ab9a4e4491982756fbdeab0cc2", "seq": 184, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-c8859274b7c70879ff16", "ev-ddb5be78a5cf6218d616", "ev-3f35fc409729643b68cb", "ev-2c9a8e698c8bcf9360fe", "ev-ff0ca5d1a4bdff0e49ff", "ev-3c585e6c22b9e655b567", "ev-f115cc7775d752407a75"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-c8859274b7c70879ff16", 0, 139], ["ev-ddb5be78a5cf6218d616", 0, 408], ["ev-3f35fc409729643b68cb", 0, 2826], ["ev-2c9a8e698c8bcf9360fe", 0, 4090], ["ev-ff0ca5d1a4bdff0e49ff", 0, 497], ["ev-3c585e6c22b9e655b567", 0, 591], ["ev-f115cc7775d752407a75", 0, 421]], "estimated_body_chars": 27965, "course_content_chars": 27760, "budget_parts": {"fixed": 12827, "minimum_frame": 15447, "payload_text": 10430}, "reason": "reserve required evidence before expanding recent feedback"}
