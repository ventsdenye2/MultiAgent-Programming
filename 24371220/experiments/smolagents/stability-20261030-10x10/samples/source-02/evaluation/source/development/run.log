{"event": "context_selection", "time": 1793330563.7903454, "run_id": "caa688ab9a4e4491982756fbdeab0cc2", "seq": 225, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-c8859274b7c70879ff16", "ev-ddb5be78a5cf6218d616", "ev-79a0c58b6c6d98913199", "ev-0e12c830e427b87749a2", "ev-5f3397800d8ea74919e3", "ev-3f35fc409729643b68cb", "ev-2c9a8e698c8bcf9360fe", "ev-ff0ca5d1a4bdff0e49ff"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-c8859274b7c70879ff16", 0, 139], ["ev-ddb5be78a5cf6218d616", 0, 408], ["ev-79a0c58b6c6d98913199", 0, 2023], ["ev-0e12c830e427b87749a2", 0, 1481], ["ev-5f3397800d8ea74919e3", 0, 2264], ["ev-3f35fc409729643b68cb", 0, 2826], ["ev-2c9a8e698c8bcf9360fe", 0, 4090], ["ev-ff0ca5d1a4bdff0e49ff", 0, 497]], "estimated_body_chars": 31318, "course_content_chars": 31060, "budget_parts": {"fixed": 12827, "minimum_frame": 15438, "payload_text": 15329}, "reason": "reserve required evidence before expanding recent feedback"}
