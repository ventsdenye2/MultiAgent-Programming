{"event": "snapshot", "time": 1793339590.713817, "run_id": "97eda67fd8764c0885b0c320d79e117a", "seq": 1, "path": "ledger.py", "content": "import csv\nimport io\n\n\ndef summarize(text):\n    return [{'sku': row['sku'], 'quantity': int(row['quantity']),\n             'revenue': str(float(row['unit_price']) * int(row['quantity']))}\n            for row in csv.DictReader(io.StringIO(text))]\n"}
