{"event": "context_selection", "time": 1793335337.7679389, "run_id": "34a2ea72866642aeaac486f26aec8052", "seq": 126, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-8554ade850ecb397d235", "ev-30754515034e43628968", "ev-b9ca8fffd8da76cf4927", "ev-c182db1a2a105009c479", "ev-57f7a2fe3be4d4618fe5", "ev-68c0aee2879a48f050cf", "ev-ed2914917db6a069f2c0"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-8554ade850ecb397d235", 0, 2072], ["ev-30754515034e43628968", 0, 1369], ["ev-b9ca8fffd8da76cf4927", 0, 1978], ["ev-c182db1a2a105009c479", 0, 1004], ["ev-57f7a2fe3be4d4618fe5", 0, 1994], ["ev-68c0aee2879a48f050cf", 0, 5537], ["ev-ed2914917db6a069f2c0", 0, 694]], "estimated_body_chars": 31635, "course_content_chars": 31377, "budget_parts": {"fixed": 12801, "minimum_frame": 14966, "payload_text": 16101}, "reason": "reserve required evidence before expanding recent feedback"}
