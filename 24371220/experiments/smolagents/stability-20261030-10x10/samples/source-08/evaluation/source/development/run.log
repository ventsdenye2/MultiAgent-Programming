\ndef rearm(name: str) -> None:\n    \"\"\"Rearm specific descriptor, will resolve again on next access.\"\"\"\n    setattr(envs, name, _descriptors[name])\nEvidence ev-c7ff4b5b970258dda761 | deepinfer/environ.py | lines:232-235 | sha256=fda80ed0fd4c705a3f9fcce83ea9b429d70342420506d0dde774fbb747d11878\ndef rearm_all() -> None:\n    \"\"\"Rearm all descriptors.\"\"\"\n    for name, descriptor in _descriptors.items():\n        setattr(envs, name, descriptor)\nEvidence ev-30754515034e43628968 | deepinfer/logger.py | lines:33-68 | sha256=5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8\nclass NewLineFormatter(logging.Formatter):\n    \"\"\"Adds logging prefix to newlines to align multi-line messages, optionally with microsecond precision.\n\n    若 use_color=True 且输出为 TTY，会给日志级别染色（不影响写入文件的纯净度）。\n    \"\"\"\n\n    def __init__(\n        self,\n        fmt: str,\n        datefmt: str | None = None,\n        high_precision: bool = False,\n        use_color: bool = False,\n    ) -> None:\n        super().__init__(fmt, datefmt)\n        self.high_precision = high_precision\n        self.use_color = use_color\n\n    def formatTime(self, record: logging.LogRecord, datefmt: str | None = None) -> str:\n        if not self.high_precision:\n            # 调用 logging.Formatter 默认实现，保持原来的格式\n            return super().formatTime(record, datefmt)\n        # ===== 高精度模式：在普通 datefmt 基础上附加微秒 =====\n        base = time.strftime(datefmt or _DATE_FORMAT, self.converter(record.created))\n        return f\"{base}.{record.msecs * 1000:06.0f}\"\n\n    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\n\", \"\\n\" + prefix)\n        if self.use_color:\n            color = _LEVEL_COLORS.get(record.levelno)\n            if color:\n                msg = f\"{color}{msg}{_COLOR_RESET}\"\n        return msg\nEvidence ev-035afa1a80556899e701 | deepinfer/environ.py | lines:1-140 | sha256=fda80ed0fd4c705a3f9fcce83ea9b429d70342420506d0dde774fbb747d11878\nfrom __future__ import annotations\n\nimport os\nimport threading\nfrom collections.abc import Callable\nfrom datetime import timedelta\nfrom typing import Any\n\nDEFAULT_PREFILL_MAX_SUM_SEQLEN_K = 2**30\n\n\ndef _bool(v: str | None, default: str = \"0\") -> bool:\n    return (v if v is not None else default) not in (\"0\", \"\", \"false\", \"False\")\n\n\ndef _int(v: str | None, default: int = 0) -> int:\n    return int(v if v is not None else str(default))\n\n\ndef _float(v: str | None, default: float = 0.0) -> float:\n    return float(v if v is not None else str(default))\n\n\ndef _str(v: str | None, default: str = \"\") -> str:\n    return v if v is not None else default\n\n\n_descriptors: dict[str, EnvVar[Any]] = {}\n\n\nclass EnvVar[T]:\n    \"\"\"Non-data descriptor, resolved on first access\"\"\"\n\n    __slots__ = (\"name\", \"init\", \"lock\")\n\n    def __init__(self, init: Callable[[str | None], T]) -> None:\n        self.init = init\n        self.lock = threading.Lock()\n\n    def __set_name__(self, owner: type[envs], name: str) -> None:\n        self.name = name\n        _descriptors[name] = self\n\n    def __get__(self, instance: envs | None, owner: type[envs]) -> T:\n        with self.lock:\n            cached = owner.__dict__.get(self.name, self)\n            if cached is not self:\n                return cached\n            try:\n                value = self.init(os.getenv(self.name))\n            except Exception as e:  # noqa: BLE001\n                try:\n                    raise type(e)(f\"{self.name}: {e}\") from e\n                except TypeError:\n                    raise e from None\n            setattr(owner, self.name, value)\n            return value\n\n    # -- Factory Methods --\n\n    @staticmethod\n    def int(*, default: int = 0) -> EnvVar[int]:\n        return EnvVar(lambda v: _int(v, default))\n\n    @staticmethod\n    def float(*, default: float = 0.0) -> EnvVar[float]:\n        return EnvVar(lambda v: _float(v, default))\n\n    @staticmethod\n    def bool(*, default: bool = False) -> EnvVar[bool]:\n        return EnvVar(lambda v: _bool(v, \"1\" if default else \"0\"))\n\n    @staticmethod\n    def str(*, default: str = \"\") -> EnvVar[str]:\n        return EnvVar(lambda v: _str(v, default))\n\n    @staticmethod\n    def str_or_none() -> EnvVar[str | None]:\n        return EnvVar(lambda v: v)\n\n    @staticmethod\n    def int_or_none() -> EnvVar[int | None]:\n        return EnvVar(lambda v: int(v) if v is not None else None)\n\n    @staticmethod\n    def int_or_none_min(*, minimum: int) -> EnvVar[int | None]:\n        def _init(v: str | None) -> int | None:\n            if v is None:\n                return None\n            value = int(v)\n            if value < minimum:\n                raise ValueError(f\"{value!r} must be >= {minimum}\")\n            return value\n\n        return EnvVar(_init)\n\n    @staticmethod\n    def choice(*, default: str | None = None, choices: tuple[str, ...]) -> EnvVar[str | None]:\n        def _init(v: str | None) -> str | None:\n            if v is None:\n                return default\n            if v not in choices:\n                raise ValueError(f\"{v!r}, must be one of {choices}\")\n            return v\n\n        return EnvVar(_init)\n\n\nclass envs:\n    \"环境变量的集中定义模块\"\n\n    # -- Platform --\n    DEEPINFER_ACCELERATOR = EnvVar.str(default=\"nvidia\")\n\n    # -- Runtime --\n    DEEPINFER_COMPUTE_SUM_SMALLER_PROBS = EnvVar.bool()\n    DEEPINFER_JIT_CACHE_DIR = EnvVar.str_or_none()\n\n    # -- Distributed Communication --\n    DEEPINFER_NCCL_NUM_SMS = EnvVar.int(default=32)\n    DEEPINFER_USERBUFFER_COMM_SMS = EnvVar.int()\n    DEEPINFER_GLOO_TIMEOUT = EnvVar(lambda v: timedelta(seconds=_float(v, 14400)))\n    DEEPINFER_REARRANGE_P2P_GROUPS = EnvVar.int(default=1)\n\n    # -- MoE & Expert Parallelism --\n    DEEPINFER_OVERRIDE_NUM_EXTRA_EXPERTS = EnvVar.int()\n    DEEPINFER_EXPERT_COUNT_WINDOW_SIZE = EnvVar.int(default=100)\n    DEEPINFER_EXPERT_REARRANGEMENT_STEP_INTERVAL = EnvVar.int()\n    DEEPINFER_REARRANGE_AFTER_PREFILL_IN_NORMAL_ENGINE = EnvVar.bool()\n    DEEPINFER_MOE_LB_STAT_INTERVAL = EnvVar.int(default=128)\n    DEEPINFER_FORCE_IMBALANCE_RATIO = EnvVar.float()\n    DEEPINFER_FORCE_LOAD_BALANCE = EnvVar.bool()\n    DEEPINFER_SHOW_EPLB_DETAIL = EnvVar.bool()\n\n    # -- Attention --\n    DEEPINFER_PREFILL_MAX_SUM_SEQLEN_K = EnvVar.int_or_none()\n    \"未设置表示不限制 sum-K；传给 C++ Scheduler 时以 DEFAULT_PREFILL_MAX_SUM_SEQLEN_K 作为等效不限制的封顶值。\"\n    DEEPINFER_INDEX_ATTN_MEMORY_LIMIT = EnvVar.int(default=10 * 2**30)\n\n    # -- MTP --\n\nEvidence ev-b9ca8fffd8da76cf4927 | deepinfer/engine/stats_logger.py | lines:320-360 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\n            items.append(f\"state_cache_usage {a.gpu_state_usage * 100:.2f}%\")\n        if self._engine_type == EngineType.NORMAL:\n            prefill_t = cpu_timer.times.get(\"engine_step:prefill\", 0.0)\n            decode_t = cpu_timer.times.get(\"engine_step:decode\", 0.0)\n            total_t = prefill_t + decode_t\n            items.append(f\"prefill/decode {100 * safe_divide(prefill_t, total_t):.2f}%/{100 * safe_divide(decode_t, total_t):.2f}%\")\n        items += [\n            f\"prefill_caching_rate (GPU {gpu_pct * 100:.2f}%)\",\n            f\"TTFT (max {a.max_TTFT:.1f} ms, mean {a.mean_TTFT:.1f} ms)\",\n            f\"avg_length (input {a.avg_prompt_len:.1f}, output {a.avg_completion_len:.1f})\",\n            f\"finished {self._engine.num_finished_completion}\",\n            f\"preempted {a.num_preempted}\",\n            f\"aborted {a.num_aborted}\",\n            f\"sum_seqlen_qxk {s.sum_seqlen_qxk}\",\n            f\"max_seqlen_k {s.max_seqlen_k}\",\n            f\"min_seqlen_k {s.min_seqlen_k}\",\n            f\"attn_TFLOPs {s.attn_tflops:.1f}\",\n            f\"MFU {a.mfu:.3f}\",\n        ]\n        msg = f\"RANK {rank}, GPU {gpu_id}, step {self._engine.generate_step}, [stats] ({' | '.join(items)})\"\n        return [msg, *lines]\n\n    def _emit_logs(self, msgs: list[str]) -> None:\n        \"\"\"投递日志到固定 worker 线程，主线程不触碰 logger 的 handler 锁。\"\"\"\n        self._log_queue.put(msgs)\n\n    def close(self) -> None:\n        \"\"\"写完队列中已投递的日志后停掉 worker 线程；重复调用安全。\"\"\"\n        self._log_queue.put(None)\n        self._log_worker_thread.join()\n\n    # ------------------------------------------------------------------\n    # record / aggregate steps\n    # ------------------------------------------------------------------\n\n    def _record(self, s: StepStats, now: float, gen_tokens: list[int]) -> float:\n        \"\"\"Append per-step records and return batch utilization.\"\"\"\n        step = self._engine.generate_step\n\n        if s.prompt_run:\n            self._prompt_tokens.append(now, s.num_batched_tokens, step)\n\nEvidence ev-c182db1a2a105009c479 | deepinfer/engine/stats_logger.py | lines:100-130 | sha256=9ef93c3930d6dd8d889d4ba69558a85459c2210ae0714d5073c3b4328c8e7cb9\n    def __len__(self) -> int:\n        return len(self.entries)\n\n    def __bool__(self) -> bool:\n        return bool(self.entries)\n\n    def append(self, now: float, payload: object, step: int) -> None:\n        self.entries.append((now, payload, step))\n\n    def trim(self, step: int, max_age: int) -> None:\n        self.entries = [e for e in self.entries if step - e[2] <= max_age]\n\n    def sum(self, key: Callable[[object], float]) -> float:\n        return sum(key(p) for _, p, _ in self.entries)\n\n\ndef _log_worker(q: queue.SimpleQueue[list[str] | None]) -> None:\n    need_sleep = True\n    for msgs in iter(q.get, None):\n        try:\n            if need_sleep:\n                time.sleep((dist.get_rank() % 8) * 0.005)\n            for m in msgs:\n                logger.info(m)\n            need_sleep = q.empty