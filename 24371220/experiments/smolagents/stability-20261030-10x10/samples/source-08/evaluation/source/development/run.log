{"event": "context_selection", "time": 1793335672.04599, "run_id": "34a2ea72866642aeaac486f26aec8052", "seq": 300, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-14a5df2f64c9a607da49", "ev-307c2a63e207cb147021", "ev-f247541668863735f1b7", "ev-2d373a31d658fc958e65", "ev-744c4e83ef7d8bd7fde4", "ev-cc6ef52a9cfaeb6f41f1", "ev-b9ca8fffd8da76cf4927", "ev-c182db1a2a105009c479"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-14a5df2f64c9a607da49", 0, 147], ["ev-307c2a63e207cb147021", 0, 2439], ["ev-f247541668863735f1b7", 0, 145], ["ev-2d373a31d658fc958e65", 0, 1369], ["ev-744c4e83ef7d8bd7fde4", 0, 534], ["ev-cc6ef52a9cfaeb6f41f1", 0, 521], ["ev-b9ca8fffd8da76cf4927", 0, 1978], ["ev-c182db1a2a105009c479", 0, 1004]], "estimated_body_chars": 26328, "course_content_chars": 26070, "budget_parts": {"fixed": 12801, "minimum_frame": 15487, "payload_text": 9742}, "reason": "reserve required evidence before expanding recent feedback"}
