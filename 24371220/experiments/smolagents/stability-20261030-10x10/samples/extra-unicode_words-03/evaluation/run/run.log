{"event": "snapshot", "time": 1793339735.289678, "run_id": "de1a6638123f40aea2c8131048ef9cd4", "seq": 1, "path": "words.py", "content": "import re\n\n\ndef word_counts(text):\n    counts = {}\n    for word in re.findall(r'[a-z]+', text.lower()):\n        counts[word] = counts.get(word, 0) + 1\n    return list(counts.items())\n"}
