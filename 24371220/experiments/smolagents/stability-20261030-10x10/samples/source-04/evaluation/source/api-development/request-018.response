   if max_message_chars < 32:\n                raise ValueError(f\"max_message_chars must be >= 32, got {max_message_chars}\")\n        self.max_message_chars = max_message_chars\n''',\nlg_hash))\n\nprint(replace_text('deepinfer/logger.py',\n'''    def format(self, record: logging.LogRecord) -> str:\n        msg = super().format(record)\n        # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n        if \"\\\\n\" in msg and record.message:\n            prefix = msg[: msg.find(record.message)]\n            msg = msg.replace(\"\\\\n\", \"\\\\n\" + prefix)\n        if self.use_color:\n''',\n'''    def format(self, record: logging.LogRecord) -> str:\n        max_chars = self.max_message_chars\n        truncated = False\n        saved_msg, saved_args = record.msg, record.args\n        saved_message = record.__dict__.get(\"message\", _MISSING)\n        if max_chars is not None and getattr(record, \"keep_full_message\", None) is not True:\n            message = record.getMessage()\n            new_message = _truncate_message(message, max_chars)\n            if new_message != message:\n                # 仅在本次格式化期间替换，避免影响共享记录的其他处理器\n                record.msg = new_message\n                record.args = ()\n                truncated = True\n        try:\n            msg = super().format(record)\n            # 快速路径：单行日志（绝大多数情况）无需做对齐处理\n            if \"\\\\n\" in msg and record.message:\n                prefix = msg[: msg.find(record.message)]\n                msg = msg.replace(\"\\\\n\", \"\\\\n\" + prefix)\n        finally:\n            record.msg, record.args = saved_msg, saved_args\n            if truncated:\n                if saved_message is _MISSING:\n                    record.__dict__.pop(\"message\", None)\n                else:\n                    record.message = saved_message\n        if self.use_color:\n''',\nlg_hash))\n\nprint(replace_text('deepinfer/logger.py',\n'''_COLOR_RESET = \"\\\\033[0m\"\n''',\n'''_COLOR_RESET = \"\\\\033[0m\"\n\n_OMITTED_MARKER = \"...<omitted>...\"\n_MI