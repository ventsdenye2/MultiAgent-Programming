{"event": "file_read", "time": 1793331966.4625554, "run_id": "e7164e6571314ef088dec0a59b6d261c", "seq": 180, "path": "deepinfer/environ.py", "content": "from __future__ import annotations\n\nimport os\nimport threading\nfrom collections.abc import Callable\nfrom datetime import timedelta\nfrom typing import Any\n\nDEFAULT_PREFILL_MAX_SUM_SEQLEN_K = 2**30\n\n\ndef _bool(v: str | None, default: str = \"0\") -> bool:\n    return (v if v is not None else default) not in (\"0\", \"\", \"false\", \"False\")\n\n\ndef _int(v: str | None, default: int = 0) -> int:\n    return int(v if v is not None else str(default))\n\n\ndef _float(v: str | None, default: float = 0.0) -> float:\n    return float(v if v is not None else str(default))\n\n\ndef _str(v: str | None, default: str = \"\") -> str:\n    return v if v is not None else default\n\n\ndef _max_message_chars(v: str | None) -> int | None:\n    if v is None:\n        return None\n    value = int(v)\n    if value < 32:\n        raise ValueError(f\"must be >= 32, got {value}\")\n    return value\n\n\n_descriptors: dict[str, EnvVar[Any]] = {}\n\n\nclass EnvVar[T]:\n", "start_line": 1, "end_line": 40}
{"event": "evidence", "time": 1793331966.4627216, "run_id": "e7164e6571314ef088dec0a59b6d261c", "seq": 181, "id": "ev-b54162483f5212403b9c", "source": "deepinfer/environ.py", "version": "8e29b3acf73f0a14586a4ed44fee55734d36143d1c57bcab17c6d00e839572e3", "locator": "lines:1-40", "text": "from __future__ import annotations\n\nimport os\nimport threading\nfrom collections.abc import Callable\nfrom datetime import timedelta\nfrom typing import Any\n\nDEFAULT_PREFILL_MAX_SUM_SEQLEN_K = 2**30\n\n\ndef _bool(v: str | None, default: str = \"0\") -> bool:\n    return (v if v is not None else default) not in (\"0\", \"\", \"false\", \"False\")\n\n\ndef _int(v: str | None, default: int = 0) -> int:\n    return int(v if v is not None else str(default))\n\n\ndef _float(v: str | None, default: float = 0.0) -> float:\n    return float(v if v is not None else str(default))\n\n\ndef _str(v: str | None, default: str = \"\") -> str:\n    return v if v is not None else default\n\n\ndef _max_message_chars(v: str | None) -> int | None:\n    if v is None:\n        return None\n    value = int(v)\n    if value < 32:\n        raise ValueError(f\"must be >= 32, got {value}\")\n    return value\n\n\n_descriptors: dict[str, EnvVar[Any]] = {}\n\n\nclass EnvVar[T]:\n", "required": false, "page": null, "valid": true, "atomic": true}
{"event": "tool_result", "time": 1793331966.4628196, "run_id": "e7164e6571314ef088dec0a59b6d261c", "seq": 182, "action": {"tool": "read_range", "path": "deepinfer/environ.py", "start_line": 1, "end_line": 40}, "result": {"path": "deepinfer/environ.py", "content": "from __future__ import annotations\n\nimport os\nimport threading\nfrom collections.abc import Callable\nfrom datetime import timedelta\nfrom typing import Any\n\nDEFAULT_PREFILL_MAX_SUM_SEQLEN_K = 2**30\n\n\ndef _bool(v: str | None, default: str = \"0\") -> bool:\n    return (v if v is not None else default) not in (\"0\", \"\", \"false\", \"False\")\n\n\ndef _int(v: str | None, default: int = 0) -> int:\n    return int(v if v is not None else str(default))\n\n\ndef _float(v: str | None, default: float = 0.0) -> float:\n    return float(v if v is not None else str(default))\n\n\ndef _str(v: str | None, default: str = \"\") -> str:\n    return v if v is not None else default\n\n\ndef _max_message_chars(v: str | None) -> int | None:\n    if v is None:\n        return None\n    value = int(v)\n    if value < 32:\n        raise ValueError(f\"must be >= 32, got {value}\")\n    return value\n\n\n_descriptors: dict[str, EnvVar[Any]] = {}\n\n\nclass EnvVar[T]:\n", "file_hash": "8e29b3acf73f0a14586a4ed44fee55734d36143d1c57bcab17c6d00e839572e3", "start_line": 1, "end_line": 40, "evidence_ids": ["ev-b54162483f5212403b9c"], "delivery": "Originals queued for the next model request; large batches may span requests."}}
