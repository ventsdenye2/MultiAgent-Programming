{"event": "context_selection", "time": 1793331960.4934769, "run_id": "e7164e6571314ef088dec0a59b6d261c", "seq": 145, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-c8859274b7c70879ff16", "ev-ddb5be78a5cf6218d616", "ev-b3c23dc80d8c1f834ab8", "ev-30754515034e43628968", "ev-cb73e56207c8fdba454f", "ev-5bdfb5e7e74d9e5ad19b", "ev-bae57eeee18761001e03"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-c8859274b7c70879ff16", 0, 139], ["ev-ddb5be78a5cf6218d616", 0, 408], ["ev-b3c23dc80d8c1f834ab8", 0, 2072], ["ev-30754515034e43628968", 0, 1369], ["ev-cb73e56207c8fdba454f", 0, 5537], ["ev-5bdfb5e7e74d9e5ad19b", 0, 1589], ["ev-bae57eeee18761001e03", 0, 891]], "estimated_body_chars": 29570, "course_content_chars": 29312, "budget_parts": {"fixed": 12765, "minimum_frame": 15116, "payload_text": 13459}, "reason": "reserve required evidence before expanding recent feedback"}
