{"event": "context_selection", "time": 1793332024.0381632, "run_id": "e7164e6571314ef088dec0a59b6d261c", "seq": 277, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-c8859274b7c70879ff16", "ev-ddb5be78a5cf6218d616", "ev-12702b75d45dae1d10d9", "ev-13ffbc51b4c0029a5ac5", "ev-29c91f35a0bd221491d8", "ev-2d373a31d658fc958e65", "ev-744c4e83ef7d8bd7fde4", "ev-cc6ef52a9cfaeb6f41f1"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-c8859274b7c70879ff16", 0, 139], ["ev-ddb5be78a5cf6218d616", 0, 408], ["ev-12702b75d45dae1d10d9", 0, 147], ["ev-13ffbc51b4c0029a5ac5", 0, 2072], ["ev-29c91f35a0bd221491d8", 0, 145], ["ev-2d373a31d658fc958e65", 0, 1369], ["ev-744c4e83ef7d8bd7fde4", 0, 534], ["ev-cc6ef52a9cfaeb6f41f1", 0, 521]], "estimated_body_chars": 22669, "course_content_chars": 22411, "budget_parts": {"fixed": 12765, "minimum_frame": 15297, "payload_text": 6940}, "reason": "reserve required evidence before expanding recent feedback"}
