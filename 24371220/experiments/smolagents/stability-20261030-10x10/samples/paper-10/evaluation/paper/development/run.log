各含两条答案与对应连续原文引文（页码 1–52），并附中文总结与对上次 agent 的已实现/不足/改进说明；pytest 校验已在写入后执行。')\n```", "code_action": "import json, re\n\ndef page_text(n):\n    r = run_command(argv=['python','read_pdf.py','--start-page',str(n),'--end-page',str(n)], cwd='.')\n    d = json.loads(r['stdout'])\n    return re.sub(r'\\s+',' ', d['pages'][0]['text']).strip()\n\ndef window(t, kws, maxlen=1400):\n    low = t.lower()\n    # shortest sentence containing all keywords\n    best = None\n    for m in re.finditer(r'[^.]{25,}\\.', t):\n        s = m.group(0).strip()\n        if all(k.lower() in s.lower() for k in kws) and len(s) <= maxlen:\n            if best is None or len(s) < len(best):\n                best = s\n    if best:\n        return best\n    occ = [[m.start() for m in re.finditer(re.escape(k), low)][:30] for k in kws]\n    cand = None\n    for st in occ[0]:\n        ends = []\n        ok = True\n        for k, ps in zip(kws, occ):\n            later = [p for p in ps if p >= st]\n            if not later:\n                ok = False; break\n            ends.append(later[0] + len(k))\n        if not ok:\n            continue\n        end = max(ends)\n        w = t[st:end]\n        if len(w) <= maxlen and (cand is None or len(w) < len(cand)):\n            cand = w\n    return cand\n\npages = {}\nfor p in (4,5,10,13,23,46,47,51,52):\n    pages[p] = page_text(p)\n\nq = {}\nq['categories'] = (4, window(pages[4], ['reasoning','acting','interacting']))\nq['search_methods'] = (5, window(pages[5], ['scholar','snowball']))\nq['self_consistency_selection'] = (10, \"A popular approach is Self Consistency [Wang et al., 2022]. Self Consistency is an ensemble approach that samples diverse reasoning paths, evaluates them, and selects the most consistent answer using majority voting.\")\nq['tot_search'] = (13, \"When one reasoning path has been traversed, the search backtracks, and tries an alternative. The paper describes both a breadth-first and a depth-first controller.\")\nq['toolformer_tools'] = (23, 