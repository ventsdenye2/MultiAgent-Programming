+    def positive_int_or_none(*, minimum: int) -> EnvVar[int | None]:
+        """未设置时为 None；设置时必须解析为 >= minimum 的整数。"""
+
+        def _init(v: str | None) -> int | None:
+            if v is None:
+                return None
+            value = int(v)
+            if value < minimum:
+                raise ValueError(f"{v!r} must be >= {minimum}")
+            return value
+
+        return EnvVar(_init)
+
