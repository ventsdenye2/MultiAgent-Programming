{"event": "context_selection", "time": 1793332534.8834827, "run_id": "bee3783012bc4d39a00bdd7162bacb4d", "seq": 151, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-c8859274b7c70879ff16", "ev-ddb5be78a5cf6218d616", "ev-30754515034e43628968", "ev-51e2fa3b9fc1aebe86f3", "ev-31c2c3b226a01680571f", "ev-eae82c05a3a3c473d07d", "ev-69c43e919e02dd388802"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-c8859274b7c70879ff16", 0, 139], ["ev-ddb5be78a5cf6218d616", 0, 408], ["ev-30754515034e43628968", 0, 1369], ["ev-51e2fa3b9fc1aebe86f3", 0, 521], ["ev-31c2c3b226a01680571f", 0, 768], ["ev-eae82c05a3a3c473d07d", 0, 934], ["ev-69c43e919e02dd388802", 0, 2140]], "estimated_body_chars": 24714, "course_content_chars": 24456, "budget_parts": {"fixed": 12651, "minimum_frame": 15257, "payload_text": 7730}, "reason": "reserve required evidence before expanding recent feedback"}
