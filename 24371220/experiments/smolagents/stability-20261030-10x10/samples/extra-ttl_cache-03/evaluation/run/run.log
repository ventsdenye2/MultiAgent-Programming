card(key)\n\n        if (\n            ttl > 0\n            and self._generation == generation\n            and self._key_versions.get(key, 0) == key_version\n        ):\n            expires_at = self.clock() + ttl\n            self._values[key] = (value, expires_at)\n\n        return value\n\n    def invalidate(self, key):\n        self._values.pop(key, None)\n        self._key_versions[key] = self._key_versions.get(key, 0) + 1\n        return None\n\n    def clear(self):\n        self._values.clear()\n        self._generation += 1\n        return None\n"}]}], "model": "deepseek-flash", "max_tokens": 16384, "reasoning_effort": "high", "stop": ["Observation:", "Calling tools:"], "thinking": {"type": "enabled"}}, "chars": 20561, "content_chars": 19521, "course_content_chars": 20356}
