\n        generation = self._generation\n\n        self._running.add(key)\n        try:\n            value = loader()\n        finally:\n            self._running.discard(key)\n\n        if (\n            ttl > 0\n            and self._generation == generation\n            and self._key_versions.get(key, 0) == key_version\n        ):\n            expires_at = self.clock() + ttl\n            self._values[key] = (value, expires_at)\n\n        return value\n\n    def invalidate(self, key):\n        self._values.pop(key, None)\n        self._key_versions[key] = self._key_versions.get(key, 0) + 1\n        return None\n\n    def clear(self):\n        self._values.clear()\n        self._generation += 1\n        return None\n"}], "tool_calls": null, "raw": null, "token_usage": null}, {"role": "user", "content": [{"type": "text", "text": "Evidence ev-de27e451c119d9f4bff2 | test_cache.py | lines:1-31 | sha256=fe517707cbea5b83659adeb89b8daa44467dec7de0cdaf9925db6f0a7fe3576d\nimport pytest\nfrom cache import TTLCache\n\n\ndef test_expiration_at_exact_deadline_and_invalidate():\n    now = [0]\n    cache = TTLCache(lambda: now[0])\n    assert cache.get('x', lambda: 1, 5) == 1\n    now[0] = 4\n    assert cache.get('x', lambda: 2, 100) == 1\n    now[0] = 5\n    assert cache.get('x', lambda: 3, 5) == 3\n    cache.invalidate('x')\n    assert cache.get('x', lambda: 4, 5) == 4\n\n\ndef test_zero_ttl_and_invalid_ttl():\n    cache = TTLCache(lambda: 0)\n    assert cache.get('x', lambda: 1, 0) == 1\n    assert cache.get('x', lambda: 2, 0) == 2\n    with pytest.raises(ValueError):\n        cache.get('x', lambda: 3, -1)\n\n\ndef test_invalidate_during_load():\n    cache = TTLCache(lambda: 0)\n    def load():\n        cache.invalidate('x')\n        return 1\n    assert cache.get('x', load, 10) == 1\n    assert cache.get('x', lambda: 2, 10) == 2\n"}], "tool_calls": null, "raw": null, "token_usage": null}], "tool_calls": [], "error": {"type": "AgentParsingError", "message": "Error in code pars