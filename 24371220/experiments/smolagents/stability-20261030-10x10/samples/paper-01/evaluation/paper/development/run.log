{"event": "context_exposure", "time": 1793330145.0108728, "run_id": "f85c7dc701374322998c007ac382680f", "seq": 309, "request": 24, "evidence_ids": ["ev-2bcb169328f17ac85c9d", "ev-94c9aed99ffbcdf31b43", "ev-a67fb4f311d1f21c4aba", "ev-baddfbae8db75139dd16", "ev-bc885ff165a165a4d614"], "note_ids": ["multi_agent", "overview", "tool_use"], "delivered_ranges": [{"id": "ev-2bcb169328f17ac85c9d", "start": 0, "end": 1952, "length": 1952}, {"id": "ev-a67fb4f311d1f21c4aba", "start": 0, "end": 2382, "length": 2382}, {"id": "ev-baddfbae8db75139dd16", "start": 0, "end": 380, "length": 380}, {"id": "ev-94c9aed99ffbcdf31b43", "start": 0, "end": 3742, "length": 3742}, {"id": "ev-bc885ff165a165a4d614", "start": 0, "end": 2323, "length": 2323}], "fully_exposed_ids": ["ev-03c9580cc4ea3469a3d3", "ev-0aaa960f62d9cf1689f1", "ev-0fae89961d303fffa5a6", "ev-1d8af21fdc46c86a5055", "ev-1e23be7c32e2bf283689", "ev-26c94297c50e4ef408a2", "ev-2bcb169328f17ac85c9d", "ev-2c5302116a7f6c84effa", "ev-2c646589154451e7b722", "ev-2f8846ab5b1bc7072a1b", "ev-345e6706309ac04ee927", "ev-4049593a30e2846f8394", "ev-41048209f3096e51f36b", "ev-419793694ae75f1e2b97", "ev-4e747765f5046c8ad8b1", "ev-562f05b08e87ac882b23", "ev-5803bf1c9a0002a5bd4f", "ev-5ee42fcee0f3b22d5203", "ev-6297cb688893b79c33c4", "ev-731fa63b8d34dde45e62", "ev-76027d4e758f97793930", "ev-7f4d5e2fe0886c80c09b", "ev-81117fe71aa5d10b548d", "ev-84af1a450301aa5252ba", "ev-89534f70bedf0ab45dc5", "ev-9317b06df60c30a6c12c", "ev-94c9aed99ffbcdf31b43", "ev-97c7764bd93b97111551", "ev-98a30db9253fff6cc9da", "ev-a30e6edea79391cf315d", "ev-a67fb4f311d1f21c4aba", "ev-a9b70da77a1c104405a2", "ev-b8db09947ef7c899cd9d", "ev-baddfbae8db75139dd16", "ev-bc885ff165a165a4d614", "ev-c3c928f38ebc0ac0c6cd", "ev-ced75d6936911b2f0248", "ev-d2b420a2b23cdc8166d3", "ev-daeb56e673fc61cae0ef", "ev-dbca06e364385e22f3c5", "ev-e1f0788ba35ab420a8a4", "ev-e403dfb2811682ecd186", "ev-e5b9499e130a976eefe2", "ev-eb42e63472799e638c3f", "ev-f5fa865a87a2cd077881", "ev-f5fab558c5f762a67dcc"]