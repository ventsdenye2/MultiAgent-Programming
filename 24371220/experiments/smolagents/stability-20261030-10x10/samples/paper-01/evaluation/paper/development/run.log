{"event": "tool_result", "time": 1793330157.4621084, "run_id": "f85c7dc701374322998c007ac382680f", "seq": 321, "action": {"tool": "recall", "evidence_ids": ["ev-75546d247dedb90561b5", "ev-f03e4b7f1b7fc6e66886", "ev-aa9b9dbdfec8c640b495", "ev-6e64db9ec6bfa8f9417f", "ev-42cada09d7411017eb46", "ev-99f0f0a37d328bfed1a9", "ev-01ce8948bcc88d235ea3"]}, "result": {"requested": [{"id": "ev-75546d247dedb90561b5", "source": "paper.pdf", "locator": "page:46"}, {"id": "ev-f03e4b7f1b7fc6e66886", "source": "paper.pdf", "locator": "page:47"}, {"id": "ev-aa9b9dbdfec8c640b495", "source": "paper.pdf", "locator": "page:48"}, {"id": "ev-6e64db9ec6bfa8f9417f", "source": "paper.pdf", "locator": "page:49"}, {"id": "ev-42cada09d7411017eb46", "source": "paper.pdf", "locator": "page:50"}, {"id": "ev-99f0f0a37d328bfed1a9", "source": "paper.pdf", "locator": "page:51"}, {"id": "ev-01ce8948bcc88d235ea3", "source": "paper.pdf", "locator": "page:52"}], "queued": [{"id": "ev-75546d247dedb90561b5", "source": "paper.pdf", "locator": "page:46"}, {"id": "ev-f03e4b7f1b7fc6e66886", "source": "paper.pdf", "locator": "page:47"}, {"id": "ev-aa9b9dbdfec8c640b495", "source": "paper.pdf", "locator": "page:48"}, {"id": "ev-6e64db9ec6bfa8f9417f", "source": "paper.pdf", "locator": "page:49"}, {"id": "ev-42cada09d7411017eb46", "source": "paper.pdf", "locator": "page:50"}, {"id": "ev-99f0f0a37d328bfed1a9", "source": "paper.pdf", "locator": "page:51"}, {"id": "ev-01ce8948bcc88d235ea3", "source": "paper.pdf", "locator": "page:52"}], "requested_count": 7, "queued_count": 7, "message": "Queued, not delivered; the selector chooses the actual next batch."}}
