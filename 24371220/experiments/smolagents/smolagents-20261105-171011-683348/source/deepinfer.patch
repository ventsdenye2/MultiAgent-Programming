+def _truncate_message(message: str, max_message_chars: int) -> str:
+    """超出预算时用固定标记省略中间内容，开头保留向上取整的一半。"""
+    if len(message) <= max_message_chars:
+        return message
+    remaining = max_message_chars - len(_OMISSION_MARKER)
+    if remaining <= 0:
+        return _OMISSION_MARKER
+    head = (remaining + 1) // 2
+    tail = remaining - head
+    if tail <= 0:
+        return message[:head] + _OMISSION_MARKER
+    return message[:head] + _OMISSION_MARKER + message[-tail:]
+
 
