DEEPINFER_DECODE_PERF_CACHE_TTL_SEC = EnvVar.int(default=60 * 60)\n176:     DEEPINFER_NUM_STATE_SLOTS_RATIO = EnvVar.float(default=1.2)\n177:     DEEPINFER_PREFILL_STORE_EXTRA_STATE = EnvVar.bool()\n178:     DEEPINFER_PREFILL_STORE_EXTRA_SIZE = EnvVar.int(default=128)\n181:     DEEPINFER_XGRAMMAR_DEBUG = EnvVar.bool()\n182:     DEEPINFER_XGRAMMAR_TIMEOUT = EnvVar.int(default=20)\n183:     DEEPINFER_XGRAMMAR_DISABLE_CACHE = EnvVar.bool(default=False)\n184:     DEEPINFER_XGRAMMAR_CACHE_LIMIT_BYTES = EnvVar.int(default=10 * 1024 * 1024 * 1024)\n185:     DEEPINFER_SO_BUILDER_CPUS = EnvVar.int(default=4)\n188:     DEEPINFER_PREFILL_ATTEMPT_INTERVAL = EnvVar.int(default=70)\n191:     DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL = EnvVar.int(default=100)\n193:     DEEPINFER_ZERO_OVERHEAD_SCHEDULING = EnvVar.bool()\n196:     DEEPINFER_LOG_MAX_MESSAGE_CHARS = EnvVar.int_or_none_min(minimum=32)\n199:     DEEPINFER_LOGGING_INTERVAL_STEP = EnvVar.int(default=100)\n200:     DEEPINFER_NCCL_MEMORY_SAMPLE_INTERVAL_STEPS = EnvVar.int(default=1000)\n201:     DEEPINFER_RINGBUFFER_WARNING_INTERVAL = EnvVar.int(default=60)\n202:     DEEPINFER_GC_INTERVAL_STEP = EnvVar.int(default=1000)\n205:     DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE = EnvVar.choice(default=\"off\", choices=(\"off\", \"mask\", \"compact\"))\n208:     DEEPINFER_YOCO_PREFILL_KEEP_TOKENS = EnvVar.int()\n211:     window_size + DEEPINFER_MAX_BACKTRACKING_TOKENS；默认 0，启用截断时必须显式设置。\"\"\"\n214:     DEEPINFER_BATCH_INVARIANT = EnvVar.bool()\n215:     DEEPINFER_DISABLE_SYNC_GUARD = EnvVar.bool()\n217:     DEEPINFER_PROFILE_TORCH_CUDA_MEMORY = EnvVar.str_or_none()\n218:     DEEPINFER_ENABLE_MEMORY_TRACING = EnvVar.bool()\n219:     DEEPINFER_PROFILE_HTTP_ENABLE = EnvVar.bool()\n220:     DEEPINFER_PROFILE_HTTP_PORT_BASE = EnvVar.int(default=6070)\n221:     DEEPINFER_TORCH_PROFILER_DIR = EnvVar.str(default=\"/tmp\")\n224:     DEEPINFER_USE_MULTIMODAL_POOL = EnvVar.bool()\n225:     DEEPINFER_MULTIMODAL_POOL_SIZE_GB = EnvVar.int(default=8)\n2