{"event": "context_selection", "time": 1793869948.017478, "run_id": "fe5ec5bdcad948258ba473bcb2bdb972", "seq": 205, "evidence_ids": ["ev-c8859274b7c70879ff16", "ev-43be0112656152b26c3d", "ev-6df9f76145d4914e4a94", "ev-eb326cbaf5d889404327", "ev-51e2fa3b9fc1aebe86f3", "ev-1bcdf6b6cb14f5ceef51", "ev-506088eaddc1f7de78ed", "ev-4a893d2b11e241607764", "ev-b1e4a3d7169f8b6e5232", "ev-bae57eeee18761001e03"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-c8859274b7c70879ff16", 0, 139], ["ev-43be0112656152b26c3d", 0, 147], ["ev-6df9f76145d4914e4a94", 0, 2492], ["ev-eb326cbaf5d889404327", 0, 145], ["ev-51e2fa3b9fc1aebe86f3", 0, 521], ["ev-1bcdf6b6cb14f5ceef51", 0, 2045], ["ev-506088eaddc1f7de78ed", 0, 948], ["ev-4a893d2b11e241607764", 0, 1156], ["ev-b1e4a3d7169f8b6e5232", 0, 1277], ["ev-bae57eeee18761001e03", 0, 891]], "estimated_body_chars": 27307, "course_content_chars": 27049, "budget_parts": {"fixed": 12579, "minimum_frame": 15393, "payload_text": 11283}, "reason": "reserve required evidence before expanding recent feedback"}
