{"event": "context_selection", "time": 1793869980.5878732, "run_id": "fe5ec5bdcad948258ba473bcb2bdb972", "seq": 290, "evidence_ids": ["ev-43be0112656152b26c3d", "ev-6df9f76145d4914e4a94", "ev-eb326cbaf5d889404327", "ev-5d84f82030968f85dd9c"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-43be0112656152b26c3d", 0, 147], ["ev-6df9f76145d4914e4a94", 0, 2492], ["ev-eb326cbaf5d889404327", 0, 145], ["ev-5d84f82030968f85dd9c", 0, 694]], "estimated_body_chars": 21977, "course_content_chars": 21772, "budget_parts": {"fixed": 12579, "minimum_frame": 15723, "payload_text": 4074}, "reason": "reserve required evidence before expanding recent feedback"}
