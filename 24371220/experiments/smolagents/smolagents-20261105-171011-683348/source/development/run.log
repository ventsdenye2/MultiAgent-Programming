{"event": "context_selection", "time": 1793869911.815184, "run_id": "fe5ec5bdcad948258ba473bcb2bdb972", "seq": 104, "evidence_ids": ["ev-5a3c8c1ca1246b61b813", "ev-5abfdabfb975754c6683", "ev-c8859274b7c70879ff16", "ev-30754515034e43628968", "ev-51e2fa3b9fc1aebe86f3", "ev-590fea613449374a08cb", "ev-4a893d2b11e241607764", "ev-b1e4a3d7169f8b6e5232", "ev-bae57eeee18761001e03"], "note_ids": [], "deferred": [], "delivered_parts": [["ev-5a3c8c1ca1246b61b813", 0, 40], ["ev-5abfdabfb975754c6683", 0, 30], ["ev-c8859274b7c70879ff16", 0, 139], ["ev-30754515034e43628968", 0, 1369], ["ev-51e2fa3b9fc1aebe86f3", 0, 521], ["ev-590fea613449374a08cb", 0, 694], ["ev-4a893d2b11e241607764", 0, 1156], ["ev-b1e4a3d7169f8b6e5232", 0, 1277], ["ev-bae57eeee18761001e03", 0, 891]], "estimated_body_chars": 24745, "course_content_chars": 24487, "budget_parts": {"fixed": 12579, "minimum_frame": 15733, "payload_text": 7498}, "reason": "reserve required evidence before expanding recent feedback"}
