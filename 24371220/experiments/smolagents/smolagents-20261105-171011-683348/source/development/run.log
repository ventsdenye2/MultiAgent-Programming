uper().format(record)\n", "new_text": "    def format(self, record: logging.LogRecord) -> str:\n        if self.max_message_chars is not None and getattr(record, \"keep_full_message\", None) is not True:\n            message = record.getMessage()\n            if len(message) > self.max_message_chars:\n                # 复制记录，避免改写共享 LogRecord 的 msg/args/exc_info/stack_info\n                record = copy.copy(record)\n                record.msg = _truncate_message(message, self.max_message_chars)\n                record.args = ()\n        msg = super().format(record)\n"}, {"old_text": "    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n    )", "new_text": "    fmt = NewLineFormatter(\n        _FORMAT,\n        datefmt=_DATE_FORMAT,\n        use_color=sys.stdout.isatty(),\n        max_message_chars=envs.DEEPINFER_LOG_MAX_MESSAGE_CHARS,\n    )"}], "expected_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8"}, "result": {"ok": true, "path": "deepinfer/logger.py", "file_hash": "8bb382fd902b61a5794a3ab8fae64340dee9876a0c0c9c907b6d1fcaa52e3e5f", "before_hash": "5b8f8d9947de692353609c1fc2851097d24f9b6ba6004dce1dbfa394dc6d3ec8", "changed": true}}
