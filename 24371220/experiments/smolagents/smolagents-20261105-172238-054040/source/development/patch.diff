+def _validate_max_message_chars(max_message_chars: int | None) -> int | None:
+    """None 表示不限长；其余须为 >= 32 的整数（bool 不算整数）。"""
+    if max_message_chars is None:
+        return None
+    if isinstance(max_message_chars, bool) or not isinstance(max_message_chars, int):
+        raise ValueError(
+            f"max_message_chars must be None or an int >= {_MIN_MAX_MESSAGE_CHARS}, "
+            f"got {max_message_chars!r}"
+        )
+    if max_message_chars < _MIN_MAX_MESSAGE_CHARS:
+        raise ValueError(
+            f"max_message_chars must be None or an int >= {_MIN_MAX_MESSAGE_CHARS}, "
+            f"got {max_message_chars}"
+        )
+    return max_message_chars
+
+
+def _truncate_message(message: str, max_message_chars: int) -> str:
+    """超预算时用固定标记替换中间内容，开头取 ceil 一半，末尾取其余。"""
+    if len(message) <= max_message_chars:
+        return message
+    remaining = max_message_chars - len(_OMITTED_MARKER)
+    head = (remaining + 1) // 2
+    tail = remaining - head
+    ending = message[len(message) - tail :] if tail > 0 else ""
+    return f"{message[:head]}{_OMITTED_MARKER}{ending}"
+
