ESSAGE_CHARS}, \"\\n'\n            '            f\"got {max_message_chars}\"\\n'\n            \"        )\\n\"\n            \"    return max_message_chars\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"def _truncate_message(message: str, max_message_chars: int) -> str:\\n\"\n            '    \"\"\"超预算时用固定标记替换中间内容，开头取 ceil 一半，末尾取其余。\"\"\"\\n'\n            \"    if len(message) <= max_message_chars:\\n\"\n            \"        return message\\n\"\n            \"    remaining = max_message_chars - len(_OMITTED_MARKER)\\n\"\n            \"    head = (remaining + 1) // 2\\n\"\n            \"    tail = remaining - head\\n\"\n            '    ending = message[len(message) - tail :] if tail > 0 else \"\"\\n'\n            \"    return f\\\"{message[:head]}{_OMITTED_MARKER}{ending}\\\"\\n\"\n            \"\\n\"\n            \"\\n\"\n            'class NewLineFormatter(logging.Formatter):\\n    \"\"\"Adds logging prefix to newlines'\n        ),\n    },\n    {\n        \"old_text\": (\n            \"        high_precision: bool = False,\\n\"\n            \"        use_color: bool = False,\\n\"\n            \"    ) -> None:\\n\"\n            \"        super().__init__(fmt, datefmt)\\n\"\n            \"        self.high_precision = high_precision\\n\"\n            \"        self.use_color = use_color\\n\"\n        ),\n        \"new_text\": (\n            \"        high_precision: bool = False,\\n\"\n            \"        use_color: bool = False,\\n\"\n            \"        *,\\n\"\n            \"        max_message_chars: int | None = None,\\n\"\n            \"    ) -> None:\\n\"\n            \"        super().__init__(fmt, datefmt)\\n\"\n            \"        self.high_precision = high_precision\\n\"\n            \"        self.use_color = use_color\\n\"\n            \"        self.max_message_chars = _validate_max_message_chars(max_message_chars)\\n\"\n        ),\n    },\n    {\n        \"old_text\": \"    def format(self, record: logging.LogRecord) -> str:\\n   